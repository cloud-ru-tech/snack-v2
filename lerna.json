{
  "$schema": "https://json.schemastore.org/lerna.json",
  "npmClient": "pnpm",
  "packages": ["packages/*"],
  "version": "independent",
  "useWorkspaces": true,
  "command": {
    "publish": {
      "ignoreChanges": ["ignored-file", "*.md"],
      "message": "[ci skip] Version bump",
      "conventionalCommits": true
    },
    "version": {
      "allowBranch": "main",
      "conventionalCommits": true,
      "ignoreChanges": [
        "**/*.md",
        "**/*.MDX",
        "./scripts/**/*",
        "packages/*/stories/**/*.*",
        "packages/*/__tests__/**/*.*",
        "packages/*/docs/**/*.*"
      ]
    }
  }
}




















