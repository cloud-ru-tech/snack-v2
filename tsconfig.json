{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["packages", "apps", "scripts", "storybook", "types"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "scripts/**/*.js",
    "scripts/**/*.d.ts",
    "astro/**",
    "storybook/**/*.js",
    "storybook/**/*.d.ts",
    "packages/*/docs/**/*.mdx",
    "packages/*/__tests__/**",
    "packages/*/__test__/**"
  ]
}




















