{
  "name": "design-system",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "deps": "pnpm i",
    "postinstall": "ts-patch install",
    "add-package": "tsx scripts/add-package.mts",
    "gen:props": "tsx scripts/gen-props.mts",
    "gen:readme": "tsx scripts/gen-readme.mts",
    "gen": "pnpm gen:props && pnpm gen:readme",
    "build:all": "pnpm run build:packages && pnpm run gen && pnpm run build:storybook && pnpm run build:docs",
    "build:packages": "pnpm run clean:dist && pnpm run build:ts && pnpm run copy:icons-sprite-svg && pnpm run build:cjs-package-meta && pnpm run build:css && pnpm run build:cjs-css-modules",
    "copy:icons-sprite-svg": "pnpm --filter @ds/icons run copy:sprite-svg",
    "build:cjs-package-meta": "tsx scripts/writeDistCjsPackageJson.ts",
    "build:ts": "pnpm run build:packages:esm && pnpm run build:packages:cjs",
    "build:packages:esm": "tspc -b ./packages/tsconfig.esm.json",
    "build:packages:cjs": "tspc -b ./packages/tsconfig.cjs.json",
    "build:css": "tsx scripts/compileCSS.ts",
    "build:cjs-css-modules": "tsx scripts/compileJsCssModules.ts",
    "build:storybook": "pnpm --filter @ds/storybook build && rm -rf storybook-static && cp -R apps/storybook/storybook-static storybook-static",
    "build:docs": "pnpm --filter @ds/docs build && mkdir -p astro && rm -rf astro/dist && mv apps/docs/dist astro/dist",
    "dev": "pnpm --parallel --stream --filter @ds/docs --filter @ds/storybook dev",
    "dev:docs": "pnpm --filter @ds/docs dev",
    "dev:storybook": "pnpm --filter @ds/storybook dev",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" \"apps/storybook/**/*.{ts,tsx}\" \"apps/docs/src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" ",
    "stylelint": "stylelint \"**/*.css\" \"**/*.scss\" --fix",
    "typecheck": "tsc -b tsconfig.json",
    "clean:dist": "rimraf --glob ./packages/*/dist",
    "clean:buildinfo": "rimraf --glob ./packages/*/*.tsbuildinfo ./packages/*/*/*.tsbuildinfo",
    "clean": "pnpm run clean:dist && pnpm run clean:buildinfo && pnpm -r --filter './apps/*' --filter './packages/*' run clean",
    "test:stories": "pnpm --filter @ds/storybook test",
    "test:stories:ci": "pnpm --filter @ds/storybook test:ci",
    "test:e2e": "playwright test",
    "test:e2e:chrome": "playwright test --project=chrome",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test --project=chrome --update-snapshots",
    "test:e2e:docs": "pnpm --filter @ds/tests test",
    "test": "pnpm test:stories && pnpm test:e2e",
    "test:unit": "vitest run",
    "version:packages": "lerna version",
    "release": "pnpm run build:packages && lerna publish from-package"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "4.1.4",
    "@babel/core": "^7.26.0",
    "@inquirer/prompts": "^7.0.0",
    "@playwright/test": "^1.52.0",
    "@types/dom-close-watcher": "1.0.0",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "babel-plugin-react-css-modules": "^5.2.6",
    "glob": "^11.0.2",
    "lerna": "^8.2.2",
    "minimist": "^1.2.8",
    "postcss": "^8.5.0",
    "postcss-discard-comments": "^7.0.0",
    "prettier": "^3.5.3",
    "react": "^18.3.1",
    "react-docgen-typescript": "^2.2.2",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "sass": "^1.86.3",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "4.1.4",
    "typescript-plugin-css-modules": "^5.2.0",
    "@cloud-ru/figma-variables": "npm:@sbercloud/figma-variables@2.1.2",
    "@cloud-ru/eslint-config": "3.1.1",
    "@cloud-ru/eslint-plugin-ssr-safe-react": "0.6.1",
    "@cloud-ru/ft-config-husky": "1.2.2",
    "@cloud-ru/ft-config-lint-staged": "1.1.4",
    "@cloud-ru/ft-config-prettier": "1.1.3",
    "postcss-scss": "4.0.9",
    "stylelint": "16.26.1",
    "stylelint-config-clean-order": "8.0.0",
    "stylelint-config-recommended-scss": "16.0.2",
    "stylelint-config-standard": "39.0.1",
    "@svgr/cli": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@types/svg-sprite": "0.0.39",
    "fast-xml-parser": "5.3.5",
    "oslllo-svg-fixer": "6.0.1",
    "svg-sprite": "2.0.4",
    "svgo": "4.0.0",
    "qs": "6.15.1",
    "@snack-uikit/locale": "0.15.5"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/utils": "~8.54.0"
    }
  }
}
