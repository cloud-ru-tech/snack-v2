{
  "name": "design-system-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for React design system packages with Storybook and Astro docs",
  "keywords": [
    "design-system",
    "react",
    "storybook",
    "astro",
    "lerna",
    "pnpm"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.23.0",
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@sbercloud/figma-variables": "0.0.1-beta.23",
    "@snack-uikit/button": "0.19.16",
    "@snack-uikit/counter": "0.8.10",
    "@snack-uikit/status": "0.10.7",
    "@storybook/addon-a11y": "^10.1.4",
    "@storybook/addon-designs": "11.1.1",
    "@storybook/addon-docs": "^10.1.4",
    "@storybook/addon-links": "10.1.11",
    "@storybook/addon-onboarding": "^10.1.4",
    "@storybook/addon-vitest": "^10.1.4",
    "@storybook/react-vite": "^10.1.4",
    "@storybook/test": "8.6.15",
    "@types/inquirer": "9.0.9",
    "@types/node": "24.10.1",
    "@cloud-ru/eslint-config": "3.1.1",
    "@cloud-ru/ft-config-lint-staged": "1.1.4",
    "@cloud-ru/eslint-plugin-ssr-safe-react": "0.6.1",
    "@cloud-ru/ft-config-stylelint": "3.0.0",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "classnames": "^2.5.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-storybook": "^10.1.4",
    "inquirer": "13.2.0",
    "lerna": "9.0.3",
    "playwright": "^1.57.0",
    "prettier": "3.7.4",
    "sass-embedded": "^1.96.0",
    "storybook": "^10.1.4",
    "ts-node": "10.9.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.15",
    "@sbercloud/ft-logger": "0.0.1-preview-7fab8818.0"
  },
  "dependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "scripts": {
    "deps": "pnpm install",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" \"stories/**/*.{ts,tsx}\" \"storybook/**/*.{ts,tsx}\"",
    "build:packages": "pnpm compile:packages && pnpm build:ts",
    "compile:packages": "lerna run compile --stream",
    "build:ts": "pnpm build:packages:esm && pnpm build:packages:cjs",
    "build:packages:esm": "pnpm -r --filter \"./packages/*\" run build:esm",
    "build:packages:cjs": "pnpm -r --filter \"./packages/*\" run build:cjs",
    "build:packages:all": "pnpm -r --filter \"./packages/*\" run build",
    "clean:packages": "pnpm -r --filter \"./packages/*\" run clean",
    "build:docs": "pnpm --filter @design-system/docs build",
    "build:docs:root": "pnpm --filter @design-system/docs build:root",
    "build": "pnpm run build:packages && pnpm run build:docs",
    "dev": "pnpm --filter @design-system/docs dev -- --port 4321",
    "dev:docs": "pnpm dev",
    "docs": "pnpm dev",
    "docs:dev": "pnpm dev",
    "docs:build": "pnpm --filter @design-system/docs build",
    "docs:preview": "pnpm --filter @design-system/docs preview",
    "storybook": "storybook dev -c storybook -p 6006",
    "storybook:all": "storybook dev -c storybook -p 6006",
    "sb": "pnpm storybook",
    "build-storybook": "storybook build -c storybook",
    "build:storybook": "storybook build -c storybook",
    "build:all": "pnpm run build:packages && pnpm run build:docs && pnpm run build:storybook",
    "test": "pnpm -r test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "add-package": "ts-node --project scripts/tsconfig.json scripts/npm-init.ts"
  }
}
