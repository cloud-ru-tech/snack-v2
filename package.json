{
  "name": "design-system-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for React design system packages with Storybook and Astro docs",
  "keywords": [
    "design-system",
    "react",
    "storybook",
    "astro",
    "lerna",
    "pnpm"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.23.0",
  "devDependencies": {
    "@babel/core": "7.28.4",
    "@chromatic-com/storybook": "^4.1.3",
    "@cloud-ru/eslint-config": "3.1.1",
    "@cloud-ru/eslint-plugin-ssr-safe-react": "0.6.1",
    "@cloud-ru/ft-config-husky": "1.2.2",
    "@cloud-ru/ft-config-lint-staged": "1.1.4",
    "@cloud-ru/ft-config-prettier": "1.1.3",
    "@cloud-ru/ft-config-stylelint": "3.0.0",
    "@cloud-ru/ft-storybook-readme-addon": "2.0.5",
    "@playwright/test": "1.58.0",
    "@sbercloud/figma-variables": "0.0.1-beta.23",
    "@sbercloud/ft-logger": "0.0.1-preview-7fab8818.0",
    "@storybook/addon-a11y": "^10.1.4",
    "@storybook/addon-designs": "11.1.1",
    "@storybook/addon-docs": "^10.1.4",
    "@storybook/addon-links": "10.1.11",
    "@storybook/addon-onboarding": "^10.1.4",
    "@storybook/addon-vitest": "^10.1.4",
    "@storybook/react-vite": "^10.1.4",
    "@storybook/test": "8.6.15",
    "@types/inquirer": "9.0.9",
    "@types/node": "24.10.1",
    "@types/qs": "6.14.0",
    "@types/shelljs": "0.8.15",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "autoprefixer": "10.4.20",
    "babel-plugin-react-css-modules": "5.2.6",
    "chokidar": "5.0.0",
    "classnames": "^2.5.1",
    "colors": "1.4.0",
    "dotenv": "17.2.3",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-storybook": "^10.1.4",
    "glob": "11.0.0",
    "inquirer": "13.2.0",
    "lerna": "9.0.3",
    "minimist": "1.2.8",
    "playwright": "1.58.0",
    "postcss": "8.5.6",
    "postcss-discard-comments": "7.0.4",
    "prettier": "3.7.4",
    "qs": "6.14.1",
    "react-docgen": "7.1.0",
    "react-docgen-typescript": "2.2.2",
    "rimraf": "6.0.1",
    "sass": "1.80.4",
    "sass-embedded": "^1.96.0",
    "shelljs": "0.8.5",
    "storybook": "^10.1.4",
    "stylelint-config-clean-order": "8.0.0",
    "ts-node": "10.9.2",
    "ts-patch": "3.3.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-plugin-css-modules": "5.2.0",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "scripts": {
    "deps": "pnpm install",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" \"stories/**/*.{ts,tsx}\" \"storybook/**/*.{ts,tsx}\"",
    "build:packages": "pnpm compile:packages && pnpm build:ts && pnpm build:css",
    "compile:packages": "lerna run compile --stream || true",
    "build:ts": "pnpm build:packages:esm && pnpm build:packages:cjs",
    "build:packages:esm": "tspc -b ./packages/tsconfig.esm.json",
    "build:packages:cjs": "tspc -b ./packages/tsconfig.cjs.json",
    "build:css": "ts-node scripts/compileCSS && ts-node scripts/compileJsCssModules",
    "build:packages:all": "pnpm -r --filter \"@design-system/*\" run build",
    "clean:packages": "pnpm -r --filter \"@design-system/*\" run clean",
    "clean:dist": "rimraf --glob ./packages/*/dist",
    "clean:buildinfo": "rimraf --glob ./packages/**/*.tsbuildinfo",
    "build:docs": "pnpm --filter @design-system/docs build",
    "build:docs:root": "pnpm --filter @design-system/docs build:root",
    "build": "pnpm run build:packages && pnpm run build:docs",
    "dev": "pnpm --filter @design-system/docs dev -- --port 4321",
    "dev:docs": "pnpm dev",
    "docs": "pnpm dev",
    "docs:dev": "pnpm dev",
    "docs:build": "pnpm --filter @design-system/docs build",
    "docs:preview": "pnpm --filter @design-system/docs preview",
    "storybook": "storybook dev -c storybook -p 6006",
    "storybook:all": "storybook dev -c storybook -p 6006",
    "sb": "pnpm storybook",
    "build-storybook": "storybook build -c storybook",
    "build:storybook": "storybook build -c storybook",
    "build:all": "pnpm run build:packages && pnpm run build:docs && pnpm run build:storybook",
    "test": "pnpm -r test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chrome": "playwright test --project=chrome",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report playwright/test-results/reports",
    "add-package": "ts-node --project scripts/tsconfig.json scripts/npm-init.ts",
    "postinstall": "ts-patch install",
    "docgen": "ts-node --project scripts/tsconfig.json scripts/docgen/docgenForAllPackages.ts",
    "docgen:readme": "ts-node --project scripts/tsconfig.json scripts/docgen/generateReadmeForAllPackages.ts",
    "docgen:all": "ts-node --project scripts/tsconfig.json scripts/docgen/generateAllDocs.ts",
    "docgen:staged": "ts-node --project scripts/tsconfig.json scripts/docgen/docgenForStagedPackages.ts"
  }
}
