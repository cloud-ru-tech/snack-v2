{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./react-lib.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "plugins": [
      {
        "transform": "../../scripts/scss-extension-transformer.ts"
      },
      {
        "name": "typescript-plugin-css-modules",
        "options": {
          "customRenderer": "../../scripts/compile/sass-custom-renderer.js"
        }
      }
    ]
  }
}
