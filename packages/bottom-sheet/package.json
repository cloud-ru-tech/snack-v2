{
  "name": "@ds/bottom-sheet",
  "version": "1.1.0",
  "description": "Mobile-first overlay-контейнер с drag-handle и swipe-down для диалогов, выпадающих списков и фильтров. Поддерживает snap-points (раскрытие на половину → full).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/bottom-sheet"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/bottom-sheet",
  "license": "Apache-2.0",
  "author": "Nikita Ershov <niershov@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/popup-private": "workspace:^",
    "@ds/portal-context": "workspace:^",
    "@ds/theme": "workspace:^",
    "@ds/utils": "workspace:^",
    "classnames": "catalog:",
    "react-remove-scroll": "catalog:",
    "tabbable": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
