    "@ds/icons": "workspace:^",
    "@ds/info-block": "workspace:^",
    "@ds/link": "workspace:^",
    "@ds/list": "workspace:^",
    "@ds/materials": "workspace:^",
    "@ds/scroll": "workspace:^",
    "@ds/segment-control": "workspace:^",
    "@ds/skeleton": "workspace:^",
    "@ds/status": "workspace:^",
    "@ds/tag": "workspace:^",
    "@ds/tooltip": "workspace:^",
    "@ds/truncate-string": "workspace:^",
    "@ds/typography": "workspace:^",
    "@ds/utils": "workspace:^",
    "classnames": "catalog:"
