{
  "name": "@ds/uikit-product-notification",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": ["dist", "src"],
  "sideEffects": ["*.css", "**/*.css"],
  "dependencies": {
    "@ds/bottom-sheet": "workspace:*",
    "@ds/button": "workspace:*",
    "@ds/chips": "workspace:*",
    "@ds/drawer": "workspace:*",
    "@ds/icon-predefined": "workspace:*",
    "@ds/icons": "workspace:*",
    "@ds/info-block": "workspace:*",
    "@ds/link": "workspace:*",
    "@ds/list": "workspace:*",
    "@ds/materials": "workspace:*",
    "@ds/portal-context": "workspace:*",
    "@ds/scroll": "workspace:*",
    "@ds/segment-control": "workspace:*",
    "@ds/skeleton": "workspace:*",
    "@ds/status": "workspace:*",
    "@ds/tag": "workspace:*",
    "@ds/tooltip": "workspace:*",
    "@ds/truncate-string": "workspace:*",
    "@ds/typography": "workspace:*",
    "@ds/utils": "workspace:*",
    "classnames": "catalog:",
    "uncontrollable": "catalog:"
  },
  "publishConfig": { "access": "public" }
}
