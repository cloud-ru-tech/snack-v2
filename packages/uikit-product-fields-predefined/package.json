{
  "name": "@ds/uikit-product-fields-predefined",
  "version": "2.0.3",
  "description": "Набор предопределённых полей формы поверх @ds/fields — телефон, маски, имя, описание, код и другие готовые сценарии ввода.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/uikit-product-fields-predefined"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/uikit-product-fields-predefined",
  "license": "Apache-2.0",
  "author": "Nikita Ershov <niershov@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/adaptive": "workspace:^",
    "@ds/attachment": "workspace:^",
    "@ds/button": "workspace:^",
    "@ds/drawer": "workspace:^",
    "@ds/dropzone": "workspace:^",
    "@ds/field-decorator": "workspace:^",
    "@ds/fields": "workspace:^",
    "@ds/icons": "workspace:^",
    "@ds/input-private": "workspace:^",
    "@ds/list": "workspace:^",
    "@ds/locale": "workspace:^",
    "@ds/modal": "workspace:^",
    "@ds/scroll": "workspace:^",
    "@ds/tooltip": "workspace:^",
    "@ds/utils": "workspace:^",
    "awesome-phonenumber": "^7.8.0",
    "classnames": "catalog:",
    "imask": "^7.6.1",
    "merge-refs": "catalog:",
    "react-imask": "^7.6.1"
  },
  "peerDependencies": {
    "react-hook-form": "^7.79.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "react-hook-form": "7.83.0",
    "yup": "1.7.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
