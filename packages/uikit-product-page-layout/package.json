{
  "name": "@ds/uikit-product-page-layout",
  "version": "1.2.0",
  "license": "Apache-2.0",
  "author": "Nikita Ershov <niershov@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/adaptive": "workspace:^",
    "@ds/button": "workspace:^",
    "@ds/dropdown": "workspace:^",
    "@ds/icon-predefined": "workspace:^",
    "@ds/icons": "workspace:^",
    "@ds/list": "workspace:^",
    "@ds/loader": "workspace:^",
    "@ds/locale": "workspace:^",
    "@ds/modal": "workspace:^",
    "@ds/popover": "workspace:^",
    "@ds/search": "workspace:^",
    "@ds/status": "workspace:^",
    "@ds/tooltip": "workspace:^",
    "@ds/tree": "workspace:^",
    "@ds/truncate-string": "workspace:^",
    "@ds/typography": "workspace:^",
    "@ds/uikit-product-button-predefined": "workspace:^",
    "@ds/uikit-product-copy": "workspace:^",
    "@ds/uikit-product-quota": "workspace:^",
    "@ds/utils": "workspace:^",
    "classnames": "catalog:",
    "uncontrollable": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
