{
  "name": "@ds/list",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ds/adaptive": "workspace:^",
    "@ds/bottom-sheet": "workspace:^",
    "@ds/button": "workspace:^",
    "@ds/divider": "workspace:^",
    "@ds/dropdown": "workspace:^",
    "@ds/icons": "workspace:^",
    "@ds/info-block": "workspace:^",
    "@ds/loader": "workspace:^",
    "@ds/materials": "workspace:^",
    "@ds/portal-context": "workspace:^",
    "@ds/scroll": "workspace:^",
    "@ds/search-private": "workspace:^",
    "@ds/toggles": "workspace:^",
    "@ds/truncate-string": "workspace:^",
    "@ds/typography": "workspace:^",
    "@ds/utils": "workspace:^",
    "@tanstack/react-virtual": "catalog:",
    "classnames": "catalog:",
    "merge-refs": "catalog:"
  },
  "peerDependencies": {
    "@ds/locale": "workspace:^"
  }
}
