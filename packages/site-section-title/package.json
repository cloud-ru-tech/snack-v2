{
  "name": "@ds/site-section-title",
  "version": "1.1.1",
  "description": "Заголовочный блок секции сайта: заголовок и описание в четырёх раскладках с типографикой по ширине экрана.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/site-section-title"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/site-section-title",
  "license": "Apache-2.0",
  "author": "Владислав Вещев",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/adaptive": "workspace:^",
    "@ds/site-rich-text": "workspace:^",
    "@ds/utils": "workspace:^",
    "classnames": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
