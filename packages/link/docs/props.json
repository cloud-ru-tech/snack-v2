{
  "Link": {
    "displayName": "Link",
    "propsTypeName": "LinkProps",
    "description": "Link компонент",
    "props": {
      "appearance": {
        "type": "enum",
        "required": false,
        "values": [
          "blue",
          "green",
          "invertNeutral",
          "neutral",
          "orange",
          "pink",
          "primary",
          "red",
          "violet",
          "yellow"
        ],
        "defaultValue": "primary",
        "description": "Стилизует ссылку для размещения на цветном фоне"
      },
      "as": {
        "type": "ComponentType | ElementType",
        "required": false,
        "defaultValue": "'a'",
        "description": "Полиморфный компонент.\n\nОформить переданный компонент или html элемент в стиль ссылки.\n\nСписок атрибутов, которые переданный компонент должен принять:\n<br/> - `className`\n<br/> - `data-size`\n<br/> - `data-text-mode`\n<br/> - `data-appearance`\n<br/> - `data-inside-text`"
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "href": {
        "type": "string",
        "required": true
      },
      "innerRef": {
        "type": "any",
        "required": false,
        "description": "Ref на реальный DOM-элемент/инстанс, который рендерится через `as`.\nИспользуем явный проп, чтобы не зависеть от `forwardRef` и не тащить type-assertions на экспорт."
      },
      "insideText": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Находится ли ссылка внутри текста (и можно ли её переносить)"
      },
      "label": {
        "type": "string",
        "required": false,
        "defaultValue": "",
        "description": "Текст ссылки"
      },
      "onClick": {
        "type": "((e: MouseEvent<HTMLAnchorElement>) => void) | undefined",
        "required": false
      },
      "role": {
        "type": "enum",
        "required": false,
        "values": [
          "onAccent",
          "regular"
        ],
        "defaultValue": "regular",
        "description": "Роль"
      },
      "target": {
        "type": "string | undefined",
        "required": false
      },
      "truncateVariant": {
        "type": "enum",
        "required": false,
        "values": [
          "end",
          "middle"
        ],
        "description": "Вариант обрезания строки:\n<br/> - `end` - с конца;\n<br/> - `middle` - посередине"
      },
      "underlined": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Наличие нижнего подчеркивания"
      }
    },
    "relatedTypes": {}
  }
}
