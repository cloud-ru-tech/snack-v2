  "Toolbar": {
    "displayName": "Toolbar",
    "propsTypeName": "ToolbarProps",
    "props": {
      "after": {
        "type": "ReactNode",
        "required": false,
        "description": "Дополнительный слот между поиском и переключателем вида (+ slotExtraButton в Figma). <br>\nНа mobile-раскладке (из `AdaptiveProvider`) не рендерится в строке — кнопки переносятся в меню «⋯»\n(`Button` с `onClick` и `label` / `icon` / `aria-label`, одна обёртка вокруг кнопки\nили элемент с `data-toolbar-after-overflow`). Иначе — в `moreActions`."
      },
      "api": {
        "type": "{ mode: \"wysiwyg\" | \"raw\"; focus(): void; isActive(id: ToolbarItemId): boolean; isHeadingActive(level: HeadingLevel): boolean; toggle(id: ToolbarItemId): void; toggleHeading(level: HeadingLevel): void; setParagraph(): void; getLinkHref(): string | undefined; getLinkTitle(): string | undefined; setLink(props: LinkProps): void; insertImage(src: string, alt: string): void; insertTable(rows: number, cols: number): void; subscribe(callback: () => void): () => void; }",
        "required": true,
        "description": "Бэкенд команд: WYSIWYG (TipTap) в preview-режиме либо markdown-исходник (textarea) в raw-режиме.",
        "typeRefs": [
          "ToolbarApi"
        ]
      },
      "bulkActions": {
        "type": "BulkAction[]",
        "required": false,
        "description": "Список массовых действий"
      },
      "checked": {
        "type": "boolean",
        "required": false,
        "description": "Значение чекбокса"
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "Класснейм"
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "dataView": {
        "type": "ToolbarDataViewProps",
        "required": false,
        "description": "Переключатель вида данных — SegmentControl (showDataView в Figma)"
      },
      "filterRow": {
        "type": "FilterRow<TState>",
        "required": false
      },
      "indeterminate": {
        "type": "boolean",
        "required": false,
        "description": "Состояние частичного выбора"
      },
      "items": {
        "type": "ToolbarItemId[]",
        "required": true,
        "typeRefs": [
          "ToolbarItemId"
        ]
      },
      "moreActions": {
        "type": "Action[]",
        "required": false,
        "description": "Элементы выпадающего списка кнопки с действиями"
      },
      "onCheck": {
        "type": "(() => void)",
        "required": false,
        "description": "Колбек смены значения чекбокса"
      },
      "onRefresh": {
        "type": "(() => void)",
        "required": false,
        "description": "Колбек обновления"
      },
      "outline": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Внешний бордер"
      },
      "persist": {
        "type": "ToolbarPersistConfig<TState>",
        "required": false,
        "description": "Конфиг для сохранения состояния в localStorage и queryParams. <br>\nПоле id должно быть уникальным для каждого инстанса компонента. <br>"
      },
      "search": {
        "type": "SearchProps",
        "required": false,
        "description": "Параметры отвечают за строку поиска <br>\n<strong>value</strong>: Значение строки поиска <br>\n<strong>onChange</strong>: Колбэк смены значения <br>\n<strong>onSubmit</strong>: Колбэк на подтверждение поиска по строке\n<strong>placeholder</strong>: Плейсхолдер <br>\n<strong>loading</strong>: Состояние загрузки <br>"
      },
      "selectedCount": {
        "type": "number",
        "required": false,
        "description": "Количество выбранных элементов (для подписи Selected: N)"
      },
      "showBulkCheckbox": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Показывать чекбокс слева (Figma: showBulkCheckbox)"
      },
      "totalCount": {
        "type": "number",
        "required": false,
        "description": "Общее количество элементов (для подписи Selected: N of M)"
      }
    },
    "relatedTypes": {
      "ToolbarApi": {
        "kind": "interface",
        "props": {
          "focus": {
            "type": "() => void",
            "required": true
          },
          "getLinkHref": {
            "type": "() => string | undefined",
            "required": true
          },
          "getLinkTitle": {
            "type": "() => string | undefined",
            "required": true
          },
          "insertImage": {
            "type": "(src: string, alt: string) => void",
            "required": true
          },
          "insertTable": {
            "type": "(rows: number, cols: number) => void",
            "required": true
          },
          "isActive": {
            "type": "(id: ToolbarItemId) => boolean",
            "required": true,
            "description": "Активна ли кнопка (checked-стейт). В raw-режиме — всегда false."
          },
          "isHeadingActive": {
            "type": "(level: HeadingLevel) => boolean",
            "required": true,
            "description": "Активен ли заголовок уровня `level` на текущей строке. В raw-режиме — false."
          },
          "mode": {
            "type": "\"wysiwyg\" | \"raw\"",
            "required": true,
            "values": [
              "raw",
              "wysiwyg"
            ],
            "description": "Режим бэкенда: `wysiwyg` (TipTap, preview) либо `raw` (markdown-исходник в textarea)."
          },
          "setLink": {
            "type": "(props: LinkProps) => void",
            "required": true
          },
          "setParagraph": {
            "type": "() => void",
            "required": true
          },
          "subscribe": {
            "type": "(callback: () => void) => () => void",
            "required": true,
            "description": "Подписка на изменение selection/контента — для перерисовки checked-стейтов."
          },
          "toggle": {
            "type": "(id: ToolbarItemId) => void",
            "required": true,
            "description": "Toggle инлайн/блочной кнопки (bold…block-code)."
          },
          "toggleHeading": {
            "type": "(level: HeadingLevel) => void",
            "required": true
          }
        },
        "own": false
      },
      "ToolbarItemId": {
        "kind": "union",
        "values": [
          "block-code",
          "block-quote",
          "bold",
          "bullet-list",
          "heading",
          "image",
          "inline-code",
          "italic",
          "link",
          "ordered-list",
          "strikethrough",
          "table"
        ],
        "own": false
      }
    }
  },
