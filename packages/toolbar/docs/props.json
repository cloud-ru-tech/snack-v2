{
  "AdaptiveDroplist": {
    "displayName": "AdaptiveDroplist",
    "propsTypeName": null,
    "props": {
      "actionButton": {
        "type": "ReactNode",
        "required": false
      },
      "barHideStrategy": {
        "type": "enum",
        "required": false,
        "values": [
          "leave",
          "move",
          "never",
          "scroll"
        ],
        "description": "Управление скрытием скролл баров:\n<br> - `Never` - показывать всегда\n<br> - `Leave` - скрывать когда курсор покидает компонент\n<br> - `Scroll` - показывать только когда происходит скроллинг\n<br> - `Move` - показывать при движении курсора над компонентом"
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс"
      },
      "closeDroplistOnItemClick": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Закрывать выпадающий список после клика на базовый айтем.\n\nРаботает в режимах selection: 'none' | 'single'"
      },
      "closeOnPopstate": {
        "type": "boolean",
        "required": false,
        "description": "Закрывать ли поповер при переходе по истории браузера"
      },
      "collapse": {
        "type": "CollapseState",
        "required": false,
        "description": "Настройки раскрытия элементов"
      },
      "container": {
        "type": "RefObject<HTMLElement | null>",
        "required": false,
        "description": "Контейнер портала (ref). Переопределяет `PortalContext` для этого дроплиста\n(по аналогии с `container` у Modal/Drawer). По умолчанию — из `PortalContextProvider`."
      },
      "contentRender": {
        "type": "((props: ContentRenderProps) => ReactNode)",
        "required": false,
        "description": "Рендер функция основного контента айтема"
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "dataError": {
        "type": "boolean",
        "required": false,
        "description": "Загрузка данных завершилась ошибкой: показывается `errorDataState`"
      },
      "dataFiltered": {
        "type": "boolean",
        "required": false,
        "description": "Текущий пустой список — результат поиска/фильтра: показывается `noResultsState` вместо `noDataState`"
      },
      "errorDataState": {
        "type": "EmptyStateProps",
        "required": false,
        "description": "Экран при ошибке запроса"
      },
      "footer": {
        "type": "ReactNode ;",
        "required": false,
        "description": "Кастомизируемый элемент в конце списка"
      },
      "footerActiveElementsRefs": {
        "type": "RefObject<HTMLElement>[]",
        "required": false,
        "description": "Список ссылок на кастомные элементы, помещенные в специальную секцию внизу списка"
      },
      "footerDivider": {
        "type": "boolean",
        "required": false,
        "description": "Показывать divider между body и footer (Figma `dropdownContainer.dividerWrapper` снизу)"
      },
      "header": {
        "type": "ReactNode ;",
        "required": false,
        "description": "Кастомизируемый элемент в начале списка — Figma `dropdownContainer.topBar`.\nПодходит для заголовка / справочного блока над поиском."
      },
      "headerDivider": {
        "type": "boolean",
        "required": false,
        "description": "Показывать divider между header и body (Figma `dropdownContainer.dividerWrapper` сверху)"
      },
      "items": {
        "type": "Item[]",
        "required": true,
        "description": "Основные элементы списка"
      },
      "label": {
        "type": "string",
        "required": false,
        "description": "Заголовок mobile BottomSheet"
      },
      "layoutType": {
        "type": "enum",
        "required": false,
        "values": [
          "desktop",
          "mobile"
        ],
        "defaultValue": "desktop"
      },
      "limitedScrollHeight": {
        "type": "boolean",
        "required": false,
        "description": "Ограничить максимальную высоту скролл-контейнера в зависимости от `size`"
      },
      "listRef": {
        "type": "RefObject<HTMLElement>",
        "required": false,
        "description": "Ссылка на элемент выпадающего списка"
      },
      "loading": {
        "type": "boolean",
        "required": false,
        "description": "Флаг, отвечающий за состояние загрузки списка"
      },
      "marker": {
        "type": "boolean",
        "required": false,
        "description": "Отображать ли маркер у выбранного элемента списка"
      },
      "noDataState": {
        "type": "EmptyStateProps",
        "required": false,
        "description": "Экран при отсутствии данных"
      },
      "noResultsState": {
        "type": "EmptyStateProps",
        "required": false,
        "description": "Экран при отсутствии результатов поиска или фильтров"
      },
      "onBackButtonClick": {
        "type": "(() => void)",
        "required": false
      },
      "onOpenChange": {
        "type": "((isOpen: boolean) => void)",
        "required": false,
        "description": "Колбек отображения компонента. Срабатывает при изменении состояния open."
      },
      "onScroll": {
        "type": "((event?: Event) => void)",
        "required": false,
        "description": "Колбек на скролл прокручиваемого списка"
      },
      "open": {
        "type": "boolean",
        "required": false,
        "description": "Управляет состоянием показан/не показан."
      },
      "pinBottom": {
        "type": "Item[]",
        "required": false,
        "description": "Элементы списка, закрепленные снизу"
      },
      "pinTop": {
        "type": "Item[]",
        "required": false,
        "description": "Элементы списка, закрепленные сверху"
      },
      "placement": {
        "type": "enum",
        "required": false,
        "values": [
          "bottom",
          "bottom-end",
          "bottom-start",
          "left",
          "left-end",
          "left-start",
          "right",
          "right-end",
          "right-start",
          "top",
          "top-end",
          "top-start"
        ],
        "defaultValue": "top",
        "description": "Положение поповера относительно своего триггера (children)."
      },
      "scroll": {
        "type": "boolean",
        "required": false,
        "description": "Включить ли скролл для основной части списка"
      },
      "scrollContainerClassName": {
        "type": "string",
        "required": false,
        "description": "CSS-класс для scroll обертки основного списка айтемов"
      },
      "scrollContainerRef": {
        "type": "Ref<HTMLElement>",
        "required": false,
        "description": "Ссылка на контейнер, который скроллится"
      },
      "scrollRef": {
        "type": "Ref<HTMLElement>",
        "required": false,
        "description": "Ссылка на элемент, обозначающий самый конец прокручиваемого списка"
      },
      "scrollToSelectedItem": {
        "type": "boolean",
        "required": false,
        "description": "Флаг, отвечающий за прокручивание до выбранного элемента"
      },
      "search": {
        "type": "SearchState",
        "required": false,
        "description": "Настройки поисковой строки"
      },
      "selection": {
        "type": "SelectionSingleState | SelectionMultipleState",
        "required": false,
        "description": "Настройки выбора элементов. `mode: 'single'` — один выбранный элемент (`value: ItemId`),\n`mode: 'multiple'` — множественный выбор (`value: ItemId[]`). Без `selection` выбора нет —\nклик вызывает только `onClick` элемента."
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "l",
          "m",
          "s"
        ],
        "description": "Размер списка"
      },
      "slotAfterHeadline": {
        "type": "ReactNode",
        "required": false
      },
      "trigger": {
        "type": "enum",
        "required": false,
        "values": [
          "click",
          "clickAndFocusVisible",
          "focus",
          "focusVisible",
          "hover",
          "hoverAndFocus",
          "hoverAndFocusVisible"
        ],
        "description": "Условие отображения поповера:\n<br/> - `click` - открывать по клику\n<br/> - `hover` - открывать по ховеру\n<br/> - `focusVisible` - открывать по focus-visible\n<br/> - `focus` - открывать по фокусу\n<br/> - `hoverAndFocusVisible` - открывать по ховеру и focus-visible\n<br/> - `hoverAndFocus` - открывать по ховеру и фокусу\n<br/> - `clickAndFocusVisible` - открывать по клику и focus-visible"
      },
      "triggerClassName": {
        "type": "string",
        "required": false,
        "description": "CSS-класс триггера"
      },
      "triggerElemRef": {
        "type": "RefObject<HTMLElement>",
        "required": false,
        "description": "Ссылка на элемент-триггер для дроплиста"
      },
      "untouchableScrollbars": {
        "type": "boolean",
        "required": false,
        "description": "Отключает возможность взаимодействовать со скролбарами мышью."
      },
      "virtualized": {
        "type": "boolean",
        "required": false,
        "description": "Включить виртуализацию на компоненты списка. Рекомендуется если у вас от 1к элементов списка"
      },
      "widthStrategy": {
        "type": "enum",
        "required": false,
        "values": [
          "auto",
          "eq",
          "gte"
        ],
        "defaultValue": "auto",
        "description": "Стратегия управления шириной контейнера поповера\n<br/> - `auto` - соответствует ширине контента,\n<br/> - `gte` - Great Than or Equal, равен ширине таргета или больше ее, если контент в поповере шире,\n<br/> - `eq` - Equal, строго равен ширине таргета."
      }
    },
    "relatedTypes": {}
  },
