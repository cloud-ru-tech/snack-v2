{
  "name": "@ds/toolbar",
  "version": "1.0.10",
  "description": "Панель инструментов списков и таблиц — поиск, фильтры, массовые действия, меню «Ещё».",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/toolbar"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/toolbar",
  "license": "Apache-2.0",
  "author": "Anna Kozlova <apkozlova@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@cloud-ru/ft-request-payload-transform": "catalog:",
    "@ds/adaptive": "workspace:^",
    "@ds/bottom-sheet": "workspace:^",
    "@ds/button": "workspace:^",
    "@ds/chips": "workspace:^",
    "@ds/icons": "workspace:^",
    "@ds/list": "workspace:^",
    "@ds/locale": "workspace:^",
    "@ds/materials": "workspace:^",
    "@ds/portal-context": "workspace:^",
    "@ds/scroll": "workspace:^",
    "@ds/search": "workspace:^",
    "@ds/segment-control": "workspace:^",
    "@ds/tag": "workspace:^",
    "@ds/theme": "workspace:^",
    "@ds/toggles": "workspace:^",
    "@ds/tooltip": "workspace:^",
    "@ds/utils": "workspace:^",
    "classnames": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
