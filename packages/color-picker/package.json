{
  "name": "@ds/color-picker",
  "version": "1.0.2",
  "description": "Компонент выбора цвета с палитрой, переключаемыми цветовыми моделями (HEX/RGB/HSV), альфа-каналом и опциональным режимом ручного применения.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/color-picker"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/color-picker",
  "license": "Apache-2.0",
  "author": "Nikita Ershov <niershov@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/button": "workspace:^",
    "@ds/input-private": "workspace:^",
    "@ds/locale": "workspace:^",
    "@ds/segment-control": "workspace:^",
    "@ds/utils": "workspace:^",
    "classnames": "catalog:",
    "react-colorful": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
