{
  "ButtonDropdown": {
    "displayName": "ButtonDropdown",
    "propsTypeName": "ButtonDropdownProps",
    "props": {
      "appearance": {
        "type": "enum",
        "required": false,
        "values": [
          "critical",
          "neutral",
          "primary"
        ],
        "defaultValue": "neutral",
        "description": "Вариант оформления",
        "typeRefs": [
          "Appearance"
        ]
      },
      "as": {
        "type": "enum",
        "required": false,
        "values": [
          "button"
        ],
        "description": "Элемент или компонент для рендера: 'button' | 'a' | ComponentType (например Link из react-router-dom)"
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "Дополнительный класс\nКласс триггерной кнопки."
      },
      "closeDroplistOnItemClick": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Закрывать выпадающий список после клика на базовый айтем.\n\nРаботает в режимах selection: 'none' | 'single'"
      },
      "closeOnPopstate": {
        "type": "boolean",
        "required": false,
        "description": "Закрывать ли поповер при переходе по истории браузера"
      },
      "counter": {
        "type": "Omit<CounterProps, \"size\">",
        "required": false,
        "description": "Пропсы для counter. `appearance` можно задать явно (по умолчанию наследуется от appearance кнопки).",
        "typeRefs": [
          "CounterProps"
        ]
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "disabled": {
        "type": "boolean",
        "required": false,
        "description": "Отключена"
      },
      "fullWidth": {
        "type": "boolean",
        "required": false,
        "description": "На всю ширину"
      },
      "innerRef": {
        "type": "((instance: HTMLButtonElement | null) => void) | RefObject<HTMLButtonElement> | null",
        "required": false,
        "description": "Ref на реальный DOM-элемент/инстанс, который рендерится через `as`.\nИспользуем явный проп, чтобы не зависеть от `forwardRef` и не тащить type-assertions на экспорт.",
        "typeRefs": [
          "PolymorphicRef"
        ]
      },
      "items": {
        "type": "Item[]",
        "required": true,
        "description": "Основные элементы списка",
        "typeRefs": [
          "BaseItemWithoutNonGroup",
          "CommonGroupItem",
          "Item",
          "ScrollProps"
        ]
      },
      "label": {
        "type": "string",
        "required": false,
        "description": "Текст кнопки"
      },
      "loading": {
        "type": "boolean",
        "required": false,
        "description": "Состояние загрузки"
      },
      "minWidth": {
        "type": "boolean",
        "required": false,
        "description": "Минимальная ширина контейнера (`min-width` из токена размера). По умолчанию `true`.\n`false` — кнопка сжимается по контенту вместо фиксированного минимума."
      },
      "onOpenChange": {
        "type": "((open: boolean) => void)",
        "required": false,
        "description": "Колбэк изменения раскрытия."
      },
      "open": {
        "type": "boolean",
        "required": false,
        "description": "Контролируемое состояние раскрытия."
      },
      "placement": {
        "type": "enum",
        "required": false,
        "values": [
          "bottom",
          "bottom-end",
          "bottom-start",
          "left",
          "left-end",
          "left-start",
          "right",
          "right-end",
          "right-start",
          "top",
          "top-end",
          "top-start"
        ],
        "defaultValue": "top",
        "description": "Положение поповера относительно своего триггера (children).",
        "typeRefs": [
          "Placement"
        ]
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "l",
          "m",
          "s",
          "xs"
        ],
        "defaultValue": "s",
        "description": "Размер триггера; для `xs` применяется кнопка `s`.",
        "typeRefs": [
          "ButtonDropdownSize"
        ]
      },
      "triggerClassName": {
        "type": "string",
        "required": false,
        "description": "CSS-класс триггера"
      }
    },
    "relatedTypes": {
      "Appearance": {
        "kind": "union",
        "values": [
          "critical",
          "neutral",
          "primary"
        ],
        "own": false
      },
      "Appearance (@ds/counter)": {
        "kind": "union",
        "values": [
          "blue",
          "green",
          "neutral",
          "orange",
          "pink",
          "primary",
          "red",
          "violet",
          "yellow"
        ],
        "own": false
      },
      "BaseItemWithoutNonGroup": {
        "kind": "interface",
        "props": {
          "afterContent": {
            "type": "string | number | boolean | ReactElement<any, string | JSXElementConstructor<any>> | Iterable<ReactNode> | ReactPortal | null | undefined",
            "required": false,
            "description": "Слот после основного контента"
          },
          "beforeContent": {
            "type": "string | number | boolean | ReactElement<any, string | JSXElementConstructor<any>> | Iterable<ReactNode> | ReactPortal | null | undefined",
            "required": false,
            "description": "Слот до основного контента"
          },
          "checked": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Управляемое состояние выбранности айтема"
          },
          "className": {
            "type": "string | undefined",
            "required": false,
            "description": "CSS-класс"
          },
          "content": {
            "type": "ReactNode | ItemContentProps",
            "required": false,
            "description": "Основной контент айтема",
            "typeRefs": [
              "ItemContent"
            ]
          },
          "data-test-id": {
            "type": "string | undefined",
            "required": false
          },
          "disabled": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Флаг неактивности элемента"
          },
          "hidden": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Скрыть элемент из списка (не рендерится и исключается из навигации)"
          },
          "id": {
            "type": "ItemId | undefined",
            "required": false,
            "description": "Уникальный идентификатор",
            "typeRefs": [
              "ItemId"
            ]
          },
          "itemRef": {
            "type": "RefObject<HTMLElement> | undefined",
            "required": false,
            "description": "Ссылка на DOM-элемент айтема"
          },
          "itemWrapRender": {
            "type": "((item: ReactNode) => ReactNode) | undefined",
            "required": false,
            "description": "Рендер-обёртка вокруг айтема (например, для проксирования в `Tooltip`/`Link`)"
          },
          "onBlur": {
            "type": "((e: FocusEvent<HTMLElement>) => void) | undefined",
            "required": false,
            "description": "Колбек обработки блюра"
          },
          "onClick": {
            "type": "((e: MouseEvent<HTMLElement>) => void) | undefined",
            "required": false,
            "description": "Колбек обработки клика"
          },
          "onFocus": {
            "type": "((e: FocusEvent<HTMLElement>) => void) | undefined",
            "required": false,
            "description": "Колбек обработки фокуса"
          },
          "onKeyDown": {
            "type": "((e: KeyboardEvent<HTMLElement>) => void) | undefined",
            "required": false,
            "description": "Колбек обработки нажатия клавиши"
          },
          "onMouseDown": {
            "type": "((e: MouseEvent<HTMLElement>) => void) | undefined",
            "required": false,
            "description": "Колбек обработки нажатия кнопки мыши"
          },
          "showSwitchIcon": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Флаг отображения иконки у чекбоксов"
          }
        },
        "own": false
      },
      "ButtonDropdownSize": {
        "kind": "union",
        "values": [
          "l",
          "m",
          "s",
          "xs"
        ],
        "own": true
      },
      "CommonGroupItem": {
        "kind": "interface",
        "props": {
          "beforeContent": {
            "type": "string | number | boolean | ReactElement<any, string | JSXElementConstructor<any>> | Iterable<ReactNode> | ReactPortal | null | undefined",
            "required": false,
            "description": "Слот иконки слева от label."
          },
          "divider": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Показать разделитель над группой"
          },
          "groupVariant": {
            "type": "\"subtitle\" | \"subtitleTertiary\" | undefined",
            "required": false,
            "values": [
              "subtitle",
              "subtitleTertiary"
            ],
            "description": "Визуальный стиль заголовка группы"
          },
          "hidden": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Скрыть группу из списка"
          },
          "label": {
            "type": "string | undefined",
            "required": false,
            "description": "Заголовок группы"
          },
          "truncate": {
            "type": "{ variant?: TruncateStringProps[\"variant\"]; } | undefined",
            "required": false,
            "description": "Настройки усечения длинного заголовка группы",
            "typeRefs": [
              "TruncateStringProps"
            ]
          }
        },
        "own": false
      },
      "CounterProps": {
        "kind": "interface",
        "props": {
          "appearance": {
            "type": "Appearance | undefined",
            "required": false,
            "values": [
              "blue",
              "green",
              "neutral",
              "orange",
              "pink",
              "primary",
              "red",
              "violet",
              "yellow"
            ],
            "description": "Внешний вид",
            "typeRefs": [
              "Appearance (@ds/counter)"
            ]
          },
          "className": {
            "type": "string | undefined",
            "required": false,
            "description": "Дополнительный CSS-класс"
          },
          "data-test-id": {
            "type": "string | undefined",
            "required": false
          },
          "innerRef": {
            "type": "Ref<HTMLDivElement> | undefined",
            "required": false,
            "description": "Ref на корневой DOM-элемент.\nИспользуем явный проп, чтобы не зависеть от `forwardRef` и не тащить type-assertions на экспорт."
          },
          "plusLimit": {
            "type": "number | undefined",
            "required": false,
            "description": "Порог сокращения значения для варианта `count-plus`"
          },
          "roleAppearance": {
            "type": "RoleAppearance | undefined",
            "required": false,
            "values": [
              "accent",
              "decor"
            ],
            "description": "Роль, в которой применяется `appearance`: акцентная заливка или декоративная",
            "typeRefs": [
              "RoleAppearance"
            ]
          },
          "size": {
            "type": "Size | undefined",
            "required": false,
            "values": [
              "s",
              "xs"
            ],
            "description": "Размер",
            "typeRefs": [
              "Size"
            ]
          },
          "value": {
            "type": "number",
            "required": true,
            "description": "Значение"
          },
          "variant": {
            "type": "Variant | undefined",
            "required": false,
            "values": [
              "count",
              "count-k",
              "count-plus"
            ],
            "description": "Вариант форматирования",
            "typeRefs": [
              "Variant"
            ]
          }
        },
        "own": false
      },
      "Item": {
        "kind": "alias",
        "type": "BaseItem | GroupItem | GroupSelectItem | NextListItem | AccordionItem",
        "own": false
      },
      "ItemContent": {
        "kind": "interface",
        "props": {
          "caption": {
            "type": "string | undefined",
            "required": false
          },
          "className": {
            "type": "string | undefined",
            "required": false
          },
          "data-test-id": {
            "type": "string | undefined",
            "required": false
          },
          "description": {
            "type": "string | undefined",
            "required": false
          },
          "disabled": {
            "type": "boolean | undefined",
            "required": false
          },
          "label": {
            "type": "string | number",
            "required": true
          },
          "truncate": {
            "type": "TruncateProps | undefined",
            "required": false,
            "typeRefs": [
              "TruncateProps"
            ]
          }
        },
        "own": false
      },
      "ItemId": {
        "kind": "alias",
        "type": "string | number",
        "own": false
      },
      "OriginalScrollProps": {
        "kind": "interface",
        "props": {
          "autoscrollTo": {
            "type": "AutoscrollTo | undefined",
            "required": false,
            "values": [
              "bottom",
              "right"
            ],
            "description": "Включает автоскрол при маунте и изменении размера контента:\n<br /> - `bottom` - автоскрол вниз,\n<br /> - `right` - автоскрол вправо,",
            "typeRefs": [
              "AutoscrollTo"
            ]
          },
          "barHideStrategy": {
            "type": "BarHideStrategy | undefined",
            "required": false,
            "values": [
              "leave",
              "move",
              "never",
              "scroll"
            ],
            "description": "Управление скрытием скролл баров:\n<br /> - `Never` - показывать всегда\n<br /> - `Leave` - скрывать когда курсор покидает компонент\n<br /> - `Scroll` - показывать только когда происходит скроллинг\n<br /> - `Move` - показывать при движении курсора над компонентом",
            "typeRefs": [
              "BarHideStrategy"
            ]
          },
          "children": {
            "type": "string | number | boolean | ReactElement<any, string | JSXElementConstructor<any>> | Iterable<ReactNode> | ReactPortal | null | undefined",
            "required": false
          },
          "className": {
            "type": "string | undefined",
            "required": false
          },
          "clickScrolling": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Скролить ли по клику в скроллбар."
          },
          "data-test-id": {
            "type": "string | undefined",
            "required": false
          },
          "onInitialized": {
            "type": "(() => void) | undefined",
            "required": false,
            "description": "Коллбэк вызывающийся на инициализацию скролла"
          },
          "onScroll": {
            "type": "((event?: Event) => void) | undefined",
            "required": false,
            "description": "Колбек события скрола."
          },
          "overflow": {
            "type": "{ x?: \"hidden\" | \"visible\" | \"scroll\" | \"visible-hidden\" | \"visible-scroll\"; y?: \"hidden\" | \"visible\" | \"scroll\" | \"visible-hidden\" | \"visible-scroll\"; } | undefined",
            "required": false,
            "description": "Поведение overflow по осям. По умолчанию OverlayScrollbars выставляет `scroll`\nна обе оси; если контента по оси быть не должно — передавай `'hidden'`."
          },
          "paddingAbsolute": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Должны ли паддинги быть абсолютными"
          },
          "resize": {
            "type": "Resize | undefined",
            "required": false,
            "values": [
              "both",
              "horizontal",
              "none",
              "vertical"
            ],
            "description": "Настройка возможности регулировать Scroll-контейнер:\n<br /> - `None` - нельзя изменять размер\n<br /> - `Horizontal` - можно изменять размер только по горизонтали\n<br /> - `Vertical` - можно изменять размер только по вертикали\n<br /> - `Both` - можно изменять размер в обеих координатах",
            "typeRefs": [
              "Resize"
            ]
          },
          "size": {
            "type": "Size | undefined",
            "required": false,
            "values": [
              "m",
              "s"
            ],
            "description": "Размер скролбаров",
            "typeRefs": [
              "Size (@ds/scroll)"
            ]
          },
          "untouchableScrollbars": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Отключает возможность взаимодействовать со скролбарами мышью."
          }
        },
        "own": false
      },
      "Placement": {
        "kind": "union",
        "values": [
          "bottom",
          "bottom-end",
          "bottom-start",
          "left",
          "left-end",
          "left-start",
          "right",
          "right-end",
          "right-start",
          "top",
          "top-end",
          "top-start"
        ],
        "own": false
      },
      "PolymorphicRef": {
        "kind": "alias",
        "type": "ComponentPropsWithRef<T>[\"ref\"]",
        "own": false
      },
      "RoleAppearance": {
        "kind": "union",
        "values": [
          "accent",
          "decor"
        ],
        "own": false
      },
      "ScrollProps": {
        "kind": "interface",
        "props": {
          "barHideStrategy": {
            "type": "BarHideStrategy | undefined",
            "required": false,
            "values": [
              "leave",
              "move",
              "never",
              "scroll"
            ],
            "description": "Управление скрытием скролл баров:\n<br> - `Never` - показывать всегда\n<br> - `Leave` - скрывать когда курсор покидает компонент\n<br> - `Scroll` - показывать только когда происходит скроллинг\n<br> - `Move` - показывать при движении курсора над компонентом",
            "typeRefs": [
              "OriginalScrollProps"
            ]
          },
          "onScroll": {
            "type": "((event?: Event) => void) | undefined",
            "required": false,
            "description": "Колбек на скролл прокручиваемого списка",
            "typeRefs": [
              "OriginalScrollProps"
            ]
          },
          "scroll": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Включить ли скролл для основной части списка"
          },
          "scrollContainerRef": {
            "type": "Ref<HTMLElement> | undefined",
            "required": false,
            "description": "Ссылка на контейнер, который скроллится"
          },
          "scrollRef": {
            "type": "Ref<HTMLElement> | undefined",
            "required": false,
            "description": "Ссылка на элемент, обозначающий самый конец прокручиваемого списка"
          },
          "untouchableScrollbars": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Отключает возможность взаимодействовать со скролбарами мышью."
          }
        },
        "own": false
      },
      "Size": {
        "kind": "union",
        "values": [
          "s",
          "xs"
        ],
        "own": false
      },
      "TruncateStringProps": {
        "kind": "alias",
        "type": "({ variant?: typeof VARIANT.End; } & { 'data-test-id'?: string; } & AriaAttributes & { className?: string; tooltipClassName?: string; hideTooltip?: boolean; maxLines?: number; placement?: TooltipProps[\"placement\"]; text: string; trigger?: TooltipProps[\"trigger\"]; }) | ({ variant: typeof VARIANT.Middle; } & { 'data-test-id'?: string; } & AriaAttributes & { className?: string; tooltipClassName?: string; hideTooltip?: boolean; placement?: TooltipProps[\"placement\"]; text: string; trigger?: TooltipProps[\"trigger\"]; })",
        "own": false
      },
      "Variant": {
        "kind": "union",
        "values": [
          "count",
          "count-k",
          "count-plus"
        ],
        "own": false
      }
    }
  }
}
