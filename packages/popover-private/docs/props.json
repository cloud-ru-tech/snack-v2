          "click",
          "hover",
          "focusVisible",
          "focus",
          "hoverAndFocusVisible",
          "hoverAndFocus",
          "clickAndFocusVisible"
        ],
        "own": true
      },
      "PopoverWidthStrategy": {
        "kind": "union",
        "values": [
          "auto",
          "gte",
          "eq"
        ],
        "own": true
      },
      "PopoverHeightStrategy": {
        "kind": "union",
        "values": [
          "auto",
          "eq",
          "lte"
        ],
        "own": true
      },
      "ChildrenFunction": {
        "kind": "alias",
        "type": "(params: { getReferenceProps: GetReferencePropsFunc; ref: (node: ReferenceType | null) => void; }) => ReactNode",
        "own": true
      }
    }
  },
