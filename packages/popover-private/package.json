{
  "name": "@ds/popover-private",
  "version": "1.0.1",
  "description": "Низкоуровневый popover на @floating-ui — позиционирование, стрелка, триггеры. Используется как фундамент для Tooltip, Popover, Dropdown.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/popover-private"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/popover-private",
  "license": "Apache-2.0",
  "author": "Anna Kozlova <apkozlova@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/portal-context": "workspace:^",
    "@ds/utils": "workspace:^",
    "@floating-ui/react": "^0.27.20",
    "@types/react-is": "^19.2.0",
    "classnames": "catalog:",
    "react-is": "^19.2.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
