{
  "name": "@ds/uikit-product-promo-tag-predefined",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "author": "Артемий Зимин <aazimin@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/locale": "workspace:^",
    "@ds/promo-tag": "workspace:^",
    "@ds/tooltip": "workspace:^",
    "@ds/utils": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
