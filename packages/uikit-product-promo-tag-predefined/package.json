{
  "name": "@ds/uikit-product-promo-tag-predefined",
  "version": "1.0.2",
  "description": "Предопределённый промо-тег продукта с локализованным текстом и tooltip — пресеты product-статусов Cloud.ru.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/uikit-product-promo-tag-predefined"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/uikit-product-promo-tag-predefined",
  "license": "Apache-2.0",
  "author": "Артемий Зимин <aazimin@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/link": "workspace:^",
    "@ds/locale": "workspace:^",
    "@ds/promo-tag": "workspace:^",
    "@ds/tooltip": "workspace:^",
    "@ds/utils": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
