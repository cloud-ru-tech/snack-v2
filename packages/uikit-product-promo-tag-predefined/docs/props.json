{
  "PromoTagPredefined": {
    "displayName": "PromoTagPredefined",
    "propsTypeName": "PromoTagPredefinedProps",
    "props": {
      "context": {
        "type": "enum",
        "required": false,
        "values": [
          "functional",
          "service"
        ],
        "defaultValue": "service",
        "description": "Контекст тега с вариантом \"preview\"",
        "typeRefs": [
          "PreviewContext"
        ]
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "tooltip": {
        "type": "Pick<TooltipProps, \"open\" | \"onOpenChange\" | \"trigger\" | \"placement\">",
        "required": false,
        "description": "Настройки тултипа",
        "typeRefs": [
          "TooltipProps"
        ]
      },
      "variant": {
        "type": "enum",
        "required": true,
        "values": [
          "connecting",
          "partner",
          "preview"
        ],
        "description": "Вариант промо-тега",
        "typeRefs": [
          "Variant"
        ]
      }
    },
    "relatedTypes": {
      "ChildrenFunction": {
        "kind": "alias",
        "type": "(params: { getReferenceProps: GetReferencePropsFunc; ref: (node: ReferenceType | null) => void; }) => ReactNode",
        "own": false
      },
      "Placement": {
        "kind": "union",
        "values": [
          "bottom",
          "bottom-end",
          "bottom-start",
          "left",
          "left-end",
          "left-start",
          "right",
          "right-end",
          "right-start",
          "top",
          "top-end",
          "top-start"
        ],
        "own": false
      },
      "PreviewContext": {
        "kind": "union",
        "values": [
          "functional",
          "service"
        ],
        "own": true
      },
      "TooltipProps": {
        "kind": "interface",
        "props": {
          "children": {
            "type": "ReactNode | ChildrenFunction",
            "required": false,
            "description": "Триггер поповера (подробнее читайте ниже)",
            "typeRefs": [
              "ChildrenFunction"
            ]
          },
          "className": {
            "type": "string | undefined",
            "required": false
          },
          "closeOnPopstate": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Закрывать ли поповер при переходе по истории браузера"
          },
          "data-test-id": {
            "type": "string | undefined",
            "required": false
          },
          "disableMaxWidth": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Отключение ограничения ширины тултипа"
          },
          "disableSpanWrapper": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Отключает для `isValidElement` внешнюю обертку триггера\n<br/>\nПригодится для элементов с `position: absolute`\n<br/>\nРаботает для триггеров, которые умеют отдать свою DOM-ноду: нативные элементы, `forwardRef`-компоненты\nи компоненты, помеченные `withInnerRefSupport` из `@ds/utils`. Остальные всё равно получают `<span>` —\nбез ноды поповеру не от чего считать позицию; в dev-режиме об этом печатается предупреждение."
          },
          "fallbackPlacements": {
            "type": "Placement[] | undefined",
            "required": false,
            "description": "Цепочка расположений которая будет применяться к поповеру от первого к последнему если при текущем он не влезает.",
            "typeRefs": [
              "Placement"
            ]
          },
          "hoverDelayClose": {
            "type": "number | undefined",
            "required": false,
            "description": "Задержка закрытия по ховеру"
          },
          "hoverDelayOpen": {
            "type": "number | undefined",
            "required": false,
            "description": "Задержка открытия по ховеру"
          },
          "offset": {
            "type": "number | undefined",
            "required": false,
            "description": "Отступ поповера от его триггер-элемента (в пикселях)."
          },
          "onOpenChange": {
            "type": "((isOpen: boolean) => void) | undefined",
            "required": false,
            "description": "Колбек отображения компонента. Срабатывает при изменении состояния open."
          },
          "open": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Управляет состоянием показан/не показан."
          },
          "placement": {
            "type": "Placement | undefined",
            "required": false,
            "values": [
              "bottom",
              "bottom-end",
              "bottom-start",
              "left",
              "left-end",
              "left-start",
              "right",
              "right-end",
              "right-start",
              "top",
              "top-end",
              "top-start"
            ],
            "description": "Положение поповера относительно своего триггера (children).",
            "typeRefs": [
              "Placement"
            ]
          },
          "tip": {
            "type": "string | number | boolean | ReactElement<any, string | JSXElementConstructor<any>> | Iterable<ReactNode> | ReactPortal | null | undefined",
            "required": true,
            "description": "Содержимое тултипа (текст или разметка)"
          },
          "trigger": {
            "type": "Trigger | undefined",
            "required": false,
            "values": [
              "click",
              "clickAndFocusVisible",
              "focus",
              "focusVisible",
              "hover",
              "hoverAndFocus",
              "hoverAndFocusVisible"
            ],
            "description": "Условие отображения поповера:\n<br/> - `click` - открывать по клику\n<br/> - `hover` - открывать по ховеру\n<br/> - `focusVisible` - открывать по focus-visible\n<br/> - `focus` - открывать по фокусу\n<br/> - `hoverAndFocusVisible` - открывать по ховеру и focus-visible\n<br/> - `hoverAndFocus` - открывать по ховеру и фокусу\n<br/> - `clickAndFocusVisible` - открывать по клику и focus-visible",
            "typeRefs": [
              "Trigger"
            ]
          },
          "triggerClassName": {
            "type": "string | undefined",
            "required": false,
            "description": "CSS-класс триггера"
          },
          "triggerRef": {
            "type": "ForwardedRef<HTMLElement | ReferenceType | null> | undefined",
            "required": false,
            "description": "Ref ссылка на триггер"
          }
        },
        "own": false
      },
      "Trigger": {
        "kind": "union",
        "values": [
          "click",
          "clickAndFocusVisible",
          "focus",
          "focusVisible",
          "hover",
          "hoverAndFocus",
          "hoverAndFocusVisible"
        ],
        "own": false
      },
      "Variant": {
        "kind": "union",
        "values": [
          "connecting",
          "partner",
          "preview"
        ],
        "own": true
      }
    }
  }
}
