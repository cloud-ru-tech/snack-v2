{
  "PromoTagPredefined": {
    "displayName": "PromoTagPredefined",
    "propsTypeName": "PromoTagPredefinedProps",
    "props": {
      "context": {
        "type": "enum",
        "required": false,
        "values": [
          "functional",
          "service"
        ],
        "description": "Контекст тега с вариантом \"preview\""
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "tooltip": {
        "type": "TooltipSettings | (TooltipSettings & { onSupportClick(e: MouseEvent<Element, MouseEvent>): void; }) | (TooltipSettings & { ...; })",
        "required": false,
        "description": "Настройки тултипа\nНастройки тултипа; если передан — `tip` обязателен. Без `tooltip` тултип не рендерится",
        "typeRefs": [
          "TooltipSettings"
        ]
      },
      "variant": {
        "type": "enum",
        "required": true,
        "values": [
          "connecting",
          "default",
          "freeTier",
          "latest",
          "partner",
          "preview",
          "private",
          "public",
          "soon"
        ],
        "description": "Вариант промо-тега"
      }
    },
    "relatedTypes": {
      "Placement": {
        "kind": "union",
        "values": [
          "bottom",
          "bottom-end",
          "bottom-start",
          "left",
          "left-end",
          "left-start",
          "right",
          "right-end",
          "right-start",
          "top",
          "top-end",
          "top-start"
        ],
        "own": false
      },
      "TooltipSettings": {
        "kind": "interface",
        "props": {
          "onOpenChange": {
            "type": "((isOpen: boolean) => void) | undefined",
            "required": false,
            "description": "Колбек отображения компонента. Срабатывает при изменении состояния open."
          },
          "open": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Управляет состоянием показан/не показан."
          },
          "placement": {
            "type": "Placement | undefined",
            "required": false,
            "values": [
              "bottom",
              "bottom-end",
              "bottom-start",
              "left",
              "left-end",
              "left-start",
              "right",
              "right-end",
              "right-start",
              "top",
              "top-end",
              "top-start"
            ],
            "description": "Положение поповера относительно своего триггера (children).",
            "typeRefs": [
              "Placement"
            ]
          },
          "trigger": {
            "type": "Trigger | undefined",
            "required": false,
            "values": [
              "click",
              "clickAndFocusVisible",
              "focus",
              "focusVisible",
              "hover",
              "hoverAndFocus",
              "hoverAndFocusVisible"
            ],
            "description": "Условие отображения поповера:\n<br/> - `click` - открывать по клику\n<br/> - `hover` - открывать по ховеру\n<br/> - `focusVisible` - открывать по focus-visible\n<br/> - `focus` - открывать по фокусу\n<br/> - `hoverAndFocusVisible` - открывать по ховеру и focus-visible\n<br/> - `hoverAndFocus` - открывать по ховеру и фокусу\n<br/> - `clickAndFocusVisible` - открывать по клику и focus-visible",
            "typeRefs": [
              "Trigger"
            ]
          }
        },
        "own": true
      },
      "Trigger": {
        "kind": "union",
        "values": [
          "click",
          "clickAndFocusVisible",
          "focus",
          "focusVisible",
          "hover",
          "hoverAndFocus",
          "hoverAndFocusVisible"
        ],
        "own": false
      }
    }
  }
}
