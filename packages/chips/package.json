{
  "name": "@ds/chips",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "Aleksei Belov <anbelov@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css",
    "**/*.scss"
  ],
  "dependencies": {
    "@ds/button": "workspace:^",
    "@ds/calendar": "workspace:^",
    "@ds/divider": "workspace:^",
    "@ds/dropdown": "workspace:^",
    "@ds/icons": "workspace:^",
    "@ds/list": "workspace:^",
    "@ds/loader": "workspace:^",
    "@ds/locale": "workspace:^",
    "@ds/materials": "workspace:^",
    "@ds/toggles": "workspace:^",
    "@ds/tooltip": "workspace:^",
    "@ds/truncate-string": "workspace:^",
    "@ds/utils": "workspace:^",
    "classnames": "catalog:",
    "fuzzy-search": "^3.2.1",
    "merge-refs": "catalog:",
    "uncontrollable": "catalog:"
  },
  "devDependencies": {
    "@types/fuzzy-search": "2.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
