{
  "name": "@ds/portal-context",
  "version": "1.0.1",
  "description": "React Context, который задаёт DOM-узел для портальных компонентов (Tooltip, Popover, Dropdown, Modal, Drawer).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/portal-context"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/portal-context",
  "license": "Apache-2.0",
  "author": "Anna Kozlova <apkozlova@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/context-kit": "workspace:^",
    "@ds/utils": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
