{
  "name": "@ds/code-editor",
  "version": "1.0.2",
  "description": "Обёртка над monaco-editor с темизацией на токенах дизайн-системы, шапкой с языком и кнопкой копирования, async/lazy-загрузкой и JSON/YAML-валидацией по schema.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/code-editor"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/code-editor",
  "license": "Apache-2.0",
  "author": "Nikita Ershov <niershov@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/loader": "workspace:^",
    "@ds/theme": "workspace:^",
    "@ds/typography": "workspace:^",
    "@ds/uikit-product-copy": "workspace:^",
    "@ds/utils": "workspace:^",
    "@monaco-editor/react": "^4.7.0",
    "classnames": "catalog:",
    "monaco-yaml": "^5.5.1"
  },
  "peerDependencies": {
    "monaco-editor": "*"
  },
  "devDependencies": {
    "monaco-editor": "0.55.1",
    "sass": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
