{
  "input": "./tokens",
  "output": "./build",
  "formats": [
    "css",
    "scss",
    "ts"
  ],
  "excludeGroups": [
    "06_language"
  ],
  "excludeTokenSets": [
    "04_brand/hrPortal",
    "04_brand/site"
  ],
  "cssModules": false,
  "scssModules": true,
  "cssClassPrefix": "sn",
  "includeFallbackValues": true,
  "validate": "warn",
  "watch": false,
  "logLevel": "debug",
  "logFile": "./logs/build.log"
}
