                  "$type": "number",
                  "$value": "{sn.density.spacing.control.wrapper.horizontal.l}"
                }
              }
            }
          }
        }
      },
      "effect": {
        "focusedFrame": {
          "opacity": {
            "$extensions": {
              "com.figma.scopes": [
                "ALL_SCOPES"
              ],
              "com.figma.hiddenFromPublishing": true
            },
            "$type": "number",
            "$value": "{sn.brand.effect.opacity.focusedFrame}"
          }
        }
      }
    }
  }
}