{
  "sn": {
    "codeEditor": {
      "language": {
        "javascript": {
          "$extensions": {
            "com.figma.scopes": [
              "TEXT_CONTENT"
            ]
          },
          "$type": "text",
          "$value": "Javascript"
        },
        "typescript": {
          "$extensions": {
            "com.figma.scopes": [
              "TEXT_CONTENT"
            ]
          },
          "$type": "text",
          "$value": "Typescript"
        },
        "json": {
          "$extensions": {
            "com.figma.scopes": [
              "TEXT_CONTENT"
            ]
          },
          "$type": "text",
          "$value": "Json"
        },
        "yaml": {
          "$extensions": {
            "com.figma.scopes": [
              "TEXT_CONTENT"
            ]
          },
          "$type": "text",
          "$value": "Yaml"
        },
        "markdown": {
          "$extensions": {
            "com.figma.scopes": [
              "TEXT_CONTENT"
            ]
          },
          "$type": "text",
          "$value": "Markdown"
        },
        "shell": {
          "$extensions": {
            "com.figma.scopes": [
              "TEXT_CONTENT"
            ]
          },
          "$type": "text",
          "$value": "Shell"
        }
      },
      "anatomy": {
        "size": {
          "rowNumbers": {
            "paddingLeft": {
              "$extensions": {
                "com.figma.hiddenFromPublishing": true
              },
              "$type": "number",
              "$value": "{sn.primitive.dimension.4}"
            },
            "paddingRight": {
              "$extensions": {
                "com.figma.hiddenFromPublishing": true
              },
              "$type": "number",
              "$value": "{sn.primitive.dimension.24}"
            },
            "paddingVertical": {
              "$extensions": {
                "com.figma.hiddenFromPublishing": true
              },
              "$type": "number",
              "$value": "{sn.primitive.dimension.4}"
            },
            "gap": {
              "$extensions": {
                "com.figma.hiddenFromPublishing": true
              },
              "$type": "number",
              "$value": "{sn.primitive.dimension.4}"
            }
          },
          "content": {
            "paddingVertical": {
              "$extensions": {
                "com.figma.hiddenFromPublishing": true
              },
              "$type": "number",
              "$value": "{sn.primitive.dimension.4}"
            }
          },
          "scroll": {
            "borderWidth": {
              "$extensions": {
                "com.figma.hiddenFromPublishing": true
              },
              "$type": "number",
              "$value": "{sn.primitive.strokeWeight.strokeRegular}"
            }
          },
          "header": {
            "paddingLeft": {
              "$extensions": {
                "com.figma.hiddenFromPublishing": true
              },
              "$type": "number",
              "$value": "{sn.primitive.dimension.12}"
            },
            "paddingRight": {
              "$extensions": {
                "com.figma.hiddenFromPublishing": true
              },
              "$type": "number",
              "$value": "{sn.primitive.dimension.2}"
            },
            "paddingVertical": {
              "$extensions": {
                "com.figma.hiddenFromPublishing": true
              },
              "$type": "number",
              "$value": "{sn.primitive.dimension.2}"
            },
            "gap": {
              "$extensions": {
                "com.figma.hiddenFromPublishing": true
              },
              "$type": "number",
              "$value": "{sn.primitive.dimension.8}"
            }
          }
        }
      }
    }
  }
}