{
  "sn": {
    "slider": {
      "anatomy": {
        "size": {
          "handle": {
            "container": {
              "square": {
                "$extensions": {
                  "com.figma.scopes": [
                    "ALL_SCOPES"
                  ],
                  "com.figma.hiddenFromPublishing": true
                },
                "$type": "number",
                "$value": "{sn.primitive.dimension.16}"
              }
            },
            "borderRadius": {
              "$extensions": {
                "com.figma.scopes": [
                  "ALL_SCOPES"
                ],
                "com.figma.hiddenFromPublishing": true
              },
              "$type": "number",
              "$value": "{sn.primitive.dimension.full}"
            },
            "borderWidth": {
              "$extensions": {
                "com.figma.scopes": [
                  "ALL_SCOPES"
                ],
                "com.figma.hiddenFromPublishing": true
              },
              "$type": "number",
              "$value": "{sn.primitive.strokeWeight.strokeRegular}"
            }
          },
          "container": {
            "trackLine": {
              "maxHeight": {
                "$extensions": {
                  "com.figma.scopes": [
                    "ALL_SCOPES"
                  ],
                  "com.figma.hiddenFromPublishing": true
                },
                "$type": "number",
                "$value": "{sn.primitive.dimension.2}"
              },
              "borderRadius": {
                "$extensions": {
                  "com.figma.scopes": [
