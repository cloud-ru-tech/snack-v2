                "com.figma.scopes": [
                  "ALL_SCOPES"
                ],
                "com.figma.hiddenFromPublishing": true
              },
              "$type": "number",
              "$value": "{sn.density.spacing.interval.s}"
            }
          },
          "scaleStep": {
