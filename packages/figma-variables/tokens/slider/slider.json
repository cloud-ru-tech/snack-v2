              "$extensions": {
                "com.figma.scopes": [
                  "ALL_SCOPES"
                ],
                "com.figma.hiddenFromPublishing": true
              },
              "$type": "number",
              "$value": "{sn.primitive.dimension.4}"
            },
            "borderRadius": {
              "$extensions": {
                "com.figma.scopes": [
                  "ALL_SCOPES"
                ],
                "com.figma.hiddenFromPublishing": true
              },
              "$type": "number",
              "$value": "{sn.density.radius.2xs}"
            },
            "width": {
              "$extensions": {
                "com.figma.scopes": [
                  "ALL_SCOPES"
                ],
                "com.figma.hiddenFromPublishing": true
