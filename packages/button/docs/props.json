      "ActionProps": {
        "kind": "alias",
        "type": "ButtonActionProps | AnchorActionProps",
        "own": true
      },
      "Size": {
        "kind": "union",
        "values": [
          "l",
          "m",
          "s"
        ],
        "own": true
      }
    }
