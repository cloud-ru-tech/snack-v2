  "ButtonGroup": {
    "displayName": "ButtonGroup",
    "propsTypeName": "ButtonGroupProps",
    "props": {
      "break": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Перенос на новую строку при нехватке места"
      },
      "centered": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Центрирование по горизонтали"
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "Дополнительный класс"
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "filled": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Заливка контейнера"
      },
      "primaryAction": {
        "type": "ActionProps",
        "required": false,
        "description": "Основное действие (filled)",
        "typeRefs": [
          "ActionProps"
        ]
      },
      "renderAction": {
        "type": "((button: ReactNode, slot: ButtonGroupActionSlot) => ReactNode)",
        "required": false,
        "description": "Обёртка каждой кнопки. Получает готовый `<Button>` и слот действия (`primary`/`secondary`/`tertiary`)\nи возвращает узел, который встанет на место кнопки. Позволяет обернуть кнопку в `Tooltip` на стороне\nпотребителя (сам `@ds/button` не зависит от `@ds/tooltip`). Чтобы не ломать раскладку `filled`, обёртка\nне должна добавлять лишний DOM-узел между группой и кнопкой (`Tooltip` — с `disableSpanWrapper`)."
      },
      "secondaryAction": {
        "type": "ActionProps",
        "required": false,
        "description": "Вторичное действие (outline), опционально",
        "typeRefs": [
          "ActionProps"
        ]
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "l",
          "m",
          "s"
        ],
        "defaultValue": "m",
        "description": "Размер кнопок",
        "typeRefs": [
          "Size"
        ]
      },
      "tertiaryAction": {
        "type": "ActionProps",
        "required": false,
        "description": "Третичное действие (simple/text-only), опционально",
        "typeRefs": [
          "ActionProps"
        ]
      },
      "vertical": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Вертикальное расположение"
      }
    },
