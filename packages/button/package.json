{
  "name": "@design-system/button",
  "version": "0.1.0",
  "private": false,
  "description": "Accessible button component for the design system",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "clean": "tsup --clean",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "peerDependencies": {
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0"
  },
  "devDependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
