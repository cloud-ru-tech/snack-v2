{
  "name": "@ds/table",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": ["dist", "src"],
  "sideEffects": ["*.css", "**/*.css"],
  "dependencies": {
    "@ds/adaptive": "workspace:^",
    "@ds/button": "workspace:^",
    "@ds/card": "workspace:^",
    "@ds/chips": "workspace:^",
    "@ds/divider": "workspace:^",
    "@ds/dropdown": "workspace:^",
    "@ds/icons": "workspace:^",
    "@ds/info-block": "workspace:^",
    "@ds/list": "workspace:^",
    "@ds/locale": "workspace:^",
    "@ds/materials": "workspace:^",
    "@ds/pagination": "workspace:^",
    "@ds/popover": "workspace:^",
    "@ds/portal-context": "workspace:^",
    "@ds/scroll": "workspace:^",
    "@ds/segment-control": "workspace:^",
    "@ds/skeleton": "workspace:^",
    "@ds/status": "workspace:^",
    "@ds/toggles": "workspace:^",
    "@ds/tooltip": "workspace:^",
    "@ds/truncate-string": "workspace:^",
    "@ds/toolbar": "workspace:^",
    "@ds/typography": "workspace:^",
    "@ds/utils": "workspace:^",
    "@cloud-ru/ft-request-payload-transform": "0.3.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tanstack/match-sorter-utils": "8.19.4",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "catalog:",
    "classnames": "catalog:",
    "lodash.debounce": "catalog:",
    "uncontrollable": "catalog:"
  },
  "publishConfig": { "access": "public" }
}
