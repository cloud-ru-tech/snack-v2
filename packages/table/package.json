{
  "name": "@ds/table",
  "version": "3.0.0",
  "license": "Apache-2.0",
  "author": "Nikita Ershov <niershov@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@cloud-ru/ft-request-payload-transform": "^0.3.0",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@ds/adaptive": "workspace:^",
    "@ds/button": "workspace:^",
    "@ds/card": "workspace:^",
    "@ds/chips": "workspace:^",
    "@ds/icons": "workspace:^",
    "@ds/info-block": "workspace:^",
    "@ds/list": "workspace:^",
    "@ds/locale": "workspace:^",
    "@ds/materials": "workspace:^",
    "@ds/pagination": "workspace:^",
    "@ds/scroll": "workspace:^",
    "@ds/skeleton": "workspace:^",
    "@ds/status": "workspace:^",
    "@ds/theme": "workspace:^",
    "@ds/toggles": "workspace:^",
    "@ds/toolbar": "workspace:^",
    "@ds/tooltip": "workspace:^",
    "@ds/truncate-string": "workspace:^",
    "@ds/utils": "workspace:^",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "catalog:",
    "@types/lodash.debounce": "catalog:",
    "classnames": "catalog:",
    "lodash.debounce": "catalog:",
    "uncontrollable": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
