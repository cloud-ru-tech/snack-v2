          "FieldLength"
        ]
      },
      "readonly": {
        "type": "boolean",
        "required": false,
        "description": "Только для чтения"
      },
      "required": {
        "type": "boolean",
        "required": false,
        "description": "Показать знак обязательности `*`"
      },
      "showHintIcon": {
        "type": "boolean",
        "required": false,
        "description": "Отображение статус-иконки у подсказки"
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "l",
          "m",
          "s"
        ],
        "defaultValue": "m",
        "description": "Размер",
