{
  "name": "@ds/modal",
  "version": "1.0.2",
  "description": "Пакет модальных окон — компоненты Modal и ModalCustom с едиными токенами ширины и режимов закрытия.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/modal"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/modal",
  "license": "Apache-2.0",
  "author": "Anna Kozlova <apkozlova@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/adaptive": "workspace:^",
    "@ds/bottom-sheet": "workspace:^",
    "@ds/loader": "workspace:^",
    "@ds/materials": "workspace:^",
    "@ds/popup-private": "workspace:^",
    "@ds/portal-context": "workspace:^",
    "@ds/scroll": "workspace:^",
    "@ds/utils": "workspace:^",
    "classnames": "catalog:",
    "react-remove-scroll": "catalog:",
    "tabbable": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
