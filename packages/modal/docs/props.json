  "ModalCustom": {
    "displayName": "ModalCustom",
    "propsTypeName": "ModalCustomProps",
    "description": "Адаптивный low-level `ModalCustom`: на `mobile` — `BottomSheetCustom`, иначе — `ModalFrame`.\nКомпозиция одна (surface-aware слоты `.Header/.Body/.Footer`). Форс — `withLayoutType`.",
    "props": {
      "children": {
