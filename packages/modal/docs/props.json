          "onClose"
        ]
      },
      "mode": {
        "type": "enum",
        "required": false,
        "values": [
          "regular",
          "aggressive",
          "forced"
        ],
        "defaultValue": "regular",
        "description": "Режим закрытия: Regular — overlay, Esc и кнопка; Aggressive — только кнопка; Forced — без кнопки и без overlay/Esc.\nblur подложки — только у Aggressive и Forced.",
        "typeRefs": [
          "ModalMode"
        ]
      },
      "children": {
        "type": "ReactNode",
        "required": true,
        "description": "Содержимое окна (композиция Header/Body/Footer)"
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс окна"
      },
      "rootClassName": {
        "type": "string",
        "required": false,
        "description": "CSS-класс корневого слоя портала"
      },
      "width": {
        "type": "enum",
        "required": false,
        "values": [
          "s",
          "m",
          "l"
        ],
        "defaultValue": "s",
        "description": "Размер окна",
        "typeRefs": [
          "ModalWidth"
        ]
      },
      "heightAuto": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Растягивать по высоте в пределах контейнера"
      },
      "container": {
        "type": "ModalContainer",
        "required": false,
        "description": "Явный DOM-контейнер для `createPortal`.\nЕсли не задан — используется `usePortalContext()` (например `PortalContextProvider` из `@design-system/portal-context`), иначе `document.body`.",
        "typeRefs": [
          "ModalContainer"
        ]
      },
      "closeOnPopstate": {
        "type": "boolean",
        "required": false,
        "description": "Закрытие при навигации по истории"
      }
    },
    "relatedTypes": {
      "ModalMode": {
        "kind": "union",
        "values": [
          "regular",
          "aggressive",
          "forced"
        ],
        "own": true
      },
