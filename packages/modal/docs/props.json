      },
      "mode": {
        "type": "enum",
        "required": false,
        "values": [
          "aggressive",
          "forced",
          "regular"
        ],
        "defaultValue": "MODE.Regular",
        "description": "Режим закрытия: Regular — overlay/Esc/кнопка; Aggressive — только кнопка; Forced — без кнопки и overlay/Esc.",
        "typeRefs": [
          "ModalMode"
        ]
      },
      "onClose": {
        "type": "() => void",
        "required": true,
        "description": "Колбэк закрытия"
      },
      "open": {
        "type": "boolean",
        "required": true,
        "description": "Управление состоянием показан/не показан"
      },
      "rootClassName": {
        "type": "string",
        "required": false,
        "description": "CSS-класс корневого слоя портала"
      },
      "safeArea": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Резервировать ли место под iOS notch / home-indicator и Android nav-bar. Реализовано паддингом\nна `.content` через `env(safe-area-inset-*)`: на устройстве без выреза/индикатора (и на desktop)\ninset = 0, поэтому никакого «лишнего» отступа не появляется; на notched-устройстве — ровно нужный.\nВерхний отступ добавляется только когда sheet раскрыт на полный вьюпорт (его верх под notch)."
      },
      "showBackdrop": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Отображение тёмной подложки за sheet'ом. При `false` фон не затемняется и click-outside\nне закрывает sheet (нет backdrop-узла, по которому ловится клик)."
      },
      "snapPoints": {
        "type": "SnapPoint[]",
        "required": false,
        "description": "Массив фиксированных позиций sheet'а от меньшей к большей. По дефолту `undefined` —\nsheet `height: auto` с одним snap'ом по высоте контента.\n\nПример: `[0.5, 1]` — sheet открывается на половину экрана, drag вверх раскрывает\nдо full-viewport; drag вниз ниже `0.5` ведёт к закрытию.\n\nКонтракт массива (движок не сортирует и не дедуплицирует — порядок и различимость на\nстороне потребителя):\n- строго по возрастанию: индекс `0` — самая компактная позиция, последний — top / expanded;\n- значения должны резолвиться в различные высоты (`['50%', 0.5]` на типичном вьюпорте дадут\n  одну высоту → дубль-индекс будет недостижим свайпом);\n- `'fit-content'` имеет смысл только как ЕДИНСТВЕННЫЙ snap (без `snapPoints`); внутри массива\n  фиксированных позиций его «контентная» высота не определена.",
        "typeRefs": [
          "SnapPoint"
        ]
      },
      "swipeEnabled": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Включает swipe-down для закрытия / swipe-up для раскрытия на следующий snap-point.\nПри `swipeEnabled=false` snap-point по-прежнему можно переключить через controlled `snapIndex` prop'ом."
      },
      "width": {
        "type": "enum",
        "required": false,
        "values": [
          "l",
          "m",
          "s"
        ],
        "description": "Размер окна",
        "typeRefs": [
          "ModalWidth"
        ]
      }
    },
    "relatedTypes": {
      "ModalContainer": {
        "kind": "alias",
        "type": "string | HTMLElement",
        "own": true
      },
      "ModalMode": {
        "kind": "union",
        "values": [
          "aggressive",
          "forced",
          "regular"
        ],
        "own": true
      },
      "ModalWidth": {
