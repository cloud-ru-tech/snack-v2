          "onScroll": {
            "type": "((event?: Event) => void) | undefined",
            "required": false,
            "description": "Колбек события скрола."
          },
          "overflow": {
            "type": "{ x?: \"hidden\" | \"visible\" | \"scroll\" | \"visible-hidden\" | \"visible-scroll\"; y?: \"hidden\" | \"visible\" | \"scroll\" | \"visible-hidden\" | \"visible-scroll\"; } | undefined",
            "required": false,
            "description": "Поведение overflow по осям. По умолчанию OverlayScrollbars выставляет `scroll`\nна обе оси; если контента по оси быть не должно — передавай `'hidden'`."
          },
          "paddingAbsolute": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Должны ли паддинги быть абсолютными"
