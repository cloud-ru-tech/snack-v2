        "values": [
          "desktop",
          "mobile"
        ]
      },
      "offset": {
        "type": "number",
        "required": false,
        "defaultValue": "0",
        "description": "Отступ поповера от его триггер-элемента (в пикселях)."
      },
      "onOpenChange": {
        "type": "((isOpen: boolean) => void)",
        "required": false,
        "description": "Колбек отображения компонента. Срабатывает при изменении состояния open."
      },
      "open": {
        "type": "boolean",
        "required": false,
        "description": "Управляет состоянием показан/не показан."
      },
      "placement": {
        "type": "enum",
        "required": false,
        "values": [
          "bottom",
          "bottom-end",
          "bottom-start",
          "left",
          "left-end",
          "left-start",
          "right",
          "right-end",
          "right-start",
          "top",
          "top-end",
          "top-start"
        ],
        "defaultValue": "top",
        "description": "Положение поповера относительно своего триггера (children)."
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "s",
          "xs"
        ],
        "defaultValue": "xs",
        "description": "Размер"
      },
      "tabIndex": {
        "type": "number",
        "required": false,
        "description": "Tab index для кнопки-триггера"
      },
      "tip": {
        "type": "ReactNode",
        "required": true,
        "description": "Содержимое тултипа (текст или разметка)"
      },
      "tooltipClassname": {
        "type": "string",
        "required": false,
        "description": "CSS-класс контейнера подсказки"
      },
      "trigger": {
        "type": "enum",
        "required": false,
        "values": [
          "click",
          "clickAndFocusVisible",
          "focus",
          "focusVisible",
          "hover",
          "hoverAndFocus",
          "hoverAndFocusVisible"
        ],
        "description": "Условие отображения поповера:\n<br/> - `click` - открывать по клику\n<br/> - `hover` - открывать по ховеру\n<br/> - `focusVisible` - открывать по focus-visible\n<br/> - `focus` - открывать по фокусу\n<br/> - `hoverAndFocusVisible` - открывать по ховеру и focus-visible\n<br/> - `hoverAndFocus` - открывать по ховеру и фокусу\n<br/> - `clickAndFocusVisible` - открывать по клику и focus-visible"
      },
      "triggerClassName": {
        "type": "string",
        "required": false,
        "description": "CSS-класс триггера"
      },
      "triggerLabel": {
        "type": "string",
        "required": false,
        "description": "Доступное имя для иконки-триггера"
      },
      "triggerRef": {
        "type": "ForwardedRef<ReferenceType | HTMLElement | null>",
        "required": false,
        "description": "Ref ссылка на триггер"
      }
    },
    "relatedTypes": {}
  },
