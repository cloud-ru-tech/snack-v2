{
  "AiShimmer": {
    "displayName": "AiShimmer",
    "propsTypeName": "AiShimmerProps",
    "props": {
      "className": {
        "type": "string",
        "required": false,
        "description": "Дополнительный класс корневого контейнера."
      },
      "data-test-id": {
        "type": "string",
        "required": false,
        "defaultValue": "ai-shimmer"
      },
      "iconMask": {
        "type": "string",
        "required": false,
        "description": "Силуэт ведущей иконки как CSS `mask-image` (обычно `url(\"data:image/svg+xml,…\")`).\nЕсли задан — перед текстом рисуется иконка, залитая тем же бегущим градиентом,\nчто и текст: блеск проходит сплошной полосой «иконка → конец строки», как будто\nиконка — часть текста. Иконка не несёт собственного цвета, она наследует\nshimmer-покрытие (приглушённая база + блик)."
      },
      "iconSize": {
        "type": "number",
        "required": false,
        "defaultValue": "16",
        "description": "Размер ведущей иконки в px (квадрат). Действует только с `iconMask`. По умолчанию `16`."
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "l",
          "m",
          "s"
        ],
        "defaultValue": "SIZE.m",
        "description": "Размер типографики (`s`, `m`, `l`), как в `@ds/typography`.\nЗадаёт `data-size` и шкалу шрифта для текста shimmer.",
        "typeRefs": [
          "AiShimmerSize"
        ]
      },
      "text": {
        "type": "string",
        "required": true,
        "description": "Текст, по которому рендерится shimmer. Поддерживает переносы строк через `\\n`."
      },
      "variant": {
        "type": "enum",
        "required": false,
        "values": [
          "body",
          "display",
          "headline",
          "label",
          "title"
        ],
        "defaultValue": "VARIANT.body",
        "description": "Вариант типографики, как в `@ds/typography`. Задаёт `data-variant` и шкалу шрифта.",
        "typeRefs": [
          "AiShimmerVariant"
        ]
      },
      "weight": {
        "type": "enum",
        "required": false,
        "values": [
          "mono",
          "regular",
          "thin"
        ],
        "defaultValue": "WEIGHT.regular",
        "description": "Начертание шрифта, как в `@ds/typography`. Задаёт `data-weight`.",
        "typeRefs": [
          "AiShimmerWeight"
        ]
      }
    },
    "relatedTypes": {
      "AiShimmerSize": {
        "kind": "union",
        "values": [
          "l",
          "m",
          "s"
        ],
        "own": true
      },
      "AiShimmerVariant": {
        "kind": "union",
        "values": [
          "body",
          "display",
          "headline",
          "label",
          "title"
        ],
        "own": true
      },
      "AiShimmerWeight": {
        "kind": "union",
        "values": [
          "mono",
          "regular",
          "thin"
        ],
        "own": true
      }
    }
  }
}
