    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/cjs",
    "dist/esm",
    "src",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "dependencies": {
    "lodash.merge": "4.6.2"
  },
  "devDependencies": {
    "@types/lodash.merge": "4.6.9"
  },
  "publishConfig": {
    "access": "public"
  }
}