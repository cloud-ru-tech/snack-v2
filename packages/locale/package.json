{
  "name": "@ds/locale",
  "version": "1.2.0",
  "description": "Рантайм локализации — строки живут в самих пакетах (defineLocale/defineMessages), провайдер несёт только язык.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/locale"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/locale",
  "license": "Apache-2.0",
  "author": "Ilya Belyavskiy <iabelyavskiy@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/context-kit": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
