{
  "name": "@design-system/locale",
  "version": "0.1.0",
  "private": false,
  "description": "Locale component for the design system",
  "types": "./dist/esm/index.d.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
