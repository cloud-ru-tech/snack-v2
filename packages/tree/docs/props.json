{
  "ExpandableTreeNode": {
    "displayName": "ExpandableTreeNode",
    "propsTypeName": null,
    "props": {
      "node": {
        "type": "TreeNodeProps",
        "required": true
      },
      "parentNode": {
        "type": "(Pick<TreeNodeProps, \"id\" | \"nested\"> & { parentNode?: ParentNode; } & { parentNode?: ParentNode; }) | undefined",
        "required": false
      },
      "tabIndexAvailable": {
        "type": "boolean",
        "required": false
      }
    },
    "relatedTypes": {}
  },
  "Tree": {
    "displayName": "Tree",
    "propsTypeName": "TreeProps",
    "props": {
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс"
      },
      "data": {
        "type": "TreeNodeProps[]",
        "required": true,
        "description": "Данные для отрисовки",
        "typeRefs": [
          "TreeNodeProps"
        ]
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "expandedNodes": {
        "type": "string[]",
        "required": false,
        "description": "Состояние для раскрытых элементов",
        "typeRefs": [
          "TreeNodeId"
        ]
      },
      "nodeActions": {
        "type": "((node: TreeNodeProps) => Item[])",
        "required": false,
        "description": "Дополнительные действия для элемента-потомка"
      },
      "onDataLoad": {
        "type": "((node: TreeNodeProps) => Promise<unknown>)",
        "required": false,
        "description": "Колбэк для асинхронной загрузки данных при раскрытии дерева"
      },
      "onExpand": {
        "type": "((expandedKeys: string[], node: TreeNodeProps) => void)",
        "required": false,
        "description": "Колбэк при раскрытии/закрытии элементов"
      },
      "onNodeClick": {
        "type": "OnNodeClick",
        "required": false,
        "description": "Обработчик клика по элементу дерева",
        "typeRefs": [
          "OnNodeClick"
        ]
      },
      "onSelect": {
        "type": "((selectedKeys: string[], node: TreeNodeProps) => void) | ((selectedKey: string, node: TreeNodeProps) => void)",
        "required": false,
        "description": "Колбэк при изменении выбраных элементов:\n<br> - При <strong>selectionMode</strong>=`Multi` - возвращает массив строк\n<br> - При <strong>selectionMode</strong>=`Single` - возвращает строку"
      },
      "parentActions": {
        "type": "((node: TreeNodeProps) => Item[])",
        "required": false,
        "description": "Дополнительные действия для элемента-родителя"
      },
      "selected": {
        "type": "string | string[]",
        "required": false,
        "description": "Состояние для выбраных элементов:\n<br> - При <strong>selectionMode</strong>=`Multi` - принимает массив строк\n<br> - При <strong>selectionMode</strong>=`Single` - принимает строку"
      },
      "selectionMode": {
        "type": "enum",
        "required": false,
        "values": [
          "multi",
          "single"
        ],
        "description": "Режим выбора элементов:\n<br> - `Single` - одиночный выбор\n<br> - `Multi` - множественный выбор\n<br> - `undefined` - без выбора"
      },
      "showIcons": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Флаг отвечающий за отображение иконок у элементов дерева"
      },
      "showLines": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Флаг отвечающий за отображение линий вложенности"
      },
      "showToggle": {
        "type": "boolean",
        "required": false
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "l",
          "m",
          "s"
        ],
        "defaultValue": "m",
        "description": "Размер строк дерева (Figma variant `size`).",
        "typeRefs": [
          "Size"
        ]
      },
      "titleMaxLines": {
        "type": "number",
        "required": false,
        "defaultValue": "1",
        "description": "Максимальное число строк заголовка узла до обрезки многоточием.\nЗначение больше 1 разрешает перенос; строка растёт по высоте."
      }
    },
    "relatedTypes": {
      "OnNodeClick": {
        "kind": "alias",
        "type": "(node: TreeNodeProps, e: MouseEvent) => void",
        "own": true
      },
      "Size": {
        "kind": "union",
        "values": [
          "l",
          "m",
          "s"
        ],
        "own": true
      },
      "TreeNodeId": {
        "kind": "alias",
        "type": "string",
        "own": true
      },
      "TreeNodeProps": {
        "kind": "alias",
        "type": "ChildTreeNode | ParentTreeNode",
        "own": true
      }
    }
  },
