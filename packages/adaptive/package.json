{
  "name": "@ds/adaptive",
  "version": "1.0.0",
  "description": "React Context текущей раскладки (layoutType) — переключает компоненты дизайн-системы между mobile и desktop поверхностями.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/adaptive"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/adaptive",
  "license": "Apache-2.0",
  "author": "Nikita Ershov <niershov@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./ssr": {
      "source": "./src/ssr.ts",
      "types": "./dist/esm/ssr.d.ts",
      "import": "./dist/esm/ssr.js",
      "require": "./dist/cjs/ssr.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": false,
  "dependencies": {
    "@ds/context-kit": "workspace:^",
    "@ds/utils": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
