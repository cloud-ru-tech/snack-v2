              "BaseItemWithoutNonGroup",
              "CommonGroupItem",
              "Item",
              "ScrollProps"
            ]
          },
          "label": {
            "type": "string | undefined",
            "required": false,
            "description": "Только mobile (`BottomSheet`): заголовок шапки."
          },
          "layoutPresets": {
            "type": "Partial<Record<LayoutType, Partial<DroplistLayoutDefaults>>> | undefined",
            "required": false,
