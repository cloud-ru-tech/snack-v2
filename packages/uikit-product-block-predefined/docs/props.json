        "own": false
      },
      "ButtonKebabProps": {
        "kind": "interface",
        "props": {
          "button": {
            "type": "Omit<ButtonProps, \"view\" | \"icon\" | \"label\"> | undefined",
            "required": false,
            "typeRefs": [
              "ButtonProps"
            ]
          },
          "list": {
            "type": "{ className?: string | undefined; open?: boolean | undefined; onOpenChange?: ((isOpen: boolean) => void) | undefined; items: Item[]; closeDroplistOnItemClick?: boolean | undefined; }",
            "required": true,
            "typeRefs": [
              "DroplistAdaptiveProps",
              "DroplistListProps",
              "DroplistMobileSlots",
