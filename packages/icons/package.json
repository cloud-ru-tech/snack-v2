{
  "name": "@ds/icons",
  "version": "0.0.0",
  "type": "module",
  "description": "Иконки React и SVG-спрайты для дизайн-системы",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "svgs"
  ],
  "sideEffects": false,
  "scripts": {
    "create-sprite": "pnpm exec ts-node scripts/createSprite.ts",
    "validate:icons": "pnpm exec ts-node scripts/validateIcons.ts",
    "sync:icons": "pnpm exec ts-node scripts/syncGeneratedIcons.ts",
    "create-export-index-file": "pnpm exec ts-node scripts/createExportIndexFile.ts",
    "build:icons": "pnpm exec ts-node scripts/buildIcons.ts",
    "fix:icons": "pnpm exec ts-node scripts/fixIcons.ts",
    "post-process-icons": "pnpm exec ts-node scripts/postProcessIconFallback.ts",
    "copy:sprite-svg": "node scripts/copySpriteSvgToDist.cjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
