{
  "name": "@design-system/icons",
  "version": "0.1.0",
  "private": false,
  "description": "Icons component for the design system",
  "types": "./dist/esm/index.d.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/cjs",
    "dist/esm",
    "src",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "create-sprite": "ts-node scripts/createSprite.ts",
    "validate:icons": "ts-node scripts/validateIcons.ts",
    "sync:icons": "ts-node scripts/syncGeneratedIcons.ts",
    "create-export-index-file": "ts-node scripts/createExportIndexFile.ts",
    "build:icons": "ts-node scripts/buildIcons.ts",
    "fix:icons": "ts-node scripts/fixIcons.ts",
    "post-process-icons": "ts-node scripts/postProcessIconFallback.ts",
    "copy:sprite-svg": "node scripts/copySpriteSvgToDist.cjs"
  },
  "devDependencies": {
    "@svgr/cli": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@types/svg-sprite": "0.0.39",
    "fast-xml-parser": "5.3.5",
    "oslllo-svg-fixer": "6.0.1",
    "svg-sprite": "2.0.4",
    "svgo": "4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
