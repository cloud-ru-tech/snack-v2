{
  "name": "@ds/fields",
  "version": "4.0.6",
  "description": "Поля ввода с единой обёрткой label/caption/hint/error и общими осями size/validationState — текст, пароль, число, ползунок, дата, время, выбор, цвет.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/fields"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/fields",
  "license": "Apache-2.0",
  "author": "Nikita Ershov <niershov@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ds/adaptive": "workspace:^",
    "@ds/bottom-sheet": "workspace:^",
    "@ds/button": "workspace:^",
    "@ds/calendar": "workspace:^",
    "@ds/color-picker": "workspace:^",
    "@ds/divider": "workspace:^",
    "@ds/dropdown": "workspace:^",
    "@ds/field-decorator": "workspace:^",
    "@ds/icons": "workspace:^",
    "@ds/input-private": "workspace:^",
    "@ds/list": "workspace:^",
    "@ds/loader": "workspace:^",
    "@ds/materials": "workspace:^",
    "@ds/scroll": "workspace:^",
    "@ds/skeleton": "workspace:^",
    "@ds/slider": "workspace:^",
    "@ds/tag": "workspace:^",
    "@ds/tooltip": "workspace:^",
    "@ds/utils": "workspace:^",
    "classnames": "catalog:",
    "merge-refs": "catalog:",
    "react-textarea-autosize": "catalog:"
  }
}
