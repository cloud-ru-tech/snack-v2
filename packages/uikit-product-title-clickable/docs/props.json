          },
          "className": {
            "type": "string | undefined",
            "required": false,
            "description": "CSS-класс"
          },
          "data-test-id": {
            "type": "string | undefined",
            "required": false
          },
          "innerRef": {
            "type": "Ref<HTMLDivElement> | undefined",
            "required": false,
            "description": "Ref на корневой DOM-элемент.\nИспользуем явный проп, чтобы не зависеть от `forwardRef` и не тащить type-assertions на экспорт."
          },
          "name": {
            "type": "string",
            "required": true,
            "description": "Имя пользователя для генерации аббревиатуры"
          },
          "shape": {
            "type": "Shape | undefined",
            "required": false,
            "values": [
              "rounded",
              "squared"
            ],
            "description": "Форма: круглая или квадратная",
            "typeRefs": [
              "Shape"
            ]
          },
          "showTwoSymbols": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Отображение двух заглавных символов имени вместо одного"
          },
          "size": {
            "type": "Size | undefined",
            "required": false,
            "values": [
              "3xl",
              "6xl",
              "9xl",
              "l",
              "m",
              "s",
              "xs"
            ],
            "description": "Размер",
            "typeRefs": [
              "Size"
            ]
          },
          "src": {
            "type": "string | undefined",
            "required": false,
            "description": "URL изображения аватара"
          },
          "status": {
            "type": "StatusAppearance | undefined",
            "required": false,
            "values": [
              "blue",
              "green",
              "neutral",
              "orange",
              "pink",
              "red",
              "violet",
              "yellow"
            ],
            "description": "Appearance дефолтного `StatusIndicator` в правом-нижнем углу. Размер\nиндикатора подбирается из `size` аватара автоматически. Полностью\nнастроить значок можно через слот `badge`, который перекрывает `status`.",
            "typeRefs": [
              "StatusAppearance"
            ]
          }
        },
        "own": false
      },
      "PolymorphicRef": {
        "kind": "alias",
        "type": "ComponentPropsWithRef<T>[\"ref\"]",
        "own": true
      },
      "Shape": {
        "kind": "union",
        "values": [
          "rounded",
          "squared"
        ],
        "own": false
      },
      "Size": {
        "kind": "union",
        "values": [
          "3xl",
          "6xl",
          "9xl",
          "l",
          "m",
          "s",
          "xs"
        ],
        "own": false
      },
      "StatusAppearance": {
        "kind": "union",
        "values": [
          "blue",
          "green",
          "neutral",
          "orange",
          "pink",
          "red",
          "violet",
          "yellow"
        ],
        "own": false
      }
    }
