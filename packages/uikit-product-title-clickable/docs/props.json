          "AvatarProps"
        ]
      },
      "before": {
        "type": "ReactNode",
        "required": false,
        "description": "Слот слева от заголовка. Произвольная нода либо предзаготовленные пресеты\n`<TitleClickableIcon icon={...} />` / `<TitleClickableAvatar {...} />`.\nСоответствует Figma-слоту `+ slotTitle` (`simpleTitle` / `userTitle`)."
      },
      "children": {
        "type": "ReactNode",
        "required": false,
        "description": "Кастомное содержимое вместо title/before"
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс"
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "fullWidth": {
        "type": "boolean",
        "required": false,
        "description": "Занимает ли всю ширину"
      },
      "icon": {
        "type": "ReactNode",
        "required": false,
