{
  "name": "@ds/uikit-product-widget",
  "version": "1.0.6",
  "description": "Карточка продуктового виджета с кликабельным заголовком, SegmentControl, действиями и состояниями loading/error.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/uikit-product-widget"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/uikit-product-widget",
  "license": "Apache-2.0",
  "author": "vdizryadnov <vdizryadnov@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/adaptive": "workspace:^",
    "@ds/button": "workspace:^",
    "@ds/icons": "workspace:^",
    "@ds/info-block": "workspace:^",
    "@ds/list": "workspace:^",
    "@ds/locale": "workspace:^",
    "@ds/materials": "workspace:^",
    "@ds/segment-control": "workspace:^",
    "@ds/skeleton": "workspace:^",
    "@ds/tooltip": "workspace:^",
    "@ds/uikit-product-title-clickable": "workspace:^",
    "@ds/utils": "workspace:^",
    "classnames": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
