{
  "name": "@ds/ai-suggestion-panel",
  "version": "1.0.0",
  "description": "Полоса вопросов-подсказок к ассистенту: кнопка Giga, вопросы, «+N» со скрытыми вопросами и кнопка закрытия.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/ai-suggestion-panel"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/ai-suggestion-panel",
  "license": "Apache-2.0",
  "author": "Nikita Ershov <niershov@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/adaptive": "workspace:^",
    "@ds/ai-button-giga": "workspace:^",
    "@ds/button": "workspace:^",
    "@ds/icons": "workspace:^",
    "@ds/link": "workspace:^",
    "@ds/list": "workspace:^",
    "@ds/loader": "workspace:^",
    "@ds/locale": "workspace:^",
    "@ds/tooltip": "workspace:^",
    "@ds/typography": "workspace:^",
    "@ds/utils": "workspace:^",
    "classnames": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
