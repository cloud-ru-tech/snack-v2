  "ToggleGroup": {
    "displayName": "ToggleGroup",
    "propsTypeName": "ToggleGroupProps",
    "description": "ToggleGroup — провайдер выбора + grid-раскладка карточек `ToggleCard`.\nСостояние (controlled/uncontrolled, single/multiple) держит `@ds/toggles::ToggleGroup`;\nобёртка добавляет ориентацию, gap и breakpoint горизонтальной раскладки.",
    "props": {
      "breakpoint": {
        "type": "number",
        "required": false,
        "description": "Минимальная ширина карточки для горизонтальной раскладки (px)"
      },
      "children": {
        "type": "ReactNode",
        "required": false,
        "description": "Дочерние карточки `ToggleCard`"
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс корневого элемента"
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "defaultValue": {
        "type": "string | string[]",
        "required": false,
        "description": "Начальное состояние"
      },
      "gap": {
        "type": "enum",
        "required": false,
        "values": [
          "l",
          "m",
          "s"
        ],
        "description": "Расстояние между карточками"
      },
      "onChange": {
        "type": "((value: string) => void) | ((value: string[]) => void) | undefined",
        "required": false,
        "description": "Controlled обработчик измения состояния"
      },
      "orientation": {
        "type": "enum",
        "required": false,
        "values": [
          "horizontal",
          "vertical"
        ],
        "description": "Направление раскладки"
      },
      "selectionMode": {
        "type": "enum",
        "required": false,
        "values": [
          "multiple",
          "single"
        ],
        "description": "Режим выбора"
      },
      "value": {
        "type": "string | string[]",
        "required": false,
        "description": "Controlled состояние"
      }
    },
    "relatedTypes": {}
  }
