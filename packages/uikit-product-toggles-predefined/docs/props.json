{
  "ToggleCard": {
    "displayName": "ToggleCard",
    "propsTypeName": "ToggleCardProps",
    "description": "ToggleCard — кликабельная карточка выбора. Работает внутри `ToggleGroup`:\nклик / Enter / Space по карточке переключает её значение в контексте группы.\nВизуальный chrome (acrylic-фон, state-layer выбора, outline, focus-ring)\nприходит из `@ds/card`; карточка добавляет раскладку контента и клавиатуру.",
    "props": {
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс корневого элемента"
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "description": {
        "type": "string",
        "required": false,
        "description": "Основной текст под заголовком"
      },
      "disabled": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Заблокированное состояние: интерактив отключён"
      },
      "emblem": {
        "type": "Emblem",
        "required": false,
        "description": "Ведущая эмблема. Передаются только параметры — сам `IconPredefined`\nвстроен в компонент; `size` эмблемы выводится из `size` карточки.",
        "typeRefs": [
          "Emblem",
          "EmblemIcon",
          "EmblemPicture"
        ]
      },
      "promoBadge": {
        "type": "string | Pick<PromoTagProps, \"appearance\" | \"label\">",
        "required": false,
        "description": "Промо-бейдж в правом верхнем углу карточки",
        "typeRefs": [
          "PromoTagOwnProps",
          "PromoTagProps"
        ]
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "l",
          "m",
          "s"
        ],
        "defaultValue": "m",
        "description": "Размер карточки — масштабирует padding, gap, типографику и `radius` контейнера `@ds/card`",
        "typeRefs": [
          "Size"
        ]
      },
      "title": {
        "type": "string",
        "required": true,
        "description": "Заголовок карточки"
      },
      "truncate": {
        "type": "{ title?: number; description?: number; } | undefined",
        "required": false,
        "defaultValue": "'{ title: 1; description: 2; }'",
        "description": "Максимальное число строк до обрезки."
      },
      "value": {
        "type": "string",
        "required": true,
        "description": "Значение карточки в контексте `ToggleGroup`"
      }
    },
    "relatedTypes": {
      "Appearance": {
        "kind": "union",
        "values": [
          "blue",
          "green",
          "neutral",
          "orange",
          "pink",
          "primary",
          "red",
          "violet",
          "yellow"
        ],
        "own": false
      },
      "Emblem": {
        "kind": "alias",
        "type": "EmblemPicture | EmblemIcon",
        "own": true
      },
      "EmblemIcon": {
        "kind": "interface",
        "props": {
          "appearance": {
            "type": "Appearance | undefined",
            "required": false,
            "values": [
              "blue",
              "green",
              "neutral",
              "orange",
              "pink",
              "primary",
              "red",
              "violet",
              "yellow"
            ],
            "description": "Внешний вид",
            "typeRefs": [
              "Appearance"
            ]
          },
          "decor": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Наличие цветной подложки"
          },
          "icon": {
            "type": "((props: { size?: number; className?: string; }, deprecatedLegacyContext?: any) => ReactNode) | (new (props: { size?: number; className?: string; }, deprecatedLegacyContext?: any) => Component<any, any>)",
            "required": true,
            "description": "JSX иконки"
          },
          "shape": {
            "type": "\"rounded\" | \"squared\" | undefined",
            "required": false,
            "values": [
              "rounded",
              "squared"
            ],
            "description": "Форма: круглая или квадратная"
          }
        },
        "own": true
      },
      "EmblemPicture": {
        "kind": "interface",
        "props": {
          "alt": {
            "type": "string",
            "required": true,
            "description": "Альтернативный текст картинки"
          },
          "src": {
            "type": "string",
            "required": true,
            "description": "URL картинки-эмблемы"
          }
        },
        "own": true
      },
      "PolymorphicRef": {
