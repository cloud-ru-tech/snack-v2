          },
          "appearance": {
            "type": "Appearance | undefined",
            "required": false,
            "values": [
              "blue",
              "green",
              "neutral",
              "orange",
              "pink",
              "primary",
              "red",
              "violet",
              "yellow"
            ],
            "description": "Внешний вид",
            "typeRefs": [
              "Appearance"
            ]
          },
          "as": {
            "type": "T | undefined",
            "required": false,
            "description": "Элемент или компонент для рендера: 'button' | 'a' | Link из react-router-dom и т.п.",
            "typeRefs": [
              "T"
            ]
          },
          "beforeContent": {
            "type": "string | number | boolean | ReactElement<any, string | JSXElementConstructor<any>> | Iterable<ReactNode> | ReactPortal | null | undefined",
            "required": false,
            "description": "Контент перед текстом"
          },
          "className": {
            "type": "string | undefined",
            "required": false,
            "description": "CSS-класс"
          },
          "data-test-id": {
            "type": "string | undefined",
            "required": false
          },
          "innerRef": {
            "type": "PolymorphicRef<T> | undefined",
            "required": false,
            "description": "Ref на реальный DOM-элемент/инстанс, который рендерится через `as`.\nЯвный проп вместо forwardRef — как в Button и AiToolBadge.",
            "typeRefs": [
              "PolymorphicRef",
              "T"
            ]
          },
          "label": {
            "type": "string | undefined",
            "required": false,
            "description": "Текст компонента"
          },
          "onClick": {
            "type": "MouseEventHandler<HTMLElement> | undefined",
            "required": false,
            "description": "Колбэк для обработки клика на тег"
          },
          "role": {
            "type": "RoleAppearance | undefined",
            "required": false,
            "values": [
