  "SiteVideo": {
    "displayName": "SiteVideo",
    "propsTypeName": "SiteVideoProps",
    "description": "Воспроизводит MP4 и HLS со своей панелью управления, а YouTube и Rutube — во встроенном плеере провайдера.",
    "props": {
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс обёртки плеера."
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "onError": {
        "type": "(() => void)",
        "required": false,
        "description": "Вызывается при ошибке загрузки или воспроизведения видео."
      },
      "onPlay": {
        "type": "(() => void)",
        "required": false,
        "description": "Вызывается один раз при начале воспроизведения. При смене src может вызваться снова."
      },
      "video": {
        "type": "ReactNode | VideoPlayerProps",
        "required": true,
        "description": "Параметры видео (src, обложка, управление) или React-элемент собственного плеера.",
        "typeRefs": [
          "VideoPlayerProps"
        ]
      }
    },
    "relatedTypes": {
      "VideoPlayerProps": {
        "kind": "interface",
        "props": {
          "autoPlay": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Автоматический запуск без звука, если разрешён браузером."
          },
          "controls": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Показать управление и кнопку Play. По умолчанию `true`."
          },
          "loop": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Повторять видео."
          },
          "muted": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Отключить звук."
          },
          "poster": {
            "type": "string | undefined",
            "required": false,
            "description": "Обложка перед началом воспроизведения."
          },
          "src": {
            "type": "string",
            "required": true,
            "description": "URL файла MP4, плейлиста HLS, ролика YouTube или Rutube."
          }
        },
        "own": true
      }
    }
  },
