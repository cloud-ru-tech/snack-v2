{
  "CAROUSEL_LAYOUT_PRESETS": {
    "displayName": "CAROUSEL_LAYOUT_PRESETS",
    "propsTypeName": null,
    "description": "DS-пресет адаптива `Carousel`: на mobile стрелки скрыты, страницы листаются свайпом и пагинацией.",
    "props": {},
    "relatedTypes": {}
  },
  "Carousel": {
    "displayName": "Carousel",
    "propsTypeName": "CarouselProps",
    "props": {
      "arrows": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Использовать стрелки для переключения страниц.\nНа mobile по умолчанию скрыты (`CAROUSEL_LAYOUT_PRESETS`), вернуть — через `layoutPresets`."
      },
      "autoSwipe": {
        "type": "number",
        "required": false,
        "description": "Автоматическое переключение слайдов в секундах"
      },
      "children": {
        "type": "ReactElement<any, string | JSXElementConstructor<any>>[]",
        "required": true,
        "description": "Массив айтемов"
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS - класснейм"
      },
      "controlsVisibility": {
        "type": "enum",
        "required": false,
        "values": [
          "always",
          "hover"
        ],
        "defaultValue": "hover",
        "description": "Управление видимостью стрелок: 'hover' — по ховеру, 'always' — всегда",
        "typeRefs": [
          "ControlsVisibility"
        ]
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "gap": {
        "type": "string",
        "required": false,
        "defaultValue": "var(--dimension-2m)",
        "description": "Расстояние между айтемами"
      },
      "infiniteScroll": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Цикличная прокрутка"
      },
      "layoutPresets": {
        "type": "Partial<Record<LayoutType, Partial<CarouselLayoutDefaults>>>",
        "required": false,
        "description": "Override mobile-дефолтов адаптива для этого инстанса (deep-merge поверх `CAROUSEL_LAYOUT_PRESETS`).\nEscape-hatch: обычно не нужен — DS-пресет применяется автоматически по `AdaptiveProvider`.",
        "typeRefs": [
          "CarouselLayoutDefaults",
          "LayoutPresets"
        ]
      },
      "pagination": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Использовать пагинацию для переключения страниц"
      },
      "scrollBy": {
        "type": "number",
        "required": false,
        "defaultValue": "Math.trunc(show)",
        "description": "Сдвиг айтемов при смене 1 страницы"
      },
      "showItems": {
        "type": "number",
        "required": false,
        "defaultValue": "1",
        "description": "Кол-во отображаемых единовременно айтемов"
      },
      "state": {
        "type": "{ page: number; onChange(page: number): void; }",
        "required": false,
        "description": "Управление состоянием извне"
      },
      "swipe": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Переключение страниц свайпом"
      },
      "swipeActivateLength": {
        "type": "number",
        "required": false,
        "defaultValue": "48",
        "description": "Минимальная длина в px для активации свайпа"
      },
      "transition": {
        "type": "number",
        "required": false,
        "defaultValue": "0.4",
        "description": "Время переключения 1 страницы (в s)"
      }
    },
    "relatedTypes": {
      "CarouselLayoutDefaults": {
        "kind": "interface",
        "props": {
          "arrows": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Использовать стрелки для переключения страниц.\nНа mobile по умолчанию скрыты (`CAROUSEL_LAYOUT_PRESETS`), вернуть — через `layoutPresets`."
          }
        },
        "own": true
      },
      "ControlsVisibility": {
        "kind": "union",
        "values": [
          "always",
          "hover"
        ],
        "own": true
      },
      "LayoutPresets": {
        "kind": "interface",
        "props": {
          "desktop": {
            "type": "any",
            "required": false
          },
          "desktopSmall": {
            "type": "any",
            "required": false
          },
          "mobile": {
            "type": "any",
            "required": false
          },
          "tablet": {
            "type": "any",
            "required": false
          }
        },
        "own": false
      }
    }
  },
  "Control": {
    "displayName": "Control",
    "propsTypeName": null,
    "props": {
      "className": {
        "type": "string",
        "required": false
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "direction": {
        "type": "enum",
        "required": true,
        "values": [
          "next",
          "prev"
        ]
      },
      "onClick": {
        "type": "(() => void)",
        "required": false
      }
    },
    "relatedTypes": {}
  },
  "ItemProvider": {
    "displayName": "ItemProvider",
    "propsTypeName": null,
    "props": {
      "gap": {
        "type": "string",
        "required": false
      },
      "page": {
        "type": "number",
        "required": true
      },
      "scrollBy": {
        "type": "number",
        "required": true
      },
      "showItems": {
        "type": "number",
        "required": true
      },
      "slideCallback": {
        "type": "(direction: number) => void",
        "required": true
      },
      "swipe": {
        "type": "boolean",
        "required": true
      },
      "swipeActivateLength": {
        "type": "number",
        "required": true
      },
      "transition": {
        "type": "number",
        "required": true
      }
    },
    "relatedTypes": {}
  }
}
