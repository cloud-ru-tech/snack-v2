{
  "Carousel": {
    "displayName": "Carousel",
    "props": {
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS - класснейм"
      },
      "children": {
        "type": "ReactElement<any, string | JSXElementConstructor<any>>[]",
        "required": true,
        "description": "Массив айтемов"
      },
      "showItems": {
        "type": "number",
        "required": false,
        "defaultValue": "1",
        "description": "Кол-во отображаемых единовременно айтемов"
      },
      "scrollBy": {
        "type": "number",
        "required": false,
        "defaultValue": "Math.trunc(show)",
        "description": "Сдвиг айтемов при смене 1 страницы"
      },
      "transition": {
        "type": "number",
        "required": false,
        "defaultValue": "0.4",
        "description": "Время переключения 1 страницы (в s)"
      },
      "swipe": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Переключение страниц свайпом"
      },
      "autoSwipe": {
        "type": "number",
        "required": false,
        "description": "Автоматическое переключение слайдов в секундах"
      },
      "swipeActivateLength": {
        "type": "number",
        "required": false,
        "defaultValue": "48",
        "description": "Минимальная длина в px для активации свайпа"
      },
      "arrows": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Использовать стрелки для переключения страниц"
      },
      "pagination": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Использовать пагинацию для переключения страниц"
      },
      "gap": {
        "type": "string",
        "required": false,
        "defaultValue": "var(--dimension-2m)",
        "description": "Расстояние между айтемами"
      },
      "state": {
        "type": "{ page: number; onChange(page: number): void; }",
        "required": false,
        "description": "Управление состоянием извне"
      },
      "infiniteScroll": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Цикличная прокрутка"
      },
      "controlsVisibility": {
        "type": "enum",
        "required": false,
        "values": [
          "hover",
          "always"
        ],
        "defaultValue": "hover",
        "description": "Управление видимостью стрелок: 'hover' — по ховеру, 'always' — всегда"
      }
    }
  },
  "ItemProvider": {
    "displayName": "ItemProvider",
    "props": {
      "showItems": {
        "type": "number",
        "required": true
      },
      "scrollBy": {
        "type": "number",
        "required": true
      },
      "slideCallback": {
        "type": "(direction: number) => void",
        "required": true
      },
      "transition": {
        "type": "number",
        "required": true
      },
      "swipe": {
        "type": "boolean",
        "required": true
      },
      "swipeActivateLength": {
        "type": "number",
        "required": true
      },
      "page": {
        "type": "number",
        "required": true
      },
      "gap": {
        "type": "string",
        "required": false
      }
    }
  },
  "Control": {
    "displayName": "Control",
    "props": {
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "onClick": {
        "type": "(() => void)",
        "required": false
      },
      "direction": {
        "type": "enum",
        "required": true,
        "values": [
          "prev",
          "next"
        ]
      },
      "className": {
        "type": "string",
        "required": false
      }
    }
  }
}
