{
  "Scroll": {
    "displayName": "Scroll",
    "propsTypeName": "ScrollProps",
    "description": "Scroll — контейнер с кастомными скроллбарами (OverlayScrollbars).\nСтили из",
    "props": {
      "autoscrollTo": {
        "type": "enum",
        "required": false,
        "values": [
          "bottom",
          "right"
        ],
        "description": "Включает автоскрол при маунте и изменении размера контента:\n<br /> - `bottom` - автоскрол вниз,\n<br /> - `right` - автоскрол вправо,",
        "typeRefs": [
          "AutoscrollTo"
        ]
      },
      "barHideStrategy": {
        "type": "enum",
        "required": false,
        "values": [
          "leave",
          "move",
          "never",
          "scroll"
        ],
        "defaultValue": "leave",
        "description": "Управление скрытием скролл баров:\n<br /> - `Never` - показывать всегда\n<br /> - `Leave` - скрывать когда курсор покидает компонент\n<br /> - `Scroll` - показывать только когда происходит скроллинг\n<br /> - `Move` - показывать при движении курсора над компонентом",
        "typeRefs": [
          "BarHideStrategy"
        ]
      },
      "className": {
        "type": "string",
        "required": false
      },
      "clickScrolling": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Скролить ли по клику в скроллбар."
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "onInitialized": {
        "type": "(() => void)",
        "required": false,
        "description": "Коллбэк вызывающийся на инициализацию скролла",
        "typeRefs": [
          "onInitialized"
        ]
      },
      "onScroll": {
        "type": "((event?: Event) => void)",
        "required": false,
        "description": "Колбек события скрола."
      },
      "paddingAbsolute": {
        "type": "boolean",
        "required": false,
        "description": "Должны ли паддинги быть абсолютными"
      },
      "resize": {
        "type": "enum",
        "required": false,
        "values": [
          "both",
          "horizontal",
          "none",
          "vertical"
        ],
        "defaultValue": "none",
        "description": "Настройка возможности регулировать Scroll-контейнер:\n<br /> - `None` - нельзя изменять размер\n<br /> - `Horizontal` - можно изменять размер только по горизонтали\n<br /> - `Vertical` - можно изменять размер только по вертикали\n<br /> - `Both` - можно изменять размер в обеих координатах",
        "typeRefs": [
          "Resize"
        ]
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "m",
          "s"
        ],
        "defaultValue": "m",
        "description": "Размер скролбаров",
        "typeRefs": [
          "Size"
        ]
      },
      "untouchableScrollbars": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Отключает возможность взаимодействовать со скролбарами мышью."
      }
    },
    "relatedTypes": {
      "AutoscrollTo": {
        "kind": "union",
        "values": [
          "bottom",
          "right"
        ],
        "own": true
      },
      "BarHideStrategy": {
        "kind": "union",
        "values": [
          "leave",
          "move",
          "never",
          "scroll"
        ],
        "own": true
      },
      "Resize": {
        "kind": "union",
        "values": [
          "both",
          "horizontal",
          "none",
          "vertical"
        ],
        "own": true
      },
      "Size": {
        "kind": "union",
        "values": [
          "m",
          "s"
        ],
        "own": true
      }
    }
  },
  "setNonce": {
    "displayName": "setNonce",
    "propsTypeName": null,
    "description": "Установить nonce атрибут для инлайн стилей.",
    "props": {},
    "relatedTypes": {}
  }
}
