{
  "name": "@ds/scroll",
  "version": "1.0.1",
  "description": "Контейнер с кастомными скроллбарами, размерами s/m, стратегиями скрытия, автоскролом и опциональным ресайзом.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/scroll"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/scroll",
  "license": "Apache-2.0",
  "author": "Anna Kozlova <apkozlova@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/materials": "workspace:^",
    "@ds/utils": "workspace:^",
    "classnames": "catalog:",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
