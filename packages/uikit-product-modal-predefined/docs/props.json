      },
      "titleTooltip": {
        "type": "ReactNode",
        "required": false,
        "description": "Подсказка рядом с заголовком"
      }
    },
    "relatedTypes": {
      "ConfirmTextVariant": {
        "kind": "union",
        "values": [
          "name",
          "text"
        ],
        "own": true
      },
      "ModalMode": {
        "kind": "union",
        "values": [
          "aggressive",
          "forced",
          "regular"
