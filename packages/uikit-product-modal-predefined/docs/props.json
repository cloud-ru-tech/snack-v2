      },
      "onDelete": {
        "type": "(onClose: () => void) => void",
        "required": true,
        "description": "Колбэк подтверждения удаления"
      },
      "open": {
        "type": "boolean",
        "required": true,
        "description": "Управление состоянием показан/не показан"
      },
      "subtitle": {
        "type": "ReactNode",
