{
  "name": "@ds/uikit-product-modal-predefined",
  "version": "1.0.17",
  "description": "Product preset-компоненты для delete, recall и release notes сценариев на базе Modal и BottomSheet.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/uikit-product-modal-predefined"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/uikit-product-modal-predefined",
  "license": "Apache-2.0",
  "author": "Robert Kuzhin <rikuzhin@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/adaptive": "workspace:^",
    "@ds/bottom-sheet": "workspace:^",
    "@ds/button": "workspace:^",
    "@ds/carousel": "workspace:^",
    "@ds/fields": "workspace:^",
    "@ds/icons": "workspace:^",
    "@ds/info-block": "workspace:^",
    "@ds/locale": "workspace:^",
    "@ds/markdown": "workspace:^",
    "@ds/modal": "workspace:^",
    "@ds/pagination": "workspace:^",
    "@ds/scroll": "workspace:^",
    "@ds/skeleton": "workspace:^",
    "@ds/tooltip": "workspace:^",
    "@ds/truncate-string": "workspace:^",
    "@ds/typography": "workspace:^",
    "@ds/uikit-product-copy": "workspace:^",
    "@ds/utils": "workspace:^",
    "classnames": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
