{
  "HotSpot": {
    "displayName": "HotSpot",
    "propsTypeName": "HotSpotProps",
    "props": {
      "appearance": {
        "type": "enum",
        "required": false,
        "values": [
          "blue",
          "green",
          "orange",
          "pink",
          "primary",
          "red",
          "violet",
          "yellow"
        ],
        "defaultValue": "primary",
        "description": "Внешний вид",
        "typeRefs": [
          "Appearance"
        ]
      },
      "children": {
        "type": "ReactNode",
        "required": false,
        "description": "Вложенный контент"
      },
      "className": {
        "type": "string",
        "required": false
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "dotRender": {
        "type": "((dot: ReactNode) => ReactNode)",
        "required": false,
        "description": "Рендер функция для dot"
      },
      "duration": {
        "type": "string",
        "required": false,
        "defaultValue": "2s",
        "description": "Время анимации пульсации"
      },
      "enabled": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Управление состоянием отрисовки"
      },
      "offsetX": {
        "type": "string | number",
        "required": false,
        "defaultValue": "0",
        "description": "Смещение dot по оси X (ось направлена вправо)"
      },
      "offsetY": {
        "type": "string | number",
        "required": false,
        "defaultValue": "0",
        "description": "Смещение dot по оси Y (ось направлена вниз)"
      },
      "placement": {
        "type": "enum",
        "required": false,
        "values": [
          "center",
          "center-bottom",
          "center-top",
          "left",
          "left-bottom",
          "left-top",
          "right",
          "right-bottom",
          "right-top"
        ],
        "defaultValue": "right-top",
        "description": "Положение относительно children.",
        "typeRefs": [
          "Placement"
        ]
      },
      "pulse": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Анимация пульсации"
      },
      "wrapperClassName": {
        "type": "string",
        "required": false
      }
    },
    "relatedTypes": {
      "Appearance": {
        "kind": "union",
        "values": [
          "blue",
          "green",
          "orange",
          "pink",
          "primary",
          "red",
          "violet",
          "yellow"
        ],
        "own": true
      },
      "Placement": {
        "kind": "union",
        "values": [
          "center",
          "center-bottom",
          "center-top",
          "left",
          "left-bottom",
          "left-top",
          "right",
          "right-bottom",
          "right-top"
        ],
        "own": true
      }
    }
  }
}
