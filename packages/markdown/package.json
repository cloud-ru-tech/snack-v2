{
  "name": "@ds/markdown",
  "version": "1.0.11",
  "description": "Просмотр и редактирование markdown — рендер GFM и WYSIWYG-редактор на TipTap.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/markdown"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/markdown",
  "license": "Apache-2.0",
  "author": "Nikita Ershov <niershov@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ds/button": "workspace:^",
    "@ds/divider": "workspace:^",
    "@ds/fields": "workspace:^",
    "@ds/icons": "workspace:^",
    "@ds/list": "workspace:^",
    "@ds/locale": "workspace:^",
    "@ds/materials": "workspace:^",
    "@ds/modal": "workspace:^",
    "@ds/portal-context": "workspace:^",
    "@ds/scroll": "workspace:^",
    "@ds/toggles": "workspace:^",
    "@ds/tooltip": "workspace:^",
    "@ds/typography": "workspace:^",
    "@ds/utils": "workspace:^",
    "@tiptap/core": "^3.29.1",
    "@tiptap/extension-code-block-lowlight": "^3.29.1",
    "@tiptap/extension-image": "^3.29.1",
    "@tiptap/extension-placeholder": "^3.29.1",
    "@tiptap/extension-table": "^3.29.1",
    "@tiptap/extension-table-cell": "^3.29.1",
    "@tiptap/extension-table-header": "^3.29.1",
    "@tiptap/extension-table-row": "^3.29.1",
    "@tiptap/markdown": "^3.29.1",
    "@tiptap/pm": "^3.29.1",
    "@tiptap/react": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "classnames": "catalog:",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "catalog:",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "catalog:",
    "unified": "catalog:"
  },
  "devDependencies": {
    "sass": "catalog:",
    "typescript": "catalog:"
  }
}
