  "Markdown": {
    "displayName": "Markdown",
    "propsTypeName": "MarkdownProps",
    "props": {
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс корневого элемента."
      },
      "components": {
        "type": "any",
        "required": false,
        "description": "Override рендера элементов"
      },
      "data-test-id": {
        "type": "string",
        "required": false,
        "defaultValue": "markdown"
      },
      "onCodeCopyClick": {
        "type": "((code: string) => void)",
        "required": false,
        "description": "Колбэк кнопки Copy на code-блоке"
      },
      "rehypePlugins": {
        "type": "PluggableList",
        "required": false,
        "description": "Доп. rehype-плагины"
      },
      "remarkPlugins": {
        "type": "PluggableList",
        "required": false,
        "description": "Доп. remark-плагины"
      },
      "skipHtml": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "По умолчанию true — сырой HTML вырезается"
      },
      "value": {
        "type": "string",
        "required": true,
        "description": "Markdown-исходник"
      }
    },
    "relatedTypes": {}
  },
  "MarkdownEditor": {
    "displayName": "MarkdownEditor",
    "propsTypeName": "MarkdownEditorProps",
    "props": {
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс корневого элемента."
      },
      "data-test-id": {
        "type": "string",
        "required": false,
        "defaultValue": "markdown-editor"
      },
      "defaultPreview": {
        "type": "boolean",
        "required": false,
        "description": "Uncontrolled"
      },
      "defaultValue": {
        "type": "string",
        "required": false,
        "description": "Uncontrolled"
      },
      "hideHeader": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Скрыть шапку с тоглом Preview и подписью"
      },
      "label": {
        "type": "string | false",
        "required": false,
        "defaultValue": "Markdown field",
        "description": "Подпись в шапке справа. По умолчанию — `Markdown field`. `false` — без подписи."
      },
      "onChange": {
        "type": "((markdown: string) => void)",
        "required": false,
        "description": "Колбэк изменения markdown. Вызывается с дебаунсом `ON_CHANGE_DEBOUNCE_MS` после остановки ввода."
      },
      "onPreviewChange": {
        "type": "((preview: boolean) => void)",
        "required": false,
        "description": "Колбэк переключения Preview-тогла в шапке"
      },
      "placeholder": {
        "type": "string",
        "required": false,
        "description": "Placeholder пустого редактора."
      },
      "preview": {
        "type": "boolean",
        "required": false,
        "description": "Controlled preview-режим: показывает форматированный WYSIWYG с активным тулбаром. Выключен — редактирование «сырого» markdown-текста в textarea"
      },
      "previewLabel": {
        "type": "string",
        "required": false,
        "defaultValue": "Preview",
        "description": "Текст тогла Preview в шапке. По умолчанию `Preview`."
      },
      "resizable": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Может ли пользователь менять размеры поля перетаскиванием уголка. По умолчанию `true`."
      },
      "spellCheck": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Нативная проверка орфографии (`spellcheck`). По умолчанию `true`."
      },
      "toolbar": {
        "type": "false | ToolbarItemId[]",
        "required": false,
        "description": "Какие кнопки тулбара показать. false — без тулбара",
        "typeRefs": [
          "ToolbarItemId"
        ]
      },
      "value": {
        "type": "string",
        "required": false,
        "description": "Controlled markdown"
      }
    },
    "relatedTypes": {
      "ToolbarItemId": {
        "kind": "union",
        "values": [
          "block-code",
          "block-quote",
          "bold",
          "bullet-list",
          "heading",
          "image",
          "inline-code",
          "italic",
          "link",
          "ordered-list",
          "strikethrough",
          "table"
        ],
        "own": true
      }
    }
  },
