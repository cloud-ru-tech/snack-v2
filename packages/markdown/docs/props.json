  "Toolbar": {
    "displayName": "Toolbar",
    "propsTypeName": null,
    "props": {
      "api": {
        "type": "ToolbarApi",
        "required": true,
        "description": "Бэкенд команд: WYSIWYG (TipTap) в preview-режиме либо markdown-исходник (textarea) в raw-режиме."
      },
      "items": {
        "type": "ToolbarItemId[]",
        "required": true
      }
    },
    "relatedTypes": {}
  }
