  "ToastSystemEventCloseAll": {
    "displayName": "ToastSystemEventCloseAll",
    "propsTypeName": null,
    "description": "Full-width label-кнопка в нижней панели стека тостов (Figma 7902:280472 —\n`toastSystemEventCloseAll`). Используется для actions `Cancel all` и\n`Expand/Collapse stack`. Hover/pressed состояния реализованы через\nstate-layer overlay (Material).",
    "props": {},
    "relatedTypes": {}
  },
  "ToastSystemEventProgress": {
    "displayName": "ToastSystemEventProgress",
    "propsTypeName": null,
    "description": "Прогресс-полоса нижней части `ToastSystemEvent`. По Figma —\nfiller `<appearance>-accent` без track (выводится поверх тёмной подложки).\n\n`scaleX` берётся из `useToastProgress` — она тикает в rAF и подписана на\nфактический `elapsedMs/autoClose` менеджера, поэтому полоска корректно\nпаузится на hover/touch и не «перезапускается» при раскрытии стопки\n(collapsed↔expanded), как это делала старая CSS-keyframe анимация.",
    "props": {
      "appearance": {
        "type": "enum",
        "required": true,
        "values": [
          "error",
          "errorCritical",
          "neutral",
          "success",
          "warning"
        ],
        "description": "Цветовая схема — берётся из appearance тоста."
      },
      "durationMs": {
        "type": "number",
        "required": false,
        "description": "Зарезервирован. Раньше задавал `animation-duration` CSS-кейфрейма; сейчас\nscaleX полоски считается из реального состояния авто-close таймера через\n`useToastProgress`, и этот параметр в рантайме не используется. Оставлен\nв API на случай standalone-рендера карточки вне `ToasterContainer` —\nтам контекста менеджера нет, и полоска зафиксируется на `scaleX(1)`."
      },
      "value": {
        "type": "number",
        "required": false,
        "description": "Статическое значение 0..1 для визуальных матриц. Когда задано — рендер без\nподписки на менеджер, бар замораживается на этом scaleX."
      }
    },
    "relatedTypes": {}
  },
