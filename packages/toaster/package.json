{
  "name": "@ds/toaster",
  "version": "1.0.4",
  "description": "Система всплывающих уведомлений с тремя типами контента и императивным API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/toaster"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/toaster",
  "license": "Apache-2.0",
  "author": "Nikita Ershov <niershov@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "**/*.css",
    "**/*.scss"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ds/icons": "workspace:^",
    "@ds/link": "workspace:^",
    "@ds/loader": "workspace:^",
    "@ds/locale": "workspace:^",
    "@ds/materials": "workspace:^",
    "@ds/scroll": "workspace:^",
    "@ds/truncate-string": "workspace:^",
    "@ds/utils": "workspace:^",
    "classnames": "catalog:"
  }
}
