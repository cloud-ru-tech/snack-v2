{
  "Accordion": {
    "displayName": "Accordion",
    "propsTypeName": "AccordionProps",
    "props": {
      "expandedDefault": {
        "type": "string | string[]",
        "required": false,
        "description": "Начальное состояние"
      },
      "expanded": {
        "type": "string | string[]",
        "required": false,
        "description": "Controlled состояние"
      },
      "onExpandedChange": {
        "type": "((value: string) => void) | ((value: string[]) => void) | undefined",
        "required": false,
        "description": "Controlled обработчик измения состояния",
        "typeRefs": [
          "onExpandedChange"
        ]
      },
      "selectionMode": {
        "type": "enum",
        "required": false,
        "values": [
          "single",
          "multiple"
        ],
        "description": "Режим работы аккордиона"
      }
    },
    "relatedTypes": {}
  },
  "CollapseBlock": {
    "displayName": "CollapseBlock",
    "propsTypeName": "CollapseBlockProps",
    "props": {
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "id": {
        "type": "string",
        "required": true,
        "description": "Уникальный идентификатор блока в группе переключателей"
      },
      "title": {
        "type": "string",
        "required": true,
        "description": "Начальное состояние раскрытия (uncontrolled)"
      },
      "afterTitle": {
        "type": "ReactNode",
        "required": false,
        "description": "Контент справа от заголовка"
      },
      "subTitle": {
        "type": "ReactNode",
        "required": false,
        "description": "Подзаголовок под строкой заголовка"
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "Дополнительный класс корневого элемента"
      },
      "view": {
        "type": "enum",
        "required": false,
        "values": [
          "simple",
          "outline",
          "elevated"
        ],
        "defaultValue": "simple",
        "description": "Визуальный вариант обложки (`simple`, `outline`, `elevated`)",
        "typeRefs": [
          "View"
        ]
      },
      "chevron": {
        "type": "enum",
        "required": false,
        "values": [
          "before",
          "after"
        ],
        "defaultValue": "after",
        "description": "Расположение шеврона относительно текста (`before` | `after`)",
        "typeRefs": [
          "Chevron"
        ]
      },
      "appearance": {
        "type": "enum",
        "required": false,
        "values": [
          "neutral",
          "primary",
          "red",
          "yellow",
          "green",
          "blue"
        ],
        "defaultValue": "neutral",
        "description": "Цветовая схема акрила",
        "typeRefs": [
          "Appearance"
        ]
      },
      "component": {
        "type": "enum",
        "required": true,
        "values": [
          "accordionPrimary",
          "accordionSecondary",
          "accordionTertiary"
        ],
        "description": "Уровень аккордеона: размер типографики и отступы",
        "typeRefs": [
          "Component"
        ]
      },
      "keepMounted": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Оставлять ли контент в DOM при сворачивании"
      }
    },
    "relatedTypes": {
      "View": {
        "kind": "union",
        "values": [
          "outline",
          "simple",
          "elevated"
        ],
        "own": true
      },
      "Chevron": {
        "kind": "union",
        "values": [
          "before",
          "after"
        ],
        "own": true
      },
      "Appearance": {
        "kind": "union",
        "values": [
          "neutral",
          "primary",
          "red",
          "yellow",
          "green",
          "blue"
        ],
        "own": true
      },
      "Component": {
        "kind": "union",
        "values": [
          "accordionPrimary",
          "accordionSecondary",
          "accordionTertiary"
        ],
        "own": true
      }
    },
    "description": "Элемент аккордеона: заголовок, шеврон и раскрываемая область с контентом."
  },
