{
  "Accordion": {
    "displayName": "Accordion",
    "propsTypeName": "AccordionProps",
    "props": {
      "children": {
        "type": "string | number | boolean | ReactElement<any, string | JSXElementConstructor<any>> | Iterable<ReactNode> | ReactPortal | null | undefined",
        "required": false
      },
      "expanded": {
        "type": "string | string[]",
        "required": false,
        "description": "Controlled состояние"
      },
      "expandedDefault": {
        "type": "string | string[]",
        "required": false,
        "description": "Начальное состояние"
      },
      "onExpandedChange": {
        "type": "((value: string) => void) | ((value: string[]) => void) | undefined",
        "required": false,
        "description": "Controlled обработчик измения состояния"
      },
      "selectionMode": {
        "type": "enum",
        "required": false,
        "values": [
          "multiple",
          "single"
        ],
        "description": "Режим работы аккордиона"
      }
    },
    "relatedTypes": {}
  },
  "CollapseBlock": {
    "displayName": "CollapseBlock",
    "propsTypeName": "CollapseBlockProps",
    "description": "Элемент аккордеона: заголовок, шеврон и раскрываемая область с контентом.",
    "props": {
      "afterTitle": {
        "type": "ReactNode",
        "required": false,
        "description": "Контент справа от заголовка"
      },
      "backgroundPredefined": {
        "type": "enum",
        "required": false,
        "values": [
          "blueBackground",
          "decorTransparent",
          "greenBackground",
          "neutralBackground1Level",
          "orangeBackground",
          "pinkBackground",
          "primaryBackground",
          "redBackground",
          "transparent",
          "violetBackground",
          "yellowBackground"
        ],
        "defaultValue": "neutralBackground1Level",
        "description": "Слой backgroundPredefined + acrylic (см. `BACKGROUND_PREDEFINED_FILL` в `@ds/materials`).\nПо умолчанию `material/neutralBackground1Level`.",
        "typeRefs": [
          "BackgroundPredefinedFill"
        ]
      },
      "chevron": {
        "type": "enum",
        "required": false,
        "values": [
          "after",
          "before"
        ],
        "defaultValue": "after",
        "description": "Расположение шеврона относительно текста (`before` | `after`)",
        "typeRefs": [
          "Chevron"
        ]
      },
      "children": {
        "type": "string | number | boolean | ReactElement<any, string | JSXElementConstructor<any>> | Iterable<ReactNode> | ReactPortal | null | undefined",
        "required": false
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "Дополнительный класс корневого элемента"
      },
      "component": {
        "type": "enum",
        "required": true,
        "values": [
          "accordionPrimary",
          "accordionSecondary",
          "accordionTertiary"
        ],
        "description": "Уровень аккордеона: размер типографики и отступы",
        "typeRefs": [
          "Component"
        ]
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "id": {
        "type": "string",
        "required": true,
        "description": "Уникальный идентификатор блока в группе переключателей"
      },
      "keepMounted": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Оставлять ли контент в DOM при сворачивании"
      },
      "subTitle": {
        "type": "ReactNode",
        "required": false,
        "description": "Подзаголовок под строкой заголовка"
      },
      "title": {
        "type": "string",
        "required": true,
        "description": "Начальное состояние раскрытия (uncontrolled)"
      },
      "view": {
        "type": "enum",
        "required": false,
        "values": [
          "elevated",
          "outline",
          "simple"
        ],
        "defaultValue": "simple",
        "description": "Визуальный вариант обложки (`simple`, `outline`, `elevated`)",
        "typeRefs": [
          "View"
        ]
      }
    },
    "relatedTypes": {
      "BackgroundPredefinedFill": {
        "kind": "union",
        "values": [
          "blueBackground",
          "decorTransparent",
          "greenBackground",
          "neutralBackground1Level",
          "orangeBackground",
          "pinkBackground",
          "primaryBackground",
          "redBackground",
          "transparent",
          "violetBackground",
          "yellowBackground"
        ],
        "own": false
      },
      "Chevron": {
        "kind": "union",
        "values": [
          "after",
          "before"
        ],
        "own": true
      },
      "Component": {
        "kind": "union",
        "values": [
          "accordionPrimary",
          "accordionSecondary",
          "accordionTertiary"
        ],
        "own": true
      },
      "View": {
        "kind": "union",
        "values": [
          "elevated",
          "outline",
          "simple"
        ],
        "own": true
      }
    }
  },
