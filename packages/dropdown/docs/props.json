{
  "Dropdown": {
    "displayName": "Dropdown",
    "propsTypeName": "DropdownProps",
    "props": {
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "content": {
        "type": "ReactNode",
        "required": true,
        "description": "Содержимое внутри поповера"
      },
      "state": {
        "type": "DropdownState",
        "required": false,
        "description": "Состояние",
        "typeRefs": [
          "ActionButtonProps",
          "BlockProps",
          "BlockPropsWithIcon",
          "DropdownState"
        ]
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс"
      },
      "triggerClassName": {
        "type": "string",
        "required": false,
        "description": "CSS-класс триггера"
      },
      "open": {
        "type": "boolean",
        "required": false,
        "description": "Управляет состоянием показан/не показан."
      },
      "onOpenChange": {
        "type": "((isOpen: boolean) => void)",
        "required": false,
        "description": "Колбек отображения компонента. Срабатывает при изменении состояния open."
      },
      "hoverDelayOpen": {
        "type": "number",
        "required": false,
        "description": "Задержка открытия по ховеру"
      },
      "hoverDelayClose": {
        "type": "number",
        "required": false,
        "description": "Задержка закрытия по ховеру"
      },
      "widthStrategy": {
        "type": "enum",
        "required": false,
        "values": [
          "auto",
          "gte",
          "eq"
        ],
        "defaultValue": "gte",
        "description": "Стратегия управления шириной контейнера поповера\n<br/> - `auto` - соответствует ширине контента,\n<br/> - `gte` - Great Than or Equal, равен ширине таргета или больше ее, если контент в поповере шире,\n<br/> - `eq` - Equal, строго равен ширине таргета.",
        "typeRefs": [
          "PopoverWidthStrategy"
        ]
      },
      "offset": {
        "type": "number",
        "required": false,
        "defaultValue": "0",
        "description": "Отступ поповера от его триггер-элемента (в пикселях)."
      },
      "closeOnEscapeKey": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Закрывать ли по нажатию на кнопку `Esc`"
      },
      "triggerClickByKeys": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Вызывается ли попоповер по нажатию клавиш Enter/Space (при trigger = `click`)"
      },
      "triggerRef": {
        "type": "ForwardedRef<ReferenceType | HTMLElement | null>",
        "required": false,
        "description": "Ref ссылка на триггер"
      },
      "outsideClick": {
        "type": "boolean | OutsideClickHandler",
        "required": false,
        "description": "Закрывать ли при клике вне поповера",
        "typeRefs": [
          "OutsideClickHandler"
        ]
      },
      "fallbackPlacements": {
        "type": "Placement[]",
        "required": false,
        "description": "Цепочка расположений которая будет применяться к поповеру от первого к последнему если при текущем он не влезает.",
        "typeRefs": [
          "Placement"
        ]
      },
      "disableSpanWrapper": {
        "type": "boolean",
        "required": false,
        "description": "Отключает для `isValidElement` внешнюю обертку триггера\n<br/>\nПригодится для элементов с `position: absolute`"
      },
      "closeOnPopstate": {
        "type": "boolean",
        "required": false,
        "description": "Закрывать ли поповер при пекреходе по истории браузера"
      },
      "trigger": {
        "type": "enum",
        "required": false,
        "values": [
          "click",
          "hover",
          "focusVisible",
          "focus",
          "hoverAndFocusVisible",
          "hoverAndFocus",
          "clickAndFocusVisible"
        ],
        "defaultValue": "click",
        "description": "Условие отображения поповера:\n<br/> - `click` - открывать по клику\n<br/> - `hover` - открывать по ховеру\n<br/> - `focusVisible` - открывать по focus-visible\n<br/> - `focus` - открывать по фокусу\n<br/> - `hoverAndFocusVisible` - открывать по ховеру и focus-visible\n<br/> - `hoverAndFocus` - открывать по ховеру и фокусу\n<br/> - `clickAndFocusVisible` - открывать по клику и focus-visible",
        "typeRefs": [
          "Trigger"
        ]
      },
      "placement": {
        "type": "enum",
        "required": false,
        "values": [
          "left",
          "left-start",
          "left-end",
          "right",
          "right-start",
          "right-end",
          "top",
          "top-start",
          "top-end",
          "bottom",
          "bottom-start",
          "bottom-end"
        ],
        "defaultValue": "bottom-start",
        "description": "Положение поповера относительно своего триггера (children).",
        "typeRefs": [
          "Placement"
        ]
      }
    },
    "relatedTypes": {
      "ActionButtonProps": {
        "kind": "interface",
        "props": {
          "actionLabel": {
            "type": "string | undefined",
            "required": false,
            "description": "Лейбл кнопки-действия"
          },
          "onActionClick": {
            "type": "(() => void) | undefined",
            "required": false,
            "description": "Действие при клике по кнопке",
            "typeRefs": [
              "onActionClick"
            ]
          }
        },
        "own": true
      },
      "BlockProps": {
        "kind": "interface",
        "props": {
          "description": {
            "type": "string | number | boolean | ReactElement<any, string | JSXElementConstructor<any>> | Iterable<ReactNode> | ReactPortal | null | undefined",
            "required": false,
            "description": "Подзаголовок"
          }
        },
        "own": true
      },
      "IconPredefinedProps": {
        "kind": "interface",
        "props": {
          "data-test-id": {
            "type": "string | undefined",
            "required": false
          },
          "className": {
            "type": "string | undefined",
            "required": false,
            "description": "CSS-класс"
          },
          "appearance": {
            "type": "Appearance | undefined",
            "required": false,
            "values": [
              "neutral",
              "primary",
              "red",
              "orange",
              "yellow",
              "green",
              "blue",
              "violet",
              "pink"
            ],
            "description": "Внешний вид",
            "typeRefs": [
              "Appearance"
            ]
          },
          "decor": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Наличие цветной подложки"
          },
          "icon": {
            "type": "((props: { size?: number; className?: string; }, deprecatedLegacyContext?: any) => ReactNode) | (new (props: { size?: number; className?: string; }, deprecatedLegacyContext?: any) => Component<any, any>)",
            "required": true,
            "description": "JSX иконки"
          },
          "size": {
            "type": "Size | undefined",
            "required": false,
            "values": [
              "m",
              "l",
              "5xl"
            ],
            "description": "Размер",
            "typeRefs": [
              "Size"
            ]
          },
          "shape": {
            "type": "\"round\" | \"square\" | undefined",
            "required": false,
            "values": [
              "round",
              "square"
            ],
            "description": "Форма: круглая или квадратная"
          }
        },
        "own": false
      },
      "BlockPropsWithIcon": {
        "kind": "interface",
        "props": {
          "description": {
            "type": "string | number | boolean | ReactElement<any, string | JSXElementConstructor<any>> | Iterable<ReactNode> | ReactPortal | null | undefined",
            "required": false,
            "description": "Подзаголовок"
          },
          "icon": {
            "type": "IconPredefinedProps | undefined",
            "required": false,
            "description": "Иконка",
            "typeRefs": [
              "IconPredefinedProps"
            ]
          }
        },
        "own": true
      },
      "DropdownState": {
        "kind": "alias",
        "type": "{ type: STATE.Loading; } | ({ type: STATE.NotFound; } & ActionButtonProps & BlockProps) | ({ type: STATE.NoData; } & ActionButtonProps & BlockPropsWithIcon) | ({ type: STATE.DataError; } & ActionButtonProps & BlockPropsWithIcon)",
        "own": true
      },
      "Placement": {
        "kind": "union",
        "values": [
          "left",
          "left-start",
          "left-end",
          "right",
          "right-start",
          "right-end",
          "top",
          "top-start",
          "top-end",
          "bottom",
          "bottom-start",
          "bottom-end"
        ],
        "own": false
      },
      "OutsideClickHandler": {
        "kind": "alias",
        "type": "(event: MouseEvent) => boolean",
        "own": false
      },
      "PopoverWidthStrategy": {
        "kind": "union",
        "values": [
          "auto",
          "gte",
          "eq"
        ],
        "own": false
      },
      "Trigger": {
        "kind": "union",
        "values": [
          "click",
          "hover",
          "focusVisible",
          "focus",
          "hoverAndFocusVisible",
          "hoverAndFocus",
          "clickAndFocusVisible"
        ],
        "own": false
      }
    },
    "description": "Dropdown компонент"
  }
}
