{
  "Dropdown": {
    "displayName": "Dropdown",
    "propsTypeName": "DropdownProps",
    "description": "Dropdown компонент",
    "props": {
      "children": {
        "type": "string | number | boolean | ReactElement<any, string | JSXElementConstructor<any>> | Iterable<ReactNode> | ReactPortal | null | undefined",
        "required": false
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс"
      },
      "closeOnEscapeKey": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Закрывать ли по нажатию на кнопку `Esc`"
      },
      "closeOnPopstate": {
        "type": "boolean",
        "required": false,
        "description": "Закрывать ли поповер при переходе по истории браузера"
      },
      "container": {
        "type": "RefObject<HTMLElement | null>",
        "required": false,
        "description": "Контейнер портала (ref). Переопределяет `PortalContext` для этого инстанса —\nпо аналогии с `container` у Modal/Drawer. По умолчанию берётся из `PortalContextProvider`."
      },
      "content": {
        "type": "ReactNode",
        "required": true,
        "description": "Содержимое внутри поповера (body)"
      },
      "contentClassName": {
        "type": "string",
        "required": false,
        "description": "CSS-класс контентной обёртки (bodyWrapper). Позволяет потребителю переопределить\nпаддинги body — например, список (`@ds/list`) задаёт собственные паддинги айтемов\nи обнуляет паддинг bodyWrapper."
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "disableSpanWrapper": {
        "type": "boolean",
        "required": false,
        "description": "Отключает для `isValidElement` внешнюю обертку триггера\n<br/>\nПригодится для элементов с `position: absolute`"
      },
      "fallbackPlacements": {
        "type": "Placement[]",
        "required": false,
        "description": "Цепочка расположений которая будет применяться к поповеру от первого к последнему если при текущем он не влезает.",
        "typeRefs": [
          "Placement"
        ]
      },
      "footer": {
        "type": "ReactNode",
        "required": false,
        "description": "Слот футера (bottomBar)"
      },
      "footerDivider": {
        "type": "boolean",
        "required": false,
        "description": "Divider между body и футером"
      },
      "headerDivider": {
        "type": "boolean",
        "required": false,
        "description": "Divider между шапкой и body"
      },
      "headline": {
        "type": "ReactNode",
        "required": false,
        "description": "Заголовок в шапке (topBar)"
      },
      "headlineHint": {
        "type": "ReactNode",
        "required": false,
        "description": "Подсказка-иконка рядом с заголовком (потребитель собирает, напр. `<QuestionTooltip />`)"
      },
      "hoverDelayClose": {
        "type": "number",
        "required": false,
        "description": "Задержка закрытия по ховеру"
      },
      "hoverDelayOpen": {
        "type": "number",
        "required": false,
        "description": "Задержка открытия по ховеру"
      },
      "offset": {
        "type": "number",
        "required": false,
        "defaultValue": "0",
        "description": "Отступ поповера от его триггер-элемента (в пикселях)."
      },
      "onOpenChange": {
        "type": "((isOpen: boolean) => void)",
        "required": false,
        "description": "Колбек отображения компонента. Срабатывает при изменении состояния open."
      },
      "open": {
        "type": "boolean",
        "required": false,
        "description": "Управляет состоянием показан/не показан."
      },
      "outsideClick": {
        "type": "boolean | OutsideClickHandler",
        "required": false,
        "description": "Закрывать ли при клике вне поповера",
        "typeRefs": [
          "OutsideClickHandler"
        ]
      },
      "placement": {
        "type": "enum",
        "required": false,
        "values": [
          "bottom",
          "bottom-end",
          "bottom-start",
          "left",
          "left-end",
          "left-start",
          "right",
          "right-end",
          "right-start",
          "top",
          "top-end",
          "top-start"
        ],
        "defaultValue": "bottom-start",
        "description": "Положение поповера относительно своего триггера (children).",
        "typeRefs": [
          "Placement"
        ]
      },
      "search": {
        "type": "ReactNode",
        "required": false,
        "description": "Слот поиска в шапке (topBar)"
      },
      "state": {
        "type": "DropdownState",
        "required": false,
        "description": "Состояние",
        "typeRefs": [
          "ActionButtonProps",
          "BlockProps",
          "BlockPropsWithIcon",
          "DropdownState"
        ]
      },
      "trigger": {
        "type": "enum",
        "required": false,
        "values": [
          "click",
          "clickAndFocusVisible",
          "focus",
          "focusVisible",
          "hover",
          "hoverAndFocus",
          "hoverAndFocusVisible"
        ],
        "defaultValue": "click",
        "description": "Условие отображения поповера:\n<br/> - `click` - открывать по клику\n<br/> - `hover` - открывать по ховеру\n<br/> - `focusVisible` - открывать по focus-visible\n<br/> - `focus` - открывать по фокусу\n<br/> - `hoverAndFocusVisible` - открывать по ховеру и focus-visible\n<br/> - `hoverAndFocus` - открывать по ховеру и фокусу\n<br/> - `clickAndFocusVisible` - открывать по клику и focus-visible",
        "typeRefs": [
          "Trigger"
        ]
      },
      "triggerClassName": {
        "type": "string",
        "required": false,
        "description": "CSS-класс триггера"
      },
      "triggerClickByKeys": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Вызывается ли попоповер по нажатию клавиш Enter/Space (при trigger = `click`)"
      },
      "triggerRef": {
        "type": "ForwardedRef<ReferenceType | HTMLElement | null>",
        "required": false,
        "description": "Ref ссылка на триггер"
      },
      "widthStrategy": {
        "type": "enum",
        "required": false,
        "values": [
          "auto",
          "eq",
          "gte"
        ],
        "defaultValue": "gte",
        "description": "Стратегия управления шириной контейнера поповера\n<br/> - `auto` - соответствует ширине контента,\n<br/> - `gte` - Great Than or Equal, равен ширине таргета или больше ее, если контент в поповере шире,\n<br/> - `eq` - Equal, строго равен ширине таргета.",
        "typeRefs": [
          "PopoverWidthStrategy"
        ]
      }
    },
    "relatedTypes": {
      "ActionButtonProps": {
        "kind": "interface",
        "props": {
          "actionLabel": {
            "type": "string | undefined",
            "required": false,
            "description": "Лейбл кнопки-действия"
          },
          "onActionClick": {
            "type": "(() => void) | undefined",
            "required": false,
            "description": "Действие при клике по кнопке"
          }
        },
        "own": true
      },
      "BlockProps": {
        "kind": "interface",
        "props": {
          "description": {
            "type": "string | number | boolean | ReactElement<any, string | JSXElementConstructor<any>> | Iterable<ReactNode> | ReactPortal | null | undefined",
            "required": false,
            "description": "Подзаголовок"
          }
        },
        "own": true
      },
      "BlockPropsWithIcon": {
        "kind": "interface",
        "props": {
          "description": {
            "type": "string | number | boolean | ReactElement<any, string | JSXElementConstructor<any>> | Iterable<ReactNode> | ReactPortal | null | undefined",
            "required": false,
            "description": "Подзаголовок"
          },
          "icon": {
            "type": "IconPredefinedProps | undefined",
            "required": false,
            "description": "Иконка",
            "typeRefs": [
              "IconPredefinedProps"
            ]
          }
        },
        "own": true
      },
      "DropdownState": {
        "kind": "alias",
        "type": "{ type: typeof STATE.Loading; } | ({ type: typeof STATE.NotFound; } & ActionButtonProps & BlockProps) | ({ type: typeof STATE.NoData; } & ActionButtonProps & BlockPropsWithIcon) | ({ type: typeof STATE.DataError; } & ActionButtonProps & BlockPropsWithIcon)",
        "own": true
      },
      "IconPredefinedProps": {
        "kind": "interface",
        "props": {
          "appearance": {
            "type": "Appearance | undefined",
            "required": false,
            "values": [
              "blue",
              "green",
              "neutral",
              "orange",
              "pink",
              "primary",
              "red",
              "violet",
              "yellow"
            ],
            "description": "Внешний вид",
            "typeRefs": [
              "Appearance"
            ]
          },
          "className": {
            "type": "string | undefined",
            "required": false,
            "description": "CSS-класс"
          },
          "data-test-id": {
            "type": "string | undefined",
            "required": false
          },
          "decor": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Наличие цветной подложки"
          },
          "icon": {
            "type": "((props: { size?: number; className?: string; }, deprecatedLegacyContext?: any) => ReactNode) | (new (props: { size?: number; className?: string; }, deprecatedLegacyContext?: any) => Component<any, any>)",
            "required": true,
            "description": "JSX иконки"
          },
          "shape": {
            "type": "\"round\" | \"square\" | undefined",
            "required": false,
            "values": [
              "round",
              "square"
            ],
            "description": "Форма: круглая или квадратная"
          },
          "size": {
            "type": "Size | undefined",
            "required": false,
            "values": [
              "5xl",
              "l",
              "m"
            ],
            "description": "Размер",
            "typeRefs": [
              "Size"
            ]
          }
        },
        "own": false
      },
      "OutsideClickHandler": {
        "kind": "alias",
        "type": "(event: MouseEvent) => boolean",
        "own": false
      },
      "Placement": {
        "kind": "union",
        "values": [
          "bottom",
          "bottom-end",
          "bottom-start",
          "left",
          "left-end",
          "left-start",
          "right",
          "right-end",
          "right-start",
          "top",
          "top-end",
          "top-start"
        ],
        "own": false
      },
      "PopoverWidthStrategy": {
        "kind": "union",
        "values": [
          "auto",
          "eq",
          "gte"
        ],
        "own": false
      },
      "Trigger": {
        "kind": "union",
        "values": [
          "click",
          "clickAndFocusVisible",
          "focus",
          "focusVisible",
          "hover",
          "hoverAndFocus",
          "hoverAndFocusVisible"
        ],
        "own": false
      }
    }
  }
}
