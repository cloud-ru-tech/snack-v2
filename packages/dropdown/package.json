{
  "name": "@ds/dropdown",
  "version": "1.0.3",
  "description": "Выпадающий блок с произвольным контентом и встроенными состояниями loading / not-found / no-data / data-error.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/dropdown"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/dropdown",
  "license": "Apache-2.0",
  "author": "Ilya Belyavskiy <iabelyavskiy@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/adaptive": "workspace:^",
    "@ds/bottom-sheet": "workspace:^",
    "@ds/button": "workspace:^",
    "@ds/divider": "workspace:^",
    "@ds/icons": "workspace:^",
    "@ds/info-block": "workspace:^",
    "@ds/loader": "workspace:^",
    "@ds/materials": "workspace:^",
    "@ds/popover-private": "workspace:^",
    "@ds/utils": "workspace:^",
    "classnames": "catalog:"
  },
  "peerDependencies": {
    "@ds/locale": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
