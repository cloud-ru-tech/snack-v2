              "Size"
            ]
          },
          "variant": {
            "type": "Type | undefined",
            "required": false,
            "values": [
              "agentic",
              "critical",
              "help",
              "information",
              "security",
              "warning"
            ],
            "description": "Семантический вариант баннера (ось `Type` в Figma). По умолчанию `information`.",
