{
  "Card": {
    "displayName": "Card",
    "propsTypeName": "CardProps",
    "props": {
      "as": {
        "type": "ElementType",
        "required": false,
        "typeRefs": [
          "T"
        ]
      },
      "backgroundPredefined": {
        "type": "enum",
        "required": false,
        "values": [
          "blueBackground",
          "decorTransparent",
          "greenBackground",
          "neutralBackground1Level",
          "orangeBackground",
          "pinkBackground",
          "primaryBackground",
          "redBackground",
          "transparent",
          "violetBackground",
          "yellowBackground"
        ],
        "defaultValue": "neutralBackground1Level",
        "description": "Слой backgroundPredefined + acrylic (см. `BACKGROUND_PREDEFINED_FILL` в `@ds/materials`).\nПо умолчанию `material/neutralBackground1Level`.",
        "typeRefs": [
          "BackgroundPredefinedFill"
        ]
      },
      "checked": {
        "type": "boolean",
        "required": false,
        "description": "Выбран (для multiSelect — показывает чек-бэйдж в углу)."
      },
      "children": {
        "type": "string | number | boolean | ReactElement<any, string | JSXElementConstructor<any>> | Iterable<ReactNode> | ReactPortal | null | undefined",
        "required": false
      },
      "className": {
        "type": "string",
        "required": false
      },
      "disabled": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Заблокированный режим: интерактив отключён, opacity снижен."
      },
      "innerRef": {
        "type": "any",
        "required": false,
        "description": "Ref на реальный DOM-элемент/инстанс, который рендерится через `as`.\nИспользуем явный проп, чтобы не зависеть от `forwardRef` и не тащить type-assertions на экспорт.",
        "typeRefs": [
          "PolymorphicRef",
          "T"
        ]
      },
      "interactive": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Включает интерактивные эффекты (hover/press state layer, cursor: pointer, focus-ring).\nУстанови `false` для презентационной карточки без отклика на курсор."
      },
      "multiSelect": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Режим множественного выбора — добавляет чек-бэйдж в углу при `checked`."
      },
      "radius": {
        "type": "enum",
        "required": false,
        "values": [
          "l",
          "m",
          "s"
        ],
        "defaultValue": "m",
        "description": "Радиус контейнера.",
        "typeRefs": [
          "Radius"
        ]
      },
      "view": {
        "type": "enum",
        "required": false,
        "values": [
          "elevated",
          "outline",
          "simple"
        ],
        "defaultValue": "simple",
        "description": "Визуальный режим карточки.",
        "typeRefs": [
          "View"
        ]
      }
    },
    "relatedTypes": {
      "BackgroundPredefinedFill": {
        "kind": "union",
        "values": [
          "blueBackground",
          "decorTransparent",
          "greenBackground",
          "neutralBackground1Level",
          "orangeBackground",
          "pinkBackground",
          "primaryBackground",
          "redBackground",
          "transparent",
          "violetBackground",
          "yellowBackground"
        ],
        "own": false
      },
      "PolymorphicRef": {
        "kind": "alias",
        "type": "ComponentPropsWithRef<T>[\"ref\"]",
        "own": true
      },
      "Radius": {
        "kind": "union",
        "values": [
          "l",
          "m",
          "s"
        ],
        "own": true
      },
      "View": {
        "kind": "union",
        "values": [
          "elevated",
          "outline",
          "simple"
        ],
        "own": true
      }
    }
  }
}
