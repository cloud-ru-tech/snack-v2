        "required": false,
        "description": "Моноширинный режим имени и счётчика. По умолчанию наследуется от `AiToolDetails`."
      },
      "name": {
        "type": "ReactNode",
        "required": false,
        "description": "Имя узла (`Key[ArrayName]`)."
      },
      "onToggle": {
        "type": "((opened: boolean) => void)",
        "required": false,
        "description": "Переключение раскрытия. Получает новое значение `opened`."
      },
      "opened": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Раскрытое состояние. Источник истины — родитель."
      },
      "unit": {
        "type": "string",
        "required": false,
        "description": "Единица измерения после количества (например `шт.`)."
      }
    },
    "relatedTypes": {}
  },
  "AiToolBadge": {
    "displayName": "AiToolBadge",
    "propsTypeName": "AiToolBadgeProps",
