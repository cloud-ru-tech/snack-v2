          "T"
        ]
      },
      "badgeType": {
        "type": "enum",
        "required": false,
        "values": [
          "cloud-ru",
          "other"
        ],
        "description": "Тип бейджа — определяет встроенную иконку (`cloud-ru` / `other`). Без него иконка не рендерится.",
        "typeRefs": [
          "AiToolBadgeType"
        ]
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "Доп. класс корня."
      },
      "data-test-id": {
        "type": "string",
        "required": false,
        "defaultValue": "ai-tool-badge"
      },
      "innerRef": {
        "type": "any",
        "required": false,
        "description": "Ref на корневой элемент (вместо `forwardRef`).",
        "typeRefs": [
          "PolymorphicRef",
          "T"
        ]
      },
      "label": {
        "type": "ReactNode",
        "required": false,
        "description": "Текст бейджа (одна строка с ellipsis)."
      }
    },
    "relatedTypes": {
      "AiToolBadgeType": {
        "kind": "union",
        "values": [
          "cloud-ru",
          "other"
        ],
        "own": true
      },
      "PolymorphicRef": {
        "kind": "alias",
        "type": "ComponentPropsWithRef<T>[\"ref\"]",
        "own": true
      }
    }
  },
