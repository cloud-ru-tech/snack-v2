{
  "Block": {
    "displayName": "Block",
    "propsTypeName": "BlockProps",
    "description": "Компонент-слот для отображения любого содержимого на подложке, имитирующей материал (матовое/полупрозрачное стекло).\n\nПоддерживает:\n- Акриловый фон с эффектом backdrop blur\n- Различные варианты отображения: simple (обычный акрил), outline (с обводкой), shadow (с тенью), transparent (полупрозрачное матовое стекло)\n- Различные размеры: s (малый), m (средний), l (большой)\n- Гибкое содержимое - принимает любые React children",
    "props": {
      "children": {
        "type": "ReactNode",
        "required": false,
        "description": "Содержимое"
      },
      "data-test-id": {
        "type": "string",
        "required": false,
        "description": "Стабильный идентификатор для e2e/tests"
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "l",
          "m",
          "s"
        ],
        "defaultValue": "l",
        "description": "Размер",
        "typeRefs": [
          "Size"
        ]
      },
      "variant": {
        "type": "enum",
        "required": false,
        "values": [
          "outline",
          "shadow",
          "simple",
          "transparent"
        ],
        "defaultValue": "simple",
        "description": "Вариант",
        "typeRefs": [
          "Variant"
        ]
      }
    },
    "relatedTypes": {
      "Size": {
        "kind": "union",
        "values": [
          "l",
          "m",
          "s"
        ],
        "own": true
      },
      "Variant": {
        "kind": "union",
        "values": [
          "outline",
          "shadow",
          "simple",
          "transparent"
        ],
        "own": true
      }
    }
  }
}
