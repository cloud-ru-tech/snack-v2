{
  "AiHistoryLine": {
    "displayName": "AiHistoryLine",
    "propsTypeName": "AiHistoryLineProps",
    "props": {
      "as": {
        "type": "ElementType",
        "required": false,
        "description": "Полиморфный тег корня. По умолчанию `ul`."
      },
      "children": {
        "type": "ReactNode",
        "required": false,
        "description": "Элементы ленты."
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "Дополнительный класс корня."
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "defaultValue": {
        "type": "string",
        "required": false,
        "description": "`id` индикатора, выбранного при первом рендере."
      },
      "innerRef": {
        "type": "any",
        "required": false,
        "description": "Ref на корневой элемент.",
        "typeRefs": [
          "PolymorphicRef"
        ]
      },
      "onIndicatorChange": {
        "type": "((value: string) => void)",
        "required": false,
        "description": "Сообщает `id` выбранного индикатора. Повторный клик по нему передаёт `undefined`."
      },
      "value": {
        "type": "string",
        "required": false,
        "description": "`id` выбранного индикатора. Вместе с `onIndicatorChange` выбор управляемый."
      }
    },
    "relatedTypes": {
      "PolymorphicRef": {
        "kind": "alias",
        "type": "ComponentPropsWithRef<T>[\"ref\"]",
        "own": false
      }
    }
  },
