{
  "name": "@ds/slider",
  "version": "1.0.1",
  "description": "Ползунок для выбора числового значения или диапазона — с метками, tooltip на ручке и опциональным равномерным распределением нелинейных значений.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/slider"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/slider",
  "license": "Apache-2.0",
  "author": "Nikita Ershov <niershov@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css",
    "**/*.scss"
  ],
  "dependencies": {
    "@ds/tooltip": "workspace:^",
    "@ds/utils": "workspace:^",
    "classnames": "catalog:",
    "rc-slider": "^11.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
