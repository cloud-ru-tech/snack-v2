  "DrawerCustom": {
    "displayName": "DrawerCustom",
    "props": {
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "open": {
        "type": "boolean",
        "required": true,
        "description": "Управление состоянием показан/не показан."
      },
      "onClose": {
        "type": "() => void",
        "required": true,
        "description": "Колбэк закрытия"
      },
      "showBlackout": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Отображение темной подложки"
      },
      "position": {
        "type": "enum",
        "required": true,
        "values": [
          "left",
          "right",
          "top",
          "bottom"
        ],
        "description": "Расположение"
      },
      "width": {
        "type": "string | number",
        "required": false,
        "defaultValue": "'s'",
        "description": "Ширина (только при position: \"left\" | \"right\")"
      },
      "heightAuto": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Высота панели по контенту (только при `position: \"top\" | \"bottom\"`).\nПри `position: \"left\" | \"right\"` не используется — поведение и ширина задаются только `width` (`'s' | 'm' | 'l'` или число/строка)."
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс для элемента с контентом"
      },
      "rootClassName": {
        "type": "string",
        "required": false,
        "description": "CSS-класс для корневого элемента"
      },
      "push": {
        "type": "boolean | PushConfig",
        "required": false,
        "description": "Смещение при открытии \"вложенного\" компонента"
      },
      "container": {
        "type": "string | HTMLElement",
        "required": false,
        "description": "Контейнер в котором будет рендерится Drawer. По-умолчанию - body"
      },
      "nestedDrawer": {
        "type": "ReactElement<DrawerCustomProps, string | JSXElementConstructor<any>>",
        "required": false,
        "description": "Вложенный Drawer"
      },
      "closeOnPopstate": {
        "type": "boolean",
        "required": false,
        "description": "Закрывать дровер при перемещении по истории браузера"
      },
      "footer": {
        "type": "ReactElement<any, string | JSXElementConstructor<any>>",
        "required": false,
        "description": "Футер"
      }
    }
  },
