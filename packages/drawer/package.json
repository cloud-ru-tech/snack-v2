{
  "name": "@ds/drawer",
  "version": "1.0.1",
  "description": "Пакет выезжающих панелей — компоненты Drawer и DrawerCustom с едиными токенами позиции и ширины.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/drawer"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/drawer",
  "license": "Apache-2.0",
  "author": "Ilya Belyavskiy <iabelyavskiy@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ds/adaptive": "workspace:^",
    "@ds/bottom-sheet": "workspace:^",
    "@ds/materials": "workspace:^",
    "@ds/popup-private": "workspace:^",
    "@ds/portal-context": "workspace:^",
    "@ds/scroll": "workspace:^",
    "@ds/tooltip": "workspace:^",
    "@ds/utils": "workspace:^",
    "@rc-component/drawer": "^1.4.2",
    "classnames": "catalog:",
    "react-remove-scroll": "catalog:",
    "tabbable": "catalog:"
  }
}
