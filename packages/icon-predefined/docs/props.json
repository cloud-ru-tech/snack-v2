{
  "IconPredefined": {
    "displayName": "IconPredefined",
    "propsTypeName": "IconPredefinedProps",
    "description": "Icon Predefined — оборачивает SVG-иконки и применяет предустановленное стилевое оформление.\nЗадаёт цвет через appearance, размер через size и форму контейнера через shape.",
    "props": {
      "appearance": {
        "type": "enum",
        "required": false,
        "values": [
          "blue",
          "green",
          "neutral",
          "orange",
          "pink",
          "primary",
          "red",
          "violet",
          "yellow"
        ],
        "defaultValue": "primary",
        "description": "Внешний вид",
        "typeRefs": [
          "Appearance"
        ]
      },
      "background": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Наличие цветной подложки"
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс"
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "icon": {
        "type": "JSXElementConstructor<{ size?: number | undefined; className?: string | undefined; }>",
        "required": true,
        "description": "JSX иконки"
      },
      "shape": {
        "type": "enum",
        "required": false,
        "values": [
          "rounded",
          "squared"
        ],
        "defaultValue": "rounded",
        "description": "Форма: круглая или квадратная"
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "5xl",
          "l",
          "m"
        ],
        "defaultValue": "m",
        "description": "Размер",
        "typeRefs": [
          "Size"
        ]
      }
    },
    "relatedTypes": {
      "Appearance": {
        "kind": "union",
        "values": [
          "blue",
          "green",
          "neutral",
          "orange",
          "pink",
          "primary",
          "red",
          "violet",
          "yellow"
        ],
        "own": true
      },
      "Size": {
        "kind": "union",
        "values": [
          "5xl",
          "l",
          "m"
        ],
        "own": true
      }
    }
  }
}
