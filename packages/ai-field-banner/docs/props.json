{
  "AiFieldBanner": {
    "displayName": "AiFieldBanner",
    "propsTypeName": "AiFieldBannerProps",
    "props": {
      "actionLabel": {
        "type": "string",
        "required": false,
        "description": "Подпись кнопки действия справа. Кнопка не рендерится, если не задана."
      },
      "bottomContent": {
        "type": "ReactNode",
        "required": false,
        "description": "Дополнительный слот под основной строкой. Не рендерится, если не задан."
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "Доп. класс корня."
      },
      "content": {
        "type": "ReactNode",
        "required": false,
        "description": "Текст или контент основной строки. Не рендерится, если не задан."
      },
      "data-test-id": {
        "type": "string",
        "required": false,
        "defaultValue": "ai-field-banner"
      },
      "icon": {
        "type": "ReactNode",
        "required": false,
        "description": "Иконка слева от текста"
      },
      "layoutPresets": {
        "type": "Partial<Record<LayoutType, Partial<AiFieldBannerLayoutDefaults>>>",
        "required": false,
        "description": "Override mobile-дефолтов адаптива для этого инстанса (deep-merge поверх `AI_FIELD_BANNER_LAYOUT_PRESETS`).\nEscape-hatch: обычно не нужен — DS-пресет применяется автоматически по `AdaptiveProvider`.",
        "typeRefs": [
          "AiFieldBannerLayoutDefaults",
          "LayoutPresets"
        ]
      },
      "onActionClick": {
        "type": "((event: MouseEvent<HTMLButtonElement, MouseEvent>) => void)",
        "required": false,
        "description": "Обработчик клика по кнопке действия."
      },
      "onClose": {
        "type": "((event: MouseEvent<HTMLButtonElement, MouseEvent>) => void)",
        "required": false,
        "description": "Нажатие на крестик. Крестик показывается, только если обработчик передан; убрать баннер решает потребитель."
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "m",
          "s"
        ],
        "description": "Размер на desktop: `s` — Field Banner, `m` — Field Banner Mobile. Высота по содержимому: при одной строке `s` 40, `m` 48.\nНа mobile размер задаёт пресет `AI_FIELD_BANNER_LAYOUT_PRESETS` (`m`); изменить его — через `layoutPresets`.",
        "typeRefs": [
          "Size"
        ]
      },
      "variant": {
        "type": "enum",
        "required": false,
        "values": [
          "agentic",
          "critical",
          "help",
          "information",
          "security",
          "warning"
        ],
        "defaultValue": "information",
        "description": "Семантический вариант баннера (ось `Variant` в Figma). По умолчанию `information`.",
        "typeRefs": [
          "Variant"
        ]
      }
    },
    "relatedTypes": {
      "AiFieldBannerLayoutDefaults": {
        "kind": "interface",
        "props": {
          "size": {
            "type": "Size | undefined",
            "required": false,
            "values": [
              "m",
              "s"
            ],
            "description": "Размер на desktop: `s` — Field Banner, `m` — Field Banner Mobile. Высота по содержимому: при одной строке `s` 40, `m` 48.\nНа mobile размер задаёт пресет `AI_FIELD_BANNER_LAYOUT_PRESETS` (`m`); изменить его — через `layoutPresets`.",
            "typeRefs": [
              "Size"
            ]
          }
        },
        "own": true
      },
      "LayoutPresets": {
        "kind": "interface",
        "props": {
          "desktop": {
            "type": "any",
            "required": false
          },
          "desktopSmall": {
            "type": "any",
            "required": false
          },
          "mobile": {
            "type": "any",
            "required": false
          },
          "tablet": {
            "type": "any",
            "required": false
          }
        },
        "own": false
      },
      "Size": {
        "kind": "union",
        "values": [
          "m",
          "s"
        ],
        "own": true
      },
      "Variant": {
        "kind": "union",
        "values": [
          "agentic",
          "critical",
          "help",
          "information",
          "security",
          "warning"
        ],
        "own": true
      }
    }
  }
}
