{
  "AiFieldBanner": {
    "displayName": "AiFieldBanner",
    "propsTypeName": "AiFieldBannerProps",
    "props": {
      "actionLabel": {
        "type": "string",
        "required": false,
        "description": "Подпись кнопки действия справа. Кнопка не рендерится, если не задана."
      },
      "bottomContent": {
        "type": "ReactNode",
        "required": false,
        "description": "Дополнительный слот под основной строкой. Не рендерится, если не задан."
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "Доп. класс корня."
      },
      "content": {
        "type": "ReactNode",
        "required": false,
        "description": "Текст или контент основной строки. Не рендерится, если не задан."
      },
      "data-test-id": {
        "type": "string",
        "required": false,
        "defaultValue": "ai-field-banner"
      },
      "icon": {
        "type": "ReactNode",
        "required": false,
        "description": "Иконка слева от текста"
      },
      "onActionClick": {
        "type": "((event: MouseEvent<HTMLButtonElement, MouseEvent>) => void)",
        "required": false,
        "description": "Обработчик клика по кнопке действия."
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "m",
          "s"
        ],
        "defaultValue": "s",
        "description": "Размер: без `bottomContent` — `s` 400×48, `m` 400×60; с ним — `s` 400×72, `m` 400×84.",
        "typeRefs": [
          "Size"
        ]
      },
      "variant": {
        "type": "enum",
        "required": false,
        "values": [
          "agentic",
          "critical",
          "help",
          "information",
          "security",
          "warning"
        ],
        "defaultValue": "information",
        "description": "Семантический вариант баннера (ось `Variant` в Figma). По умолчанию `information`.",
        "typeRefs": [
          "Variant"
        ]
      }
    },
    "relatedTypes": {
      "Size": {
        "kind": "union",
        "values": [
          "m",
          "s"
        ],
        "own": true
      },
      "Variant": {
        "kind": "union",
        "values": [
          "agentic",
          "critical",
          "help",
          "information",
          "security",
          "warning"
        ],
        "own": true
      }
    }
  }
