        "required": true,
        "description": "Render function. Принимает `stepper` и api:\n`goNext`, `goPrev`, `resetValidation`, `setValidator`, `isCompleted`,\n`currentStepIndex`, `stepCount`."
      },
      "onChangeCurrentStep": {
        "type": "((newValue: number, prevValue: number) => void)",
        "required": false,
