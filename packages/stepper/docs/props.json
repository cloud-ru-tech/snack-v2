        "description": "data-test-id"
      }
    }
  },
  "AdaptiveStepper": {
    "displayName": "AdaptiveStepper",
    "props": {
      "steps": {
        "type": "StepData[]",
        "required": true,
        "description": "Массив шагов"
      },
      "defaultCurrentStepIndex": {
        "type": "number",
        "required": false,
        "description": "Индекс текущего шага по-дефолту"
      },
      "validator": {
        "type": "StepsValidator",
