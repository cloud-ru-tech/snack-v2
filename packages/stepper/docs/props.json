  "Stepper": {
    "displayName": "Stepper",
    "propsTypeName": "StepperProps",
    "props": {
      "steps": {
        "type": "StepData[]",
        "required": true,
        "description": "Массив шагов",
        "typeRefs": [
          "StepData"
        ]
      },
      "defaultCurrentStepIndex": {
        "type": "number",
        "required": false,
        "defaultValue": "0",
        "description": "Индекс текущего шага по-дефолту"
      },
      "validator": {
        "type": "StepsValidator",
        "required": false,
        "description": "Валидатор шагов. Выполняется при смене шага. Принимает первым аргументом индекс текущего, вторым — индекс нового шага. Возвращает Promise<boolean>: false → шаг помечается как Rejected.",
        "typeRefs": [
          "StepsValidator"
        ]
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс"
      },
      "children": {
        "type": "(params: StepperApi) => ReactElement<any, string | JSXElementConstructor<any>>",
        "required": true,
        "description": "Render function. Принимает `stepper` — JSX-элемент степпера, а также api:\n`goNext`, `goPrev`, `resetValidation`, `setValidator`, `isCompleted`,\n`currentStepIndex`, `stepCount`.",
        "typeRefs": [
          "StepperApi"
        ]
      },
      "onChangeCurrentStep": {
        "type": "((newValue: number, prevValue: number) => void)",
        "required": false,
        "description": "Колбек смены текущего степа"
      },
      "onCompleteChange": {
        "type": "((isCompleted: boolean) => void)",
        "required": false,
        "description": "Колбек изменения завершённости"
      },
      "data-test-id": {
        "type": "string",
        "required": false,
        "description": "data-test-id"
      }
    },
    "relatedTypes": {
      "StepData": {
        "kind": "interface",
        "props": {
          "title": {
            "type": "string",
            "required": true
          },
          "description": {
            "type": "string | undefined",
            "required": false
          }
        },
        "own": true
      },
      "StepsValidator": {
        "kind": "alias",
        "type": "(prevStepIndex: number, newStepIndex: number) => Promise<boolean>",
        "own": true
      },
      "StepperApi": {
        "kind": "interface",
        "props": {
          "stepper": {
            "type": "ReactElement<any, string | JSXElementConstructor<any>>",
            "required": true
          },
          "goNext": {
            "type": "(stepIndex?: number) => void",
            "required": true
          },
          "goPrev": {
            "type": "(stepIndex?: number) => void",
            "required": true
          },
          "resetValidation": {
            "type": "() => void",
            "required": true
          },
          "setValidator": {
            "type": "(validator: StepsValidator) => void",
            "required": true,
            "typeRefs": [
              "StepsValidator"
            ]
          },
          "isCompleted": {
            "type": "boolean",
            "required": true
          },
          "currentStepIndex": {
            "type": "number",
            "required": true
          },
          "stepCount": {
            "type": "number",
            "required": true
          }
        },
        "own": true
      }
    }
  },
