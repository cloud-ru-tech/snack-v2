      },
      "data-test-id": {
        "type": "string",
        "required": false,
        "description": "data-test-id"
      },
      "layoutType": {
        "type": "enum",
        "required": true,
        "values": [
          "desktop",
          "mobile"
        ],
        "description": "Режим отображения: desktop (по-умолчанию) или mobile"
      }
    }
  }
