{
  "name": "@ds/stepper",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": ["dist", "src"],
  "sideEffects": ["*.css", "**/*.css"],
  "dependencies": {
    "@ds/icons": "workspace:*",
    "@ds/loader": "workspace:*",
    "@ds/materials": "workspace:*",
    "@ds/typography": "workspace:*",
    "@ds/utils": "workspace:*",
    "classnames": "2.5.1"
  },
  "publishConfig": { "access": "public" }
}
