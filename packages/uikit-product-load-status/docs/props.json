{
  "LoadStatus": {
    "displayName": "LoadStatus",
    "propsTypeName": "LoadStatusProps",
    "props": {
      "appearanceByProgress": {
        "type": "ProgressLimitList",
        "required": false,
        "defaultValue": "[\n  { appearance: 'green', condition: PROGRESS_LIMIT_CONDITION.Lte, limit: 70 },\n  { appearance: 'yellow', condition: PROGRESS_LIMIT_CONDITION.Lte, limit: 90 },\n  { appearance: 'red', condition: PROGRESS_LIMIT_CONDITION.Lte, limit: 100 },\n] satisfies ProgressLimitList",
        "description": "Правила смены цвета полосы в зависимости от `progress`; при `showError` игнорируются",
        "typeRefs": [
          "ProgressLimitList"
        ]
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс корневого элемента"
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "hint": {
        "type": "string",
        "required": false,
        "description": "Подсказка под полосой прогресса"
      },
      "label": {
        "type": "string",
        "required": false,
        "description": "Заголовок строки загрузки"
      },
      "progress": {
        "type": "number",
        "required": true,
        "description": "Процент загрузки от 0 до 100"
      },
      "showError": {
        "type": "boolean",
        "required": false,
        "description": "Ошибка: полоса `red`"
      },
      "showErrorIcon": {
        "type": "boolean",
        "required": false,
        "description": "Иконка в hint; показывается при `hint` и вместе с `showError`"
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "s",
          "xs"
        ],
        "defaultValue": "s",
        "description": "Размер",
        "typeRefs": [
          "ProgressBarSize"
        ]
      },
      "value": {
        "type": "string",
        "required": false,
        "description": "Дополнительный текст в заголовке (рядом с label)"
      },
      "valueType": {
        "type": "enum",
        "required": false,
        "values": [
          "none",
          "percent"
        ],
        "defaultValue": "none",
        "description": "Формат значения в заголовке: без процента (`none`) или с процентом (`percent`)",
        "typeRefs": [
          "LoadValueType"
        ]
      }
    },
    "relatedTypes": {
      "LoadValueType": {
        "kind": "union",
        "values": [
          "none",
          "percent"
        ],
        "own": true
      },
      "ProgressBarSize": {
        "kind": "union",
        "values": [
          "s",
          "xs"
        ],
        "own": false
      },
      "ProgressLimitList": {
        "kind": "alias",
        "type": "ProgressLimit[]",
        "own": true
      }
    }
  }
}
