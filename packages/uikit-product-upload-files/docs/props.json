{
  "Attachments": {
    "displayName": "Attachments",
    "propsTypeName": null,
    "props": {
      "accept": {
        "type": "UploadFilesAcceptItem[]",
        "required": true
      },
      "className": {
        "type": "string",
        "required": false
      },
      "disabled": {
        "type": "boolean",
        "required": false
      },
      "items": {
        "type": "UploadFileItem<TResult>[]",
        "required": true
      },
      "onDelete": {
        "type": "(id: string) => void",
        "required": true
      },
      "units": {
        "type": "FileSizeUnits",
        "required": true
      }
    },
    "relatedTypes": {}
  },
  "UploadFiles": {
    "displayName": "UploadFiles",
    "propsTypeName": "UploadFilesProps",
    "props": {
      "accept": {
        "type": "UploadFilesAcceptItem[]",
        "required": false,
        "defaultValue": "[{ extention: '*' }]",
        "description": "Допустимые типы файлов с иконкой для каждого расширения",
        "typeRefs": [
          "UploadFilesAcceptItem"
        ]
      },
      "attachmentClassname": {
        "type": "string",
        "required": false,
        "description": "CSS-класс прикрепленного файла"
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс корня"
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "defaultValue": {
        "type": "UploadFileItem<unknown>[]",
        "required": false,
        "description": "Начальное значение",
        "typeRefs": [
          "UploadFileItem"
        ]
      },
      "disabled": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Заблокировано"
      },
      "error": {
        "type": "string",
        "required": false,
        "description": "Ошибка формы (например required из RHF)"
      },
      "hint": {
        "type": "ReactNode",
        "required": false,
        "description": "Подсказка question tooltip у метки"
      },
      "label": {
        "type": "string",
        "required": false,
        "description": "Текст метки поля"
      },
      "maxFiles": {
        "type": "number",
        "required": false,
        "defaultValue": "3",
        "description": "Максимальное количество файлов"
      },
      "maxSize": {
        "type": "number",
        "required": false,
        "defaultValue": "5 * 1024 * 1024",
        "description": "Максимальный размер файла в байтах"
      },
      "name": {
        "type": "string",
        "required": false,
        "description": "Имя поля формы"
      },
      "onBlur": {
        "type": "FocusEventHandler<HTMLDivElement>",
        "required": false
      },
      "onChange": {
        "type": "((items: UploadFileItem<unknown>[]) => void)",
        "required": false,
        "description": "Колбэк изменения значения"
      },
      "optional": {
        "type": "boolean",
        "required": false,
        "defaultValue": "true",
        "description": "Показывает «Опционально» справа от метки"
      },
      "upload": {
        "type": "UploadFn<unknown>",
        "required": true,
        "description": "Обязательная кастомная функция загрузки",
        "typeRefs": [
          "UploadFn"
        ]
      },
      "value": {
        "type": "UploadFileItem<unknown>[]",
        "required": false,
        "description": "Контролируемое значение",
        "typeRefs": [
          "UploadFileItem"
        ]
      }
    },
    "relatedTypes": {
      "UploadFileItem": {
        "kind": "interface",
        "props": {
          "error": {
            "type": "string | undefined",
            "required": false
          },
          "file": {
            "type": "File",
            "required": true
          },
          "id": {
            "type": "string",
            "required": true
          },
          "progress": {
            "type": "number | undefined",
            "required": false
          },
          "result": {
            "type": "TResult | undefined",
            "required": false
          },
          "status": {
            "type": "\"error\" | \"success\" | \"uploading\"",
            "required": true,
            "values": [
              "error",
              "success",
              "uploading"
            ],
            "typeRefs": [
              "UploadStatus"
            ]
          }
        },
        "own": true
      },
      "UploadFilesAcceptItem": {
        "kind": "interface",
        "props": {
          "displayExtension": {
            "type": "string | undefined",
            "required": false,
            "description": "Отображаемое расширение файла для пользователя (например `PDF`)"
          },
          "extention": {
            "type": "string",
            "required": true,
            "description": "Расширение файла (например `.pdf` или `*` для всех типов файлов)"
          },
          "icon": {
            "type": "JSXElementConstructor<{ size?: number; className?: string; }> | undefined",
            "required": false,
            "description": "Иконка, отображаемая для файлов этого типа во вложениях"
          }
        },
        "own": true
      },
      "UploadFn": {
        "kind": "alias",
        "type": "(file: File, ctx: { signal: AbortSignal; }) => Promise<TResult>",
        "own": true
      },
      "UploadStatus": {
        "kind": "union",
        "values": [
          "error",
          "success",
          "uploading"
        ],
        "own": true
      }
    }
  },
  "UploadFilesDropZone": {
    "displayName": "UploadFilesDropZone",
    "propsTypeName": null,
    "props": {
      "buttonLabel": {
        "type": "string",
        "required": false
      },
      "description": {
        "type": "ReactNode",
        "required": false
      },
      "title": {
        "type": "string",
        "required": false
      }
    },
    "relatedTypes": {}
  }
}
