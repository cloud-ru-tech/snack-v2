{
  "name": "@ds/uikit-product-upload-files",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "author": "Сергей Шалагин <soshalagin@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/attachment": "workspace:^",
    "@ds/button": "workspace:^",
    "@ds/dropzone": "workspace:^",
    "@ds/fields": "workspace:^",
    "@ds/icon-predefined": "workspace:^",
    "@ds/locale": "workspace:^",
    "@ds/typography": "workspace:^",
    "@ds/utils": "workspace:^",
    "classnames": "catalog:",
    "merge-refs": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
