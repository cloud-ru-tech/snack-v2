{
  "name": "@ds/uikit-product-upload-files",
  "version": "1.0.8",
  "description": "Поле загрузки файлов с drag-and-drop, валидацией по формату/размеру/количеству и кастомной функцией upload.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloud-ru-tech/snack-v2.git",
    "directory": "packages/uikit-product-upload-files"
  },
  "homepage": "https://github.com/cloud-ru-tech/snack-v2/tree/master/packages/uikit-product-upload-files",
  "license": "Apache-2.0",
  "author": "Сергей Шалагин <soshalagin@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/attachment": "workspace:^",
    "@ds/button": "workspace:^",
    "@ds/dropzone": "workspace:^",
    "@ds/field-decorator": "workspace:^",
    "@ds/icon-predefined": "workspace:^",
    "@ds/locale": "workspace:^",
    "@ds/typography": "workspace:^",
    "@ds/utils": "workspace:^",
    "classnames": "catalog:",
    "merge-refs": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
