        "type": "() => void",
        "required": true,
        "description": "Колбек на обновление списка квот при ошибке"
      },
      "onWidgetOpen": {
        "type": "(() => void)",
        "required": false,
        "description": "Колбек открытия виджета квот"
      },
      "projectName": {
        "type": "string",
        "required": true,
        "description": "Название проекта, по которому отображаются квоты"
      },
      "quotas": {
        "type": "QuotaItem[]",
        "required": true,
        "description": "Список квот для отображения",
        "typeRefs": [
          "QuotaItem"
        ]
      },
      "quotasUrl": {
        "type": "string",
        "required": true,
        "description": "Ссылка на страницу квот по проекту"
      }
    },
    "relatedTypes": {
      "Appearance": {
        "kind": "union",
        "values": [
          "blue",
          "green",
          "neutral",
          "orange",
          "pink",
          "primary",
          "red",
          "violet",
          "yellow"
        ],
        "own": false
      },
      "ButtonProps": {
        "kind": "interface",
        "props": {
          "appearance": {
            "type": "Appearance | undefined",
            "required": false,
            "values": [
              "critical",
              "neutral",
              "primary"
            ],
            "description": "Вариант оформления",
            "typeRefs": [
              "Appearance"
            ]
          },
          "as": {
            "type": "T | undefined",
            "required": false,
            "description": "Элемент или компонент для рендера: 'button' | 'a' | ComponentType (например Link из react-router-dom)",
            "typeRefs": [
              "T"
            ]
          },
          "className": {
            "type": "string | undefined",
            "required": false,
            "description": "Дополнительный класс"
          },
          "counter": {
            "type": "Omit<CounterProps, \"size\"> | undefined",
            "required": false,
            "description": "Пропсы для counter. `appearance` можно задать явно (по умолчанию наследуется от appearance кнопки).",
            "typeRefs": [
              "CounterProps"
            ]
          },
          "data-test-id": {
            "type": "string | undefined",
            "required": false
          },
          "disabled": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Отключена"
          },
          "fullWidth": {
            "type": "boolean | undefined",
            "required": false,
            "description": "На всю ширину"
          },
          "icon": {
            "type": "string | number | boolean | ReactElement<any, string | JSXElementConstructor<any>> | Iterable<ReactNode> | ReactPortal | null | undefined",
            "required": false,
            "description": "Иконка"
          },
          "iconPosition": {
            "type": "IconPosition | undefined",
            "required": false,
            "values": [
              "after",
              "before"
            ],
            "description": "Позиция иконки относительно текста",
            "typeRefs": [
              "IconPosition"
            ]
          },
          "innerRef": {
            "type": "PolymorphicRef<T> | undefined",
            "required": false,
            "description": "Ref на реальный DOM-элемент/инстанс, который рендерится через `as`.\nИспользуем явный проп, чтобы не зависеть от `forwardRef` и не тащить type-assertions на экспорт.",
            "typeRefs": [
              "PolymorphicRef",
              "T"
            ]
          },
          "label": {
            "type": "string | undefined",
            "required": false,
            "description": "Текст кнопки"
          },
          "loading": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Состояние загрузки"
          },
          "minWidth": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Минимальная ширина контейнера (`min-width` из токена размера). По умолчанию `true`.\n`false` — кнопка сжимается по контенту вместо фиксированного минимума."
          },
          "size": {
            "type": "Size | undefined",
            "required": false,
            "values": [
              "l",
              "m",
              "s"
            ],
            "description": "Размер",
            "typeRefs": [
              "Size"
            ]
          },
          "view": {
            "type": "View | undefined",
            "required": false,
            "values": [
              "elevated",
              "filled",
              "function",
              "outline",
              "simple",
              "tonal"
            ],
            "description": "Вариант кнопки (Figma: filled, outline, function, simple, elevated)",
            "typeRefs": [
              "View"
            ]
          }
        },
        "own": false
      },
      "CounterProps": {
        "kind": "interface",
        "props": {
          "appearance": {
            "type": "Appearance | undefined",
            "required": false,
            "values": [
              "blue",
              "green",
              "neutral",
              "orange",
              "pink",
              "primary",
              "red",
              "violet",
              "yellow"
            ],
            "description": "Внешний вид",
            "typeRefs": [
              "Appearance"
            ]
          },
          "className": {
            "type": "string | undefined",
            "required": false,
            "description": "Дополнительный CSS-класс"
          },
          "color": {
            "type": "Color | undefined",
            "required": false,
            "values": [
              "accent",
              "decor"
            ],
            "description": "Семантический цвет",
            "typeRefs": [
              "Color"
            ]
          },
          "data-test-id": {
            "type": "string | undefined",
            "required": false
          },
          "innerRef": {
            "type": "Ref<HTMLDivElement> | undefined",
            "required": false,
            "description": "Ref на корневой DOM-элемент.\nИспользуем явный проп, чтобы не зависеть от `forwardRef` и не тащить type-assertions на экспорт."
          },
          "plusLimit": {
            "type": "number | undefined",
            "required": false,
            "description": "Порог сокращения значения для варианта `count-plus`"
          },
          "size": {
            "type": "Size | undefined",
            "required": false,
            "values": [
              "s",
              "xs"
            ],
            "description": "Размер",
            "typeRefs": [
              "Size"
            ]
          },
          "value": {
            "type": "number",
            "required": true,
            "description": "Значение"
          },
          "variant": {
            "type": "Variant | undefined",
            "required": false,
            "values": [
              "count",
              "count-k",
              "count-plus"
            ],
            "description": "Вариант форматирования",
            "typeRefs": [
              "Variant"
            ]
          }
        },
        "own": false
      },
      "IconPosition": {
        "kind": "union",
        "values": [
          "after",
          "before"
        ],
        "own": false
      },
      "PolymorphicRef": {
        "kind": "alias",
        "type": "ComponentPropsWithRef<T>[\"ref\"]",
        "own": false
      },
      "QuotaItem": {
        "kind": "interface",
        "props": {
          "limit": {
            "type": "number",
            "required": true,
            "description": "Лимит квоты"
          },
          "name": {
            "type": "string",
            "required": true,
            "description": "Название квоты"
          },
          "remains": {
            "type": "number",
            "required": true,
            "description": "Остаток квоты"
          },
          "unitDisplayName": {
            "type": "string",
            "required": true,
            "description": "Единица измерения квоты"
          },
          "usage": {
            "type": "number",
            "required": true,
            "description": "Потребление квоты"
          }
        },
        "own": true
      },
      "Size": {
        "kind": "union",
        "values": [
          "s",
          "xs"
        ],
        "own": false
      },
      "View": {
        "kind": "union",
        "values": [
          "elevated",
          "filled",
          "function",
          "outline",
          "simple",
          "tonal"
        ],
        "own": false
      }
    }
  },
