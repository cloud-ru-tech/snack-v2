{
  "name": "@ds/uikit-product-quota",
  "version": "1.0.1",
  "license": "Apache-2.0",
  "author": "Robert Kuzhin <rikuzhin@cloud.ru>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./locale": {
      "source": "./src/locale/index.ts",
      "types": "./dist/esm/locale/index.d.ts",
      "import": "./dist/esm/locale/index.js",
      "require": "./dist/cjs/locale/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@ds/accordion": "workspace:^",
    "@ds/button": "workspace:^",
    "@ds/counter": "workspace:^",
    "@ds/divider": "workspace:^",
    "@ds/dropdown": "workspace:^",
    "@ds/icons": "workspace:^",
    "@ds/info-block": "workspace:^",
    "@ds/locale": "workspace:^",
    "@ds/progress-bar": "workspace:^",
    "@ds/scroll": "workspace:^",
    "@ds/skeleton": "workspace:^",
    "@ds/tooltip": "workspace:^",
    "@ds/truncate-string": "workspace:^",
    "@ds/typography": "workspace:^",
    "@ds/uikit-product-title-clickable": "workspace:^",
    "@ds/utils": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
