{
  "name": "@ds/materials",
  "version": "1.1.3",
  "license": "Apache-2.0",
  "author": "Ilya Belyavskiy <iabelyavskiy@cloud.ru>",
  "type": "module",
  "description": "SCSS materials (acrylic, stateLayer) для дизайн-системы",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "sass": "./index.scss",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "index.scss",
    "src",
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@ds/utils": "workspace:^"
  },
  "devDependencies": {
    "classnames": "catalog:"
  },
  "sideEffects": [
    "**/*.scss"
  ],
  "publishConfig": {
    "access": "public"
  }
}
