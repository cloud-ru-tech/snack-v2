{
  "Divider": {
    "displayName": "Divider",
    "propsTypeName": "DividerProps",
    "description": "Divider — разделитель контента.\n\nПоддерживает:\n- Два варианта цвета: default (обычный фон) и onComplementary (инвертированный фон)\n- Две ориентации: горизонтальная (по умолчанию) и вертикальная\n- Два варианта толщины: regular (1px) и thin (0.5px)\n- Семантику ARIA: role=\"separator\" + aria-orientation",
    "props": {
      "appearance": {
        "type": "enum",
        "required": false,
        "values": [
          "default",
          "onComplementary"
        ],
        "defaultValue": "default",
        "description": "Цвет линии: default — на обычном фоне, onComplementary — на инвертированном. По умолчанию: default",
        "typeRefs": [
          "DividerAppearance"
        ]
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс"
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "orientation": {
        "type": "enum",
        "required": false,
        "values": [
          "horizontal",
          "vertical"
        ],
        "defaultValue": "horizontal",
        "description": "Ориентация: горизонтальная или вертикальная. По умолчанию: horizontal",
        "typeRefs": [
          "DividerOrientation"
        ]
      },
      "variant": {
        "type": "enum",
        "required": false,
        "values": [
          "regular",
          "thin"
        ],
        "defaultValue": "regular",
        "description": "Вариант толщины линии (regular: 1px, thin: 0.5px). По умолчанию: regular",
        "typeRefs": [
          "DividerVariant"
        ]
      }
    },
    "relatedTypes": {
      "DividerAppearance": {
        "kind": "union",
        "values": [
          "default",
          "onComplementary"
        ],
        "own": true
      },
      "DividerOrientation": {
        "kind": "union",
        "values": [
          "horizontal",
          "vertical"
        ],
        "own": true
      },
      "DividerVariant": {
        "kind": "union",
        "values": [
          "regular",
          "thin"
        ],
        "own": true
      }
    }
  }
