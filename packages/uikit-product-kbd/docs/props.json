{
  "Kbd": {
    "displayName": "Kbd",
    "propsTypeName": "KbdProps",
    "props": {
      "aria-label": {
        "type": "string",
        "required": false,
        "description": "Название клавиши для скринридера, если видимый символ его не передаёт (`↵` → `Enter`)."
      },
      "children": {
        "type": "ReactNode",
        "required": false,
        "description": "Клавиша: текст или unicode-символ (`K`, `/`, `F1`). Игнорируется, если задан `keyName`."
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "Дополнительный CSS-класс"
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "innerRef": {
        "type": "Ref<HTMLElement>",
        "required": false,
        "description": "Ref на корневой `<kbd>`"
      },
      "keyName": {
        "type": "enum",
        "required": false,
        "values": [
          "alt",
          "ctrl",
          "down",
          "enter",
          "esc",
          "left",
          "meta",
          "mod",
          "right",
          "shift",
          "up"
        ],
        "description": "Предопределённая клавиша: символ и доступное название берутся из карты.\nМодификаторы зависят от ОС: `mod` — `⌘` на macOS и `Ctrl` на остальных.",
        "typeRefs": [
          "KbdKeyName"
        ]
      },
      "platform": {
        "type": "enum",
        "required": false,
        "values": [
          "mac",
          "other"
        ],
        "description": "Платформа для `keyName`. По умолчанию определяется по user-agent.",
        "typeRefs": [
          "KbdPlatform"
        ]
      }
    },
    "relatedTypes": {
      "KbdKeyName": {
        "kind": "union",
        "values": [
          "alt",
          "ctrl",
          "down",
          "enter",
          "esc",
          "left",
          "meta",
          "mod",
          "right",
          "shift",
          "up"
        ],
        "own": true
      },
      "KbdPlatform": {
        "kind": "union",
        "values": [
          "mac",
          "other"
        ],
        "own": true
      }
    }
  },
  "KbdShortcut": {
    "displayName": "KbdShortcut",
    "propsTypeName": "KbdShortcutProps",
    "props": {
      "aria-label": {
        "type": "string",
        "required": false,
        "description": "Название сочетания для скринридера. По умолчанию собирается из названий клавиш: «Command + K»."
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "Дополнительный CSS-класс"
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "innerRef": {
        "type": "Ref<HTMLElement>",
        "required": false,
        "description": "Ref на корневой `<kbd>`"
      },
      "keys": {
        "type": "KbdShortcutKey[]",
        "required": true,
        "description": "Клавиши сочетания по порядку. Значение `keyName` (`mod`, `shift`, `enter`, …) резолвится по ОС,\nостальное выводится текстом (`K`, `/`, `F1`).",
        "typeRefs": [
          "KbdShortcutKey"
        ]
      },
      "platform": {
        "type": "enum",
        "required": false,
        "values": [
          "mac",
          "other"
        ],
        "description": "Платформа для клавиш из `keyName`. По умолчанию определяется по user-agent.",
        "typeRefs": [
          "KbdPlatform"
        ]
      }
    },
    "relatedTypes": {
      "KbdPlatform": {
        "kind": "union",
        "values": [
          "mac",
          "other"
        ],
        "own": true
      },
      "KbdShortcutKey": {
        "kind": "alias",
        "type": "KbdKeyName | (string & Record<never, never>)",
        "own": true
      }
    }
  }
}
