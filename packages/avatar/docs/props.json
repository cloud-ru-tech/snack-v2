{
  "Avatar": {
    "displayName": "Avatar",
    "propsTypeName": "AvatarProps",
    "description": "Компонент отображения аватара пользователя.\n\nПоддерживает:\n- Отображение изображения аватара (с fallback на аббревиатуру)\n- Генерацию аббревиатуры из имени пользователя (1 или 2 символа)\n- Различные размеры: xs, s, m, l, 3xl, 6xl, 9xl\n- Различные формы: круглая (rounded) или квадратная (squared)\n- Различные цветовые схемы: neutral, red, orange, yellow, green, blue, violet, pink\n- Слот `badge` (любой ReactNode) и шорткат `status` для дефолтного `StatusIndicator`",
    "props": {
      "appearance": {
        "type": "enum",
        "required": false,
        "values": [
          "blue",
          "green",
          "neutral",
          "orange",
          "pink",
          "red",
          "violet",
          "yellow"
        ],
        "defaultValue": "neutral",
        "description": "Внешний вид (цвет)",
        "typeRefs": [
          "Appearance"
        ]
      },
      "badge": {
        "type": "ReactNode",
        "required": false,
        "description": "Произвольный нод в слот значка (правый-нижний угол). Перекрывает `status`."
      },
      "children": {
        "type": "string | number | boolean | ReactElement<any, string | JSXElementConstructor<any>> | Iterable<ReactNode> | ReactPortal | null | undefined",
        "required": false
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс"
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "name": {
        "type": "string",
        "required": true,
        "description": "Имя пользователя для генерации аббревиатуры"
      },
      "shape": {
        "type": "enum",
        "required": false,
        "values": [
          "rounded",
          "squared"
        ],
        "defaultValue": "rounded",
        "description": "Форма: круглая или квадратная",
        "typeRefs": [
          "Shape"
        ]
      },
      "showTwoSymbols": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Отображение двух заглавных символов имени вместо одного"
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "3xl",
          "6xl",
          "9xl",
          "l",
          "m",
          "s",
          "xs"
        ],
        "defaultValue": "m",
        "description": "Размер",
        "typeRefs": [
          "Size"
        ]
      },
      "src": {
        "type": "string",
        "required": false,
        "description": "URL изображения аватара"
      },
      "status": {
        "type": "enum",
        "required": false,
        "values": [
          "blue",
          "green",
          "neutral",
          "orange",
          "pink",
          "red",
          "violet",
          "yellow"
        ],
        "description": "Appearance дефолтного `StatusIndicator` в правом-нижнем углу. Размер\nиндикатора подбирается из `size` аватара автоматически. Полностью\nнастроить значок можно через слот `badge`, который перекрывает `status`.",
        "typeRefs": [
          "StatusAppearance"
        ]
      }
    },
    "relatedTypes": {
      "Appearance": {
        "kind": "union",
        "values": [
          "blue",
          "green",
          "neutral",
          "orange",
          "pink",
          "red",
          "violet",
          "yellow"
        ],
        "own": true
      },
      "Shape": {
        "kind": "union",
        "values": [
          "rounded",
          "squared"
        ],
        "own": true
      },
      "Size": {
        "kind": "union",
        "values": [
          "3xl",
          "6xl",
          "9xl",
          "l",
          "m",
          "s",
          "xs"
        ],
        "own": true
      },
      "StatusAppearance": {
        "kind": "union",
        "values": [
          "blue",
          "green",
          "loading",
          "neutral",
          "orange",
          "pink",
          "primary",
          "red",
          "violet",
          "yellow"
        ],
        "own": false
      }
    }
  }
}
