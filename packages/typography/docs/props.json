        "values": [
          "l",
          "m",
          "s"
        ],
        "own": true
      },
      "TypographyVariant": {
        "kind": "union",
        "values": [
          "body",
          "display",
          "headline",
          "label",
          "title"
        ],
        "own": true
      },
      "TypographyWeight": {
        "kind": "union",
        "values": [
