        "description": "HTML тег для рендеринга"
      },
      "children": {
        "type": "ReactNode",
        "required": false,
        "description": "Дочерние элементы"
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс"
      },
      "data-test-id": {
        "type": "string",
        "required": false,
        "description": "Стабильный идентификатор для e2e/tests"
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "l",
          "m",
          "s"
