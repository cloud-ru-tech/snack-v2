{
  "Button": {
    "displayName": "Button",
    "props": {
      "variant": {
        "type": "enum",
        "required": false,
        "values": [
          "primary",
          "secondary",
          "danger",
          "ghost"
        ],
        "defaultValue": "primary"
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "sm",
          "md",
          "lg"
        ],
        "defaultValue": "md"
      },
      "loading": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false"
      },
      "disabled": {
        "type": "boolean",
        "required": false,
        "description": "Disables all interaction"
      }
    }
  }
}
