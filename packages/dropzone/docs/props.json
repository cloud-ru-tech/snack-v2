{
  "Dropzone": {
    "displayName": "Dropzone",
    "propsTypeName": "DropzoneProps",
    "description": "Компонент — видимая зона для drag-n-drop загрузки файлов",
    "props": {
      "accept": {
        "type": "string",
        "required": false,
        "description": "Показывает пользователю в открывшемся диалоговом окне файлы типов, которые вы указываете в значении атрибута"
      },
      "children": {
        "type": "ReactNode",
        "required": false,
        "description": "Контент dropzone"
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс"
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "disabled": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Деактивирован ли компонент"
      },
      "mode": {
        "type": "enum",
        "required": false,
        "values": [
          "multiple",
          "single"
        ],
        "defaultValue": "multiple",
        "description": "Режим загрузки",
        "typeRefs": [
          "UploadMode"
        ]
      },
      "onFilesUpload": {
        "type": "(files: File[]) => void",
        "required": true,
        "description": "Колбек загрузки файла",
        "typeRefs": [
          "onFilesUpload"
        ]
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "l",
          "m",
          "s"
        ],
        "defaultValue": "m",
        "description": "Размер компонента",
        "typeRefs": [
          "Size"
        ]
      }
    },
    "relatedTypes": {
      "Size": {
        "kind": "union",
        "values": [
          "l",
          "m",
          "s"
        ],
        "own": true
      },
      "UploadMode": {
