{
  "PrivateDropZone": {
    "displayName": "PrivateDropZone",
    "props": {
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "isOver": {
        "type": "boolean",
        "required": true
      },
      "onFilesUpload": {
        "type": "(files: File[]) => void",
        "required": true,
        "description": "Колбек загрузки файла"
      },
      "children": {
        "type": "ReactNode",
        "required": false,
        "description": "Контент dropzone"
      },
      "disabled": {
        "type": "boolean",
        "required": false,
        "defaultValue": "false",
        "description": "Деактивирован ли компонент"
      },
      "mode": {
        "type": "enum",
        "required": false,
        "values": [
          "single",
          "multiple"
        ],
        "defaultValue": "multiple",
        "description": "Режим"
      },
      "accept": {
        "type": "string",
        "required": false,
        "description": "Показывает пользователю в открывшемся диалоговом окне файлы типов, которые вы указываете в значении атрибута"
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "s",
          "m",
          "l"
        ],
        "defaultValue": "m",
        "description": "Размер компонента"
      },
      "className": {
        "type": "string",
        "required": false,
        "description": "CSS-класс"
      }
    }
  },
