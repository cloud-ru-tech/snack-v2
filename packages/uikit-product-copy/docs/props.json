{
  "CopyButton": {
    "displayName": "CopyButton",
    "propsTypeName": "CopyButtonProps",
    "props": {
      "className": {
        "type": "string",
        "required": false,
        "description": "Дополнительный класс."
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "label": {
        "type": "string",
        "required": false,
        "description": "Текст рядом с иконкой. Если не задан — кнопка отображается только с иконкой."
      },
      "onClick": {
        "type": "MouseEventHandler<HTMLButtonElement>",
        "required": false,
        "description": "Доп. обработчик клика."
      },
      "size": {
        "type": "enum",
        "required": false,
        "values": [
          "l",
          "m",
          "s"
        ],
        "defaultValue": "m",
        "description": "Размер кнопки (s / m / l). По-умолчанию s.",
        "typeRefs": [
          "ButtonProps"
        ]
      },
      "valueToCopy": {
        "type": "string | number",
        "required": true,
        "description": "Значение для копирования в буфер."
      }
    },
    "relatedTypes": {
      "Appearance": {
        "kind": "union",
        "values": [
          "blue",
          "green",
          "neutral",
          "orange",
          "pink",
          "primary",
          "red",
          "violet",
          "yellow"
        ],
        "own": false
      },
      "ButtonProps": {
        "kind": "interface",
        "props": {
          "appearance": {
            "type": "Appearance | undefined",
            "required": false,
            "values": [
              "critical",
              "neutral",
              "primary"
            ],
            "description": "Вариант оформления",
            "typeRefs": [
              "Appearance"
            ]
          },
          "as": {
            "type": "T | undefined",
            "required": false,
            "description": "Элемент или компонент для рендера: 'button' | 'a' | ComponentType (например Link из react-router-dom)",
            "typeRefs": [
              "T"
            ]
          },
          "className": {
            "type": "string | undefined",
            "required": false,
            "description": "Дополнительный класс"
          },
          "counter": {
            "type": "Omit<CounterProps, \"size\" | \"appearance\"> | undefined",
            "required": false,
            "description": "Пропсы для counter",
            "typeRefs": [
              "CounterProps"
            ]
          },
          "data-test-id": {
            "type": "string | undefined",
            "required": false
          },
          "disabled": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Отключена"
          },
          "fullWidth": {
            "type": "boolean | undefined",
            "required": false,
            "description": "На всю ширину"
          },
          "icon": {
            "type": "string | number | boolean | ReactElement<any, string | JSXElementConstructor<any>> | Iterable<ReactNode> | ReactPortal | null | undefined",
            "required": false,
            "description": "Иконка"
          },
          "iconPosition": {
            "type": "IconPosition | undefined",
            "required": false,
            "values": [
              "after",
              "before"
            ],
            "description": "Позиция иконки относительно текста",
            "typeRefs": [
              "IconPosition"
            ]
          },
          "innerRef": {
            "type": "PolymorphicRef<T> | undefined",
            "required": false,
            "description": "Ref на реальный DOM-элемент/инстанс, который рендерится через `as`.\nИспользуем явный проп, чтобы не зависеть от `forwardRef` и не тащить type-assertions на экспорт.",
            "typeRefs": [
              "PolymorphicRef",
              "T"
            ]
          },
          "label": {
            "type": "string | undefined",
            "required": false,
            "description": "Текст кнопки"
          },
          "loading": {
            "type": "boolean | undefined",
            "required": false,
            "description": "Состояние загрузки"
          },
          "size": {
            "type": "Size | undefined",
            "required": false,
            "values": [
              "l",
              "m",
              "s"
            ],
            "description": "Размер",
            "typeRefs": [
              "Size"
            ]
          },
          "view": {
            "type": "View | undefined",
            "required": false,
            "values": [
              "elevated",
              "filled",
              "function",
              "outline",
              "simple",
              "tonal"
            ],
            "description": "Вариант кнопки (Figma: filled, outline, function, simple, elevated)",
            "typeRefs": [
              "View"
            ]
          }
        },
        "own": false
      },
      "CounterProps": {
        "kind": "interface",
        "props": {
          "appearance": {
            "type": "Appearance | undefined",
            "required": false,
            "values": [
              "blue",
              "green",
              "neutral",
              "orange",
              "pink",
              "primary",
              "red",
              "violet",
              "yellow"
            ],
            "description": "Внешний вид",
            "typeRefs": [
              "Appearance"
            ]
          },
          "className": {
            "type": "string | undefined",
            "required": false,
            "description": "Дополнительный CSS-класс"
          },
          "color": {
            "type": "Color | undefined",
            "required": false,
            "values": [
              "accent",
              "decor"
            ],
            "description": "Семантический цвет",
            "typeRefs": [
              "Color"
            ]
          },
          "data-test-id": {
            "type": "string | undefined",
            "required": false
          },
          "plusLimit": {
            "type": "number | undefined",
            "required": false,
            "description": "Порог сокращения значения для варианта `count-plus`"
          },
          "size": {
            "type": "Size | undefined",
            "required": false,
            "values": [
              "s",
              "xs"
            ],
            "description": "Размер",
            "typeRefs": [
              "Size"
            ]
          },
          "value": {
            "type": "number",
            "required": true,
            "description": "Значение"
          },
          "variant": {
            "type": "Variant | undefined",
            "required": false,
            "values": [
              "count",
              "count-k",
              "count-plus"
            ],
            "description": "Вариант форматирования",
            "typeRefs": [
              "Variant"
            ]
          }
        },
        "own": false
      },
      "IconPosition": {
        "kind": "union",
        "values": [
          "after",
          "before"
        ],
        "own": false
      },
      "PolymorphicRef": {
        "kind": "alias",
        "type": "ComponentPropsWithRef<T>[\"ref\"]",
        "own": false
      },
      "Size": {
        "kind": "union",
        "values": [
          "s",
          "xs"
        ],
        "own": false
      },
      "View": {
        "kind": "union",
        "values": [
          "elevated",
          "filled",
          "function",
          "outline",
          "simple",
          "tonal"
        ],
        "own": false
      }
    }
  },
  "CopyLine": {
    "displayName": "CopyLine",
    "propsTypeName": "CopyLineProps",
    "props": {
      "className": {
        "type": "string",
        "required": false,
        "description": "Дополнительный класс корневого элемента."
      },
      "content": {
        "type": "ReactNode",
        "required": true,
        "description": "Отображаемое содержимое. Если это строка/число — автоматически truncated и используется как значение для копирования по-умолчанию."
      },
      "copyButtonHideStrategy": {
        "type": "enum",
        "required": false,
        "values": [
          "hover",
          "never"
        ],
        "defaultValue": "hover",
        "description": "Стратегия показа кнопки копирования: hover — только по наведению, never — всегда.",
        "typeRefs": [
          "CopyButtonHideStrategy"
        ]
      },
      "data-test-id": {
        "type": "string",
        "required": false
      },
      "onClick": {
        "type": "MouseEventHandler<HTMLDivElement>",
        "required": false,
        "description": "Обработчик клика по строке."
      },
      "valueToCopy": {
        "type": "string | number",
        "required": false,
        "description": "Значение, которое попадёт в буфер при клике. По-умолчанию равно content, если он string/number."
      }
    },
    "relatedTypes": {
      "CopyButtonHideStrategy": {
        "kind": "union",
        "values": [
          "hover",
          "never"
        ],
        "own": true
      }
    }
  }
}
