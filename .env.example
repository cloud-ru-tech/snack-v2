# Переменные окружения для тестирования

# Локальное тестирование (true - запуск локально, false - на CI)
TEST_LOCAL=true

# URL для тестирования Storybook (если не локально)
# Если не установлен или TEST_LOCAL=true, используется http://localhost:6006/
UIKIT_SNACK_URL=

# Тестирование на конкретной ветке
# Если true, будет использоваться текущая git-ветка для HTTP заголовков
TEST_ON_BRANCH=false

# Имя ветки для тестирования (альтернатива автоопределению)
BRANCH_NAME=

# CI окружение (автоматически устанавливается в CI/CD)
CI=false

# Количество воркеров для Playwright в CI
# Может быть числом (например, 2) или процентом (например, 50%)
PW_CI_WORKERS=2

# Пропускает visual.spec.ts на CI (расхождение
# macOS↔Linux font-rendering). Любое непустое значение включает.
SKIP_VISUAL=

# === Docker e2e (Linux baselines с Mac) ===
# Образ по умолчанию: snack-v2-e2e:local, собирается из docker/e2e/Dockerfile
# (bookworm + вшитый chromium; на рантайме браузер не докачивается).
# DOCKER_E2E_IMAGE=  — override образа (пропускает docker build; напр. готовый CI-образ)
# DOCKER_E2E_NO_BUILD_IMAGE=1  — не пересобирать локальный образ (взять уже собранный тег)
# linux/amd64 — как типичный CI; пустая строка = нативная arch хоста
# DOCKER_E2E_PLATFORM=linux/amd64
# DOCKER_E2E_INSTALL=0
# DOCKER_E2E_BUILD_PACKAGES=1  — форсить build:packages (по умолчанию НЕ собирается: storybook
#   static резолвит @ds/* → packages/<pkg>/src через алиасы, dist не нужен)
# DOCKER_E2E_SKIP_STORYBOOK_BUILD=1  — не пересобирать static (build:storybook); только http-server
# Путь к npmrc с токеном Artifactory (default ~/.npmrc); монтируется read-only в контейнер
# DOCKER_E2E_NPMRC=~/.npmrc


# Токен фигмы для получения свойств в scss переменных
FIGMA_API=


# Personal Access Token (scope: read_api, read_repository)
GITLAB_TOKEN=

# Базовый URL GitLab API (со слэшем в конце)
GITLAB_BASE_URL=https://git.sbercloud.tech/api/v4/


# === Coverage ===

# Включает сбор coverage: Playwright fixture (playwright/fixtures.ts) снимает V8-coverage
# через page.coverage (CDP) и конвертит в istanbul по sourcemaps чистого storybook-билда —
# инструментация кода (istanbul/INSTRUMENT) больше не нужна.
# Локально передаётся точечно (`COVERAGE=true pnpm exec playwright test ...`),
# в CI обычно ставится на job.
COVERAGE=false

# Regex для harvester'а play-функций (playwright/coverage/play-functions.spec.ts):
# фильтрует stories по storyId / importPath. Без значения — все 280+ stories.
# Примеры: '^components-(button|drawer)' | 'avatar|tag' | 'uikit-product'
STORIES_FILTER=

# Порт storybook-static для coverage-serve.mts. По умолчанию 6006.
STORYBOOK_PORT=6006
