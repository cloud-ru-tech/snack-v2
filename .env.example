# Переменные окружения для тестирования

# Локальное тестирование (true - запуск локально, false - на CI)
TEST_LOCAL=true

# URL для тестирования Storybook (если не локально)
# Если не установлен или TEST_LOCAL=true, используется http://localhost:6006/
UIKIT_SNACK_URL=

# Тестирование на конкретной ветке
# Если true, будет использоваться текущая git-ветка для HTTP заголовков
TEST_ON_BRANCH=false

# Имя ветки для тестирования (альтернатива автоопределению)
BRANCH_NAME=

# CI окружение (автоматически устанавливается в CI/CD)
CI=false

# Количество воркеров для Playwright в CI
# Может быть числом (например, 2) или процентом (например, 50%)
PW_CI_WORKERS=2

# FF-8488 (temp): пропускает visual.spec.ts на CI (расхождение
# macOS↔Linux font-rendering). Любое непустое значение включает.
SKIP_VISUAL=


# Токен фигмы для получения свойств в scss переменных
FIGMA_API=


# Personal Access Token (scope: read_api, read_repository)
GITLAB_TOKEN=

# Базовый URL GitLab API (со слэшем в конце)
GITLAB_BASE_URL=https://git.sbercloud.tech/api/v4/


# === Coverage ===

# Включает сбор coverage: storybook (через INSTRUMENT=true) сериует инструментированный
# код, Playwright fixture дампит window.__coverage__ после каждого теста.
# Локально передаётся точечно (`COVERAGE=true pnpm exec playwright test ...`),
# в CI обычно ставится на job.
COVERAGE=false

# Включает vite-plugin-istanbul в storybook viteFinal. Нужен для dev:coverage
# и для CI-сборки инструментированного static-билда (см. scripts/coverage-serve.mts).
INSTRUMENT=false

# Regex для harvester'а play-функций (playwright/coverage/play-functions.spec.ts):
# фильтрует stories по storyId / importPath. Без значения — все 280+ stories.
# Примеры: '^components-(button|drawer)' | 'avatar|tag' | 'uikit-product'
STORIES_FILTER=

# Порт инструментированного storybook (для coverage-serve.mts). По умолчанию 6006.
STORYBOOK_PORT=6006
