{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "#storybook/components": [".storybook/components/index.ts"],
      "#storybook/components/*": [".storybook/components/*"],
      "#storybook/hooks": [".storybook/hooks/index.ts"],
      "#storybook/hooks/*": [".storybook/hooks/*"],
      "#docs/lib/figma": ["../docs/src/lib/figma.ts"],
      "@ds/*/locale": ["../../packages/*/src/locale"],
      "@ds/*": ["../../packages/*/src"]
    }
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "stories/**/*.ts",
    "stories/**/*.tsx",
    "../../types/**/*.d.ts",
    "../docs/src/lib/figma.ts",
    "../docs/src/config/categories.ts",
    "../docs/src/config/external-links.ts",
    "../docs/src/config/domains.ts",
    "../../packages/*/src/**/*.ts",
    "../../packages/*/src/**/*.tsx",
    "../../packages/*/stories/**/*.ts",
    "../../packages/*/stories/**/*.tsx"
  ],
  "exclude": ["node_modules", "storybook-static"]
}
