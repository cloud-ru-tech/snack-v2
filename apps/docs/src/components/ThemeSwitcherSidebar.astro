---
/**
 * Компактная версия переключателя темы для sidebar
 */
---

<div class="theme-switcher-sidebar">
  <details class="theme-details">
    <summary class="theme-summary">
      <span class="theme-icon">🎨</span>
      <span class="theme-text">Тема</span>
    </summary>
    
    <div class="theme-controls">
      <label class="theme-control">
        <select id="theme-select-sidebar" class="theme-select">
          <option value="light">☀️ Светлая</option>
          <option value="dark">🌙 Темная</option>
        </select>
      </label>

      <label class="theme-control">
        <select id="brand-select-sidebar" class="theme-select">
          <option value="brandA">Brand A</option>
          <option value="brandB">Brand B</option>
        </select>
      </label>

      <label class="theme-control">
        <select id="platform-select-sidebar" class="theme-select">
          <option value="desktop">🖥️ Desktop</option>
          <option value="mobile">📱 Mobile</option>
        </select>
      </label>
    </div>
  </details>
</div>

<style>
  .theme-switcher-sidebar {
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .theme-details {
    width: 100%;
  }

  .theme-summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    padding: 0.5rem;
    border-radius: 0.25rem;
    transition: background-color 0.2s;
    user-select: none;
  }

  .theme-summary::-webkit-details-marker {
    display: none;
  }

  .theme-summary::marker {
    display: none;
  }

  .theme-summary:hover {
    background: var(--sl-color-gray-6);
  }

  .theme-icon {
    font-size: 1.2em;
  }

  .theme-text {
    flex: 1;
    font-weight: 500;
    color: var(--sl-color-text);
    font-size: 0.875rem;
  }

  .theme-details[open] .theme-summary {
    margin-bottom: 0.5rem;
  }

  .theme-controls {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.5rem;
  }

  .theme-control {
    display: block;
    width: 100%;
  }

  .theme-select {
    width: 100%;
    padding: 0.375rem 0.5rem;
    border-radius: 0.25rem;
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-size: 0.8125rem;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .theme-select:hover {
    border-color: var(--sl-color-text-accent);
  }

  .theme-select:focus {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
</style>

<script>
  // Инициализация переключателя темы
  function initThemeSwitcherSidebar() {
    // Получаем глобальный менеджер темы
    const manager = (window as any).snThemeManager;
    if (!manager) {
      console.warn('Theme manager not found');
      return;
    }

    // Получаем элементы
    const themeSelect = document.getElementById('theme-select-sidebar') as HTMLSelectElement;
    const brandSelect = document.getElementById('brand-select-sidebar') as HTMLSelectElement;
    const platformSelect = document.getElementById('platform-select-sidebar') as HTMLSelectElement;

    if (!themeSelect || !brandSelect || !platformSelect) {
      return;
    }

    // Устанавливаем текущие значения
    themeSelect.value = manager.getTheme();
    brandSelect.value = manager.getBrand();
    platformSelect.value = manager.getPlatform();

    // Слушаем изменения
    themeSelect.addEventListener('change', (e) => {
      manager.setTheme((e.target as HTMLSelectElement).value);
    });

    brandSelect.addEventListener('change', (e) => {
      manager.setBrand((e.target as HTMLSelectElement).value);
    });

    platformSelect.addEventListener('change', (e) => {
      manager.setPlatform((e.target as HTMLSelectElement).value);
    });

    // Слушаем изменения от других источников
    window.addEventListener('themeChange', ((e: CustomEvent) => {
      themeSelect.value = e.detail.value;
    }) as EventListener);

    window.addEventListener('brandChange', ((e: CustomEvent) => {
      brandSelect.value = e.detail.value;
    }) as EventListener);

    window.addEventListener('platformChange', ((e: CustomEvent) => {
      platformSelect.value = e.detail.value;
    }) as EventListener);
  }

  // Инициализация после загрузки DOM
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemeSwitcherSidebar);
  } else {
    initThemeSwitcherSidebar();
  }

  // Реинициализация при навигации (для SPA режима Astro)
  document.addEventListener('astro:page-load', initThemeSwitcherSidebar);
</script>
