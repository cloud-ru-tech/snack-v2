---
interface Props {
  storyId: string;
  height?: string;
  width?: string;
}

const { storyId, height = '420px', width = '100%' } = Astro.props;

// Determine Storybook base URL based on environment
const getStorybookBaseUrl = () => {
  // In production/GitLab Pages, use relative path with base URL
  // Astro sets import.meta.env.PROD in production builds
  if (import.meta.env.PROD) {
    const base = import.meta.env.BASE_URL;
    const storybookPath = 'storybook';
    // Normalize base path and combine with storybook path
    return base.endsWith('/') ? `${base}${storybookPath}` : `${base}/${storybookPath}`;
  }
  // In dev, use localhost
  return 'http://localhost:6006';
};

const baseUrl = getStorybookBaseUrl();
const iframeUrl = `${baseUrl}/iframe.html?id=${storyId}&viewMode=story`;
---

<iframe
  src={iframeUrl}
  style={{
    width,
    height,
    border: '1px solid var(--sl-color-hairline, #e2e8f0)',
    borderRadius: '12px',
    background: 'var(--sl-color-bg, #fff)',
  }}
  loading="lazy"
  allow="clipboard-write"
  class="storybook-iframe"
  data-story-id={storyId}
/>

<script>
  /**
   * Синхронизация темы между документацией и Storybook iframe
   */
  function syncThemeWithIframes() {
    const manager = (window as any).snThemeManager;
    if (!manager) return;

    // Находим все iframe со Storybook
    const iframes = document.querySelectorAll('iframe.storybook-iframe');
    
    iframes.forEach((iframe) => {
      // Отправляем текущую тему при загрузке iframe
      iframe.addEventListener('load', () => {
        try {
          (iframe as HTMLIFrameElement).contentWindow?.postMessage(
            {
              type: 'theme-sync',
              theme: manager.getTheme(),
              brand: manager.getBrand(),
              platform: manager.getPlatform(),
            },
            '*'
          );
        } catch (error) {
          // Cross-origin iframe, игнорируем
        }
      });
    });

    // Слушаем изменения темы и передаем в iframe
    const syncHandler = () => {
      iframes.forEach((iframe) => {
        try {
          (iframe as HTMLIFrameElement).contentWindow?.postMessage(
            {
              type: 'theme-sync',
              theme: manager.getTheme(),
              brand: manager.getBrand(),
              platform: manager.getPlatform(),
            },
            '*'
          );
        } catch (error) {
          // Cross-origin iframe, игнорируем
        }
      });
    };

    window.addEventListener('themeChange', syncHandler);
    window.addEventListener('brandChange', syncHandler);
    window.addEventListener('platformChange', syncHandler);
  }

  // Инициализация
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncThemeWithIframes);
  } else {
    syncThemeWithIframes();
  }

  // Реинициализация при навигации (для SPA режима Astro)
  document.addEventListener('astro:page-load', syncThemeWithIframes);
</script>
