---
import { buildNav } from '../lib/discovery'
import { DOMAINS } from '../config/domains'
import { NavTree } from './layout/NavTree'

const PATTERNS_DESCRIPTION = 'Гайды и паттерны проектирования: как собирать сценарии из компонентов, контрибьютить, стандарты и процессы.'

// Описания групп для QuestionTooltip: домены из конфига + псевдо-группа patterns.
const descriptions: Record<string, string> = {}
for (const d of DOMAINS) {
  if (d.description) descriptions[d.id] = d.description
}
descriptions.patterns = PATTERNS_DESCRIPTION

const nav = await buildNav()
const currentPath = Astro.url.pathname
---

<!-- client:only: @ds/tree использует react-transition-state (CJS), который не SSR-ится под Astro prerender.
     transition:persist переносит остров между переходами без ремоунта; на обёртке <aside> его держать нельзя —
     атомарный moveBefore Astro падает с HierarchyRequestError. -->
<NavTree client:only="react" transition:persist nav={nav} descriptions={descriptions} currentPath={currentPath}>
  <!-- SSR-fallback: заполняет место до гидрации острова. -->
  <div slot="fallback" class="nav-skeleton" aria-hidden="true">
    {Array.from({ length: 14 }).map((_, i) => (
      <span class="nav-skeleton-row" data-kind={i % 5 === 0 ? 'group' : 'item'} />
    ))}
  </div>
</NavTree>

<style lang="scss">
  @use '@sbercloud/figma-variables/build/scss/styles/styles.module' as base;

  .nav-skeleton {
    display: flex;
    flex-direction: column;
    gap: base.$sn-primitive-dimension-8;
    padding: base.$sn-density-spacing-interval-m base.$sn-density-spacing-interval-l;
  }

  .nav-skeleton-row {
    height: base.$sn-primitive-dimension-16;
    border-radius: base.$sn-primitive-dimension-4;
    background: base.$sn-theme-color-neutral-decorTransparent;
    animation: nav-skeleton-pulse 1.2s ease-in-out infinite;

    &[data-kind='group'] {
      width: 55%;
      margin-top: base.$sn-primitive-dimension-8;
    }

    &[data-kind='item'] {
      width: 80%;
      margin-left: base.$sn-primitive-dimension-12;
    }
  }

  @keyframes nav-skeleton-pulse {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.5;
    }
  }
</style>
