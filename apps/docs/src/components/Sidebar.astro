---
import { pathsMatch } from '../lib/base-url'
import { buildNav, domainIdForPath } from '../lib/discovery'
import type { NavItem } from '../lib/discovery'
import { DOMAINS } from '../config/domains'
import { GroupTooltip } from './sidebar/GroupTooltip'
import { Counter } from '@ds/counter'
import '../styles/sidebar.scss'

const PATTERNS_DESCRIPTION = 'Гайды и паттерны проектирования: как собирать сценарии из компонентов, контрибьютить, стандарты и процессы.'

const descByGroupId = new Map<string, string | undefined>(DOMAINS.map((d) => [d.id, d.description]))
descByGroupId.set('patterns', PATTERNS_DESCRIPTION)

const nav = await buildNav()
const base = import.meta.env.BASE_URL
const currentPath = Astro.url.pathname
const currentDomainId = domainIdForPath(currentPath)
const onPatterns = currentPath.includes('/patterns/')
// Group is "in focus" when we're on one of its pages. On the home page nothing
// is focused — all domain groups are collapsed; patterns stays open.
const focusedGroupId = onPatterns ? 'patterns' : currentDomainId

function isActive(href: string) {
  return pathsMatch(currentPath, href)
}

function isGroupActive(item: NavItem) {
  return isActive(item.href) || (item.children?.some((c) => isActive(c.href)) ?? false)
}
---

<nav class="nav" aria-label="Documentation">
{nav.map((group, i) => (
    <details class="group" open={focusedGroupId === group.id} data-group-id={group.id}>
      <summary class="group-summary" style={`--group-index: ${i}`}>
        <h2 class="group-label">{group.label}</h2>
        {descByGroupId.get(group.id) && (
          <span class="group-info" onclick="event.preventDefault(); event.stopPropagation()">
            <GroupTooltip
              client:visible
              tip={descByGroupId.get(group.id)!}
              label={`О группе ${group.label}`}
            />
          </span>
        )}
        <span class="group-count" aria-hidden="true">
          <Counter value={group.items.length} appearance='neutral' size='xs' color='decor' />
        </span>
        <span class="group-toggle" aria-hidden="true">
          <svg viewBox="0 0 12 12" width="12" height="12">
            <path d="M4 2.5 L8 6 L4 9.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </summary>
      <ul class="list" role="list">
        {group.items.map((item) =>
          item.children?.length ? (
            <li class="pkg">
              <details class="pkg-details" open={isGroupActive(item)}>
                <summary class="pkg-summary">
                  <a
                    href={item.href}
                    class={`link pkg-label${isGroupActive(item) ? ' link--active' : ''}`}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    data-pkg-link
                  >
                    {item.title}
                  </a>
                  <span class="pkg-toggle" aria-hidden="true">
                    <svg class="pkg-toggle-icon" viewBox="0 0 12 12" width="12" height="12">
                      <path d="M4 2.5 L8 6 L4 9.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </summary>
                <ul class="sub-list" role="list">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class={`link sub-link${isActive(child.href) ? ' link--active' : ''}`}
                        aria-current={isActive(child.href) ? 'page' : undefined}
                      >
                        {child.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                class={`link${isActive(item.href) ? ' link--active' : ''}`}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.title}
              </a>
            </li>
          )
        )}
      </ul>
    </details>
  ))}
</nav>

<script>
  import { navigate } from 'astro:transitions/client'

  function initSidebar() {
    // Clicking the package-header link inside <summary> would both toggle the
    // <details> and navigate. We want navigation without toggling. preventDefault
    // cancels both the anchor default and the summary-toggle default, so instead
    // we stopPropagation (to skip the toggle) and drive the SPA nav ourselves.
    document.querySelectorAll<HTMLAnchorElement>('[data-pkg-link]').forEach((link) => {
      if ((link as HTMLAnchorElement & { __spaBound?: boolean }).__spaBound) return
      ;(link as HTMLAnchorElement & { __spaBound?: boolean }).__spaBound = true
      link.addEventListener('click', (e) => {
        if (e.defaultPrevented) return
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return
        e.preventDefault()
        e.stopPropagation()
        navigate(link.href)
      })
    })

    // The sidebar is transition:persist, so SSR'd active classes from the first
    // render stay in DOM forever. Recompute active state on every SPA swap.
    const normalize = (p: string) => {
      const t = p.replace(/\/+$/, '')
      return t === '' ? '/' : t
    }
    const current = normalize(location.pathname)
    document.querySelectorAll<HTMLAnchorElement>('.nav a.link').forEach((link) => {
      const href = normalize(new URL(link.href).pathname)
      const isActive = href === current
      link.classList.toggle('link--active', isActive)
      if (isActive) link.setAttribute('aria-current', 'page')
      else link.removeAttribute('aria-current')
    })
    // Propagate to the package <details>: a group is "active" if its own link or
    // any child link matches. Open groups containing the active page.
    document.querySelectorAll<HTMLDetailsElement>('.nav .pkg-details').forEach((d) => {
      const hasActive = !!d.querySelector('a.link--active')
      const pkgLink = d.querySelector<HTMLAnchorElement>('[data-pkg-link]')
      if (pkgLink) pkgLink.classList.toggle('link--active', hasActive)
      if (hasActive) d.open = true
    })

    // Domain-level <details>: open the group containing the active page,
    // collapse the rest. On the home page nothing is active — leave whatever
    // state the user manually set.
    const domainGroups = document.querySelectorAll<HTMLDetailsElement>('.nav .group[data-group-id]')
    const anyActive = !!document.querySelector('.nav a.link--active')
    if (anyActive) {
      domainGroups.forEach((d) => {
        d.open = !!d.querySelector('a.link--active')
      })
    }


    // Scroll the sidebar so the active link sits in the upper part of the viewport.
    const scroller = document.getElementById('sidebar')
    const active = document.querySelector<HTMLElement>('.nav .link--active')
    if (scroller && active) {
      const rect = active.getBoundingClientRect()
      const scrollerRect = scroller.getBoundingClientRect()
      const offsetWithinScroller = rect.top - scrollerRect.top + scroller.scrollTop
      const target = offsetWithinScroller - scroller.clientHeight * 0.25
      const desired = Math.max(0, target)
      // Only scroll when the active item is actually out of the comfortable zone —
      // avoids jumping the sidebar on every SPA navigation.
      const viewportTop = scroller.scrollTop
      const viewportBottom = viewportTop + scroller.clientHeight
      if (offsetWithinScroller < viewportTop + 24 || offsetWithinScroller > viewportBottom - 48) {
        scroller.scrollTop = desired
      }
    }
  }

  initSidebar()
  document.addEventListener('astro:page-load', initSidebar)
</script>
