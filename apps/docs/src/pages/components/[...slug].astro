---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDocsList } from '../../lib/docs';

export function getStaticPaths() {
  const docs = getDocsList();
  return docs.map((doc) => ({
    params: { slug: doc.slugParts.join('/') },
    props: { doc }
  }));
}

const { doc } = Astro.props;
const nav = getDocsList();
const Component = doc.module.default;
const description = doc.description ?? 'Component documentation';
---

<BaseLayout title={doc.title} description={description} nav={nav}>
  <Component />
</BaseLayout>

