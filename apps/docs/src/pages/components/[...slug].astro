---
import { getCollection, render } from 'astro:content'
import DocsLayout from '../../layouts/DocsLayout.astro'
import { withBase } from '../../lib/base-url'
import { flatPages } from '../../lib/discovery'
import { resolveDomain } from '../../config/domains'
import { PageBreadcrumbs } from '../../components/layout/PageBreadcrumbs'
import { TocTree } from '../../components/layout/TocTree'
import { LlmsLink } from '../../components/LlmsLink'
import { Skeleton } from '@ds/skeleton'
import PageNav from '../../components/layout/PageNav.astro'
import '../../styles/doc-page.scss'

export async function getStaticPaths() {
  const entries = await getCollection('components')
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)

// Build breadcrumbs: Docs → Domain → [Package root, if current is a subpage] → Current title.
const allComponents = await getCollection('components')
const pkg = entry.id.split('/')[0]
const domain = resolveDomain(pkg)
const isSubpage = entry.id.includes('/')
const pkgRoot = isSubpage
  ? (allComponents.find((e) => e.id === pkg) ??
      allComponents
        .filter((e) => e.id.startsWith(`${pkg}/`))
        .sort((a, b) => a.data.title.localeCompare(b.data.title, 'ru'))[0])
  : null

type Crumb = { id: string; label: string; href?: string }
const crumbs: Crumb[] = [
  { id: 'docs', label: 'Docs', href: import.meta.env.BASE_URL },
  { id: `domain-${domain.id}`, label: domain.label },
]
if (pkgRoot) {
  crumbs.push({ id: `pkg-${pkg}`, label: pkgRoot.data.title, href: withBase(`/components/${pkgRoot.id}`) })
}
crumbs.push({ id: `current-${entry.id}`, label: entry.data.title })

// Nest H3s under their preceding H2, and H4s under the last H3 of that H2.
// Allows the right-hand TOC to render up to two levels of nesting (e.g. Props
// → Types → ButtonProps).
type TocNode = { slug: string; text: string; children: TocNode[] }
const tocTree: TocNode[] = []
for (const h of headings) {
  if (h.depth === 2) {
    tocTree.push({ slug: h.slug, text: h.text, children: [] })
  } else if (h.depth === 3 && tocTree.length > 0) {
    tocTree[tocTree.length - 1].children.push({
      slug: h.slug,
      text: h.text,
      children: [],
    })
  } else if (h.depth === 4 && tocTree.length > 0) {
    const lastH2 = tocTree[tocTree.length - 1]
    const lastH3 = lastH2.children[lastH2.children.length - 1]
    if (lastH3) {
      lastH3.children.push({ slug: h.slug, text: h.text, children: [] })
    }
  }
}

const pages = await flatPages()
const currentHref = withBase(`/components/${entry.id}`)
const currentIndex = pages.findIndex((p) => p.href === currentHref)
const prev = currentIndex > 0 ? pages[currentIndex - 1] : null
const next = currentIndex < pages.length - 1 ? pages[currentIndex + 1] : null

// На корне пакета (не суб-странице). BASE_URL напрямую: у .txt нет хвостового слеша.
const llmsHref = `${import.meta.env.BASE_URL}components/${pkg}/llms.txt`
---

<DocsLayout title={entry.data.title} description={entry.data.description}>
  <div class="page">
    <!-- Breadcrumb + llms.txt link -->
    <div class="breadcrumb">
      <PageBreadcrumbs client:only="react" items={crumbs}>
        <!-- SSR-fallback крошек до гидрации острова. -->
        <div slot="fallback" class="breadcrumb-skeleton" aria-hidden="true">
          {crumbs.map((_, i) => (
            <Fragment>
              {i > 0 && <span class="breadcrumb-skeleton-sep">›</span>}
              <Skeleton loading height={12} borderRadius={4} width={i === crumbs.length - 1 ? 72 : 44} />
            </Fragment>
          ))}
        </div>
      </PageBreadcrumbs>
      <span class="llms-action">
        <LlmsLink href={llmsHref} />
      </span>
    </div>

    <!-- Two-column: content + TOC -->
    <div class="content-grid">
      <!-- Main content: description comes from MDX, not duplicated here -->
      <article class="doc">
        <Content />
      </article>

      <!-- Right sidebar: TOC -->
      {tocTree.length > 0 && (
        <aside class="toc" aria-label="На странице">
          <p class="toc-label">На странице</p>
          <TocTree client:only="react" nodes={tocTree}>
            <div slot="fallback" class="toc-skeleton" aria-hidden="true">
              {tocTree.map((h) => (
                <Fragment>
                  <span class="toc-skeleton-row" data-kind="top">
                    <Skeleton loading height={12} borderRadius={4} width="85%" />
                  </span>
                  {h.children.map(() => (
                    <span class="toc-skeleton-row" data-kind="sub">
                      <Skeleton loading height={12} borderRadius={4} width="60%" />
                    </span>
                  ))}
                </Fragment>
              ))}
            </div>
          </TocTree>
        </aside>
      )}
    </div>

    <PageNav prev={prev} next={next} />
  </div>
</DocsLayout>

<style>
  /* Кнопка llms.txt — инлайн сразу после крошек (а не отжата к правому краю над TOC). */
  .llms-action {
    flex-shrink: 0;
  }
</style>
