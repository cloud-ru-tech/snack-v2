---
import { getCollection, render } from 'astro:content'
import DocsLayout from '../../layouts/DocsLayout.astro'
import { withBase } from '../../lib/base-url'
import { flatPages } from '../../lib/discovery'
import '../../styles/doc-page.scss'

export async function getStaticPaths() {
  const entries = await getCollection('patterns')
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)

type TocNode = { slug: string; text: string; children: TocNode[] }
const tocTree: TocNode[] = []
for (const h of headings) {
  if (h.depth === 2) {
    tocTree.push({ slug: h.slug, text: h.text, children: [] })
  } else if (h.depth === 3 && tocTree.length > 0) {
    tocTree[tocTree.length - 1].children.push({
      slug: h.slug,
      text: h.text,
      children: [],
    })
  }
}

const pages = await flatPages()
const currentHref = withBase(`/patterns/${entry.id}`)
const currentIndex = pages.findIndex((p) => p.href === currentHref)
const prev = currentIndex > 0 ? pages[currentIndex - 1] : null
const next = currentIndex < pages.length - 1 ? pages[currentIndex + 1] : null
---

<DocsLayout title={entry.data.title} description={entry.data.description}>
  <div class="page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={import.meta.env.BASE_URL}>Docs</a>
      <span aria-hidden>›</span>
      <span>Patterns</span>
      <span aria-hidden>›</span>
      <span aria-current="page">{entry.data.title}</span>
    </nav>

    <div class="content-grid">
      <article class="doc">
        <Content />
      </article>

      {tocTree.length > 0 && (
        <aside class="toc" aria-label="На странице">
          <p class="toc-label">На странице</p>
          <ul class="toc-list">
            {tocTree.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="toc-link">{h.text}</a>
                {h.children.length > 0 && (
                  <ul class="toc-sublist">
                    {h.children.map((c) => (
                      <li>
                        <a href={`#${c.slug}`} class="toc-link toc-link--sub">{c.text}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>

    {(prev || next) && (
      <nav class="page-nav" aria-label="Page navigation">
        {prev ? (
          <a href={prev.href} class="page-nav-link page-nav-prev">
            <span class="page-nav-dir">← Предыдущая</span>
            <span class="page-nav-title">{prev.title}</span>
          </a>
        ) : <span />}
        {next ? (
          <a href={next.href} class="page-nav-link page-nav-next">
            <span class="page-nav-dir">Следующая →</span>
            <span class="page-nav-title">{next.title}</span>
          </a>
        ) : <span />}
      </nav>
    )}
  </div>
</DocsLayout>

<script>
  let currentObserver: IntersectionObserver | null = null

  function initToc() {
    currentObserver?.disconnect()
    currentObserver = null

    const headings = document.querySelectorAll<HTMLElement>('.doc h2[id], .doc h3[id]')
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link')
    if (!headings.length || !tocLinks.length) return

    let activeId = ''
    const setActive = (id: string) => {
      if (id === activeId) return
      activeId = id
      tocLinks.forEach((link) => {
        link.classList.toggle('toc-link--active', link.getAttribute('href') === `#${id}`)
      })
    }

    currentObserver = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
        if (visible.length) setActive((visible[0].target as HTMLElement).id)
      },
      { rootMargin: '-56px 0px -60% 0px', threshold: 0 }
    )
    headings.forEach((h) => currentObserver!.observe(h))
  }

  initToc()
  document.addEventListener('astro:page-load', initToc)
</script>
