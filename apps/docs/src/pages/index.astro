---
import DocsLayout from '../layouts/DocsLayout.astro'
import { getCollection } from 'astro:content'
import { withBase } from '../lib/base-url'
import { buildNav } from '../lib/discovery'
import { Counter } from '@ds/counter'
import { LlmsLink } from '../components/LlmsLink'
import { HomeCard } from '../components/HomeCard'
import '../styles/home.scss'

const nav = await buildNav()

type Card = { title: string; href: string; description?: string }
type Subsection = { id: string; label?: string; cards: Card[] }
type Section = { id: string; label: string; description?: string; subsections: Subsection[] }

// Описания карточек — из контента (frontmatter), не из навигации.
const componentEntries = await getCollection('components')
const descByHref = new Map<string, string | undefined>()
for (const e of componentEntries) {
  descByHref.set(withBase(`/components/${e.id}`), e.data.description)
}

const toCard = (item: { title: string; href: string }): Card => ({
  title: item.title,
  href: item.href,
  description: descByHref.get(item.href),
})

// BASE_URL напрямую, без withBase — у файла не должно быть хвостового слеша.
const llmsIndexHref = `${import.meta.env.BASE_URL}llms.txt`

// Каждый доменный блок — секция; домены с категориями дают под-секции, плоские — одну.
const sections: Section[] = nav
  .map((g) => ({
    id: g.id,
    label: g.label,
    description: g.description,
    subsections: g.categories
      ? g.categories.map((c) => ({ id: c.id, label: c.label, cards: c.items.map(toCard) }))
      : [{ id: g.id, cards: (g.items ?? []).map(toCard) }],
  }))
  .filter((s) => s.subsections.some((ss) => ss.cards.length > 0))
---

<DocsLayout title="Home" description="Design System components and patterns.">
  <div class="home">
    <header class="hero">
      <h1>Design System</h1>
      <p class="lead">
        A collection of React components, design patterns, and guidelines
        for building consistent interfaces.
      </p>
      <div class="hero-llms">
        <LlmsLink href={llmsIndexHref} label="llms.txt — индекс для LLM" />
      </div>
    </header>

    {sections.map((section) => {
      const total = section.subsections.reduce((n, ss) => n + ss.cards.length, 0)
      return (
        <section class="section" data-section-id={section.id}>
          <header class="section-head">
            <div class="section-head-row">
              <h2>{section.label}</h2>
              <Counter value={total} appearance='neutral' size='s' color='decor' />
            </div>
            {section.description && (
              <p class="section-desc">{section.description}</p>
            )}
          </header>

          {section.subsections.map((ss) => (
            <Fragment>
              {ss.label && (
                <div class="subsection-head">
                  <h3>{ss.label}</h3>
                  <Counter value={ss.cards.length} appearance='neutral' size='xs' color='decor' />
                </div>
              )}
              <ul class="card-grid" role="list">
                {ss.cards.map((pkg) => (
                  <li>
                    <HomeCard href={pkg.href} title={pkg.title} description={pkg.description} />
                  </li>
                ))}
              </ul>
            </Fragment>
          ))}
        </section>
      )
    })}
  </div>
</DocsLayout>

<style lang="scss">
  @use '@sbercloud/figma-variables/build/scss/styles/styles.module' as base;

  .subsection-head {
    display: flex;
    align-items: center;
    gap: base.$sn-primitive-dimension-8;
    margin: base.$sn-density-spacing-interval-l 0 base.$sn-density-spacing-interval-s;

    h3 {
      margin: 0;
      font: inherit;
      font-weight: 600;
      color: base.$sn-theme-color-neutral-text;
    }
  }

  .hero-llms {
    margin: base.$sn-density-spacing-interval-m 0 0;
  }
</style>
