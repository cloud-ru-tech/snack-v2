---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDocsList } from '../lib/docs';

const docs = getDocsList();
---

<BaseLayout
  title="Design System"
  description="React components and documentation"
  nav={docs}
  currentRoute="/"
>
  <h1>Design System</h1>
  <p>Reusable React components, tokens, and documentation.</p>

  <h2>Components</h2>
  <ul>
    {docs.map((doc) => (
      <li>
        <a href={doc.route}>{doc.title}</a>
        {doc.description ? <span style="color:#475569; margin-left:8px;">— {doc.description}</span> : null}
      </li>
    ))}
  </ul>
</BaseLayout>

