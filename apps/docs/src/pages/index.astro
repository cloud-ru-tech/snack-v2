---
import DocsLayout from '../layouts/DocsLayout.astro'
import { getCollection } from 'astro:content'
import { withBase } from '../lib/base-url'
import { buildNav } from '../lib/discovery'
import { DOMAINS } from '../config/domains'
import { Counter } from '@ds/counter'
import '../styles/home.scss'

const PATTERNS_DESCRIPTION = 'Гайды и паттерны проектирования: как собирать сценарии из компонентов, контрибьютить, стандарты и процессы.'

const descByDomain = new Map<string, string | undefined>(DOMAINS.map((d) => [d.id, d.description]))
descByDomain.set('patterns', PATTERNS_DESCRIPTION)

const PREVIEW_COUNT = 8

const nav = await buildNav()
const componentGroups = nav.filter((g) => g.id !== 'patterns')
const patterns = await getCollection('patterns')

type Card = { title: string; href: string; description?: string }

const componentEntries = await getCollection('components')
const descByHref = new Map<string, string | undefined>()
for (const e of componentEntries) {
  descByHref.set(withBase(`/components/${e.id}`), e.data.description)
}

const componentSections = componentGroups.map((g) => ({
  id: g.id,
  label: g.label,
  cards: g.items.map<Card>((item) => ({
    title: item.title,
    href: item.href,
    description: descByHref.get(item.href),
  })),
}))

const patternsCards: Card[] = patterns.map((p) => ({
  title: p.data.title,
  href: withBase(`/patterns/${p.id}`),
  description: p.data.description,
}))

const allSections: { id: string; label: string; cards: Card[] }[] = [
  ...componentSections,
  { id: 'patterns', label: 'Patterns', cards: patternsCards },
].filter((s) => s.cards.length > 0)
---

<DocsLayout title="Home" description="Design System components and patterns.">
  <div class="home">
    <header class="hero">
      <h1>Design System</h1>
      <p class="lead">
        A collection of React components, design patterns, and guidelines
        for building consistent interfaces.
      </p>
    </header>

    {allSections.map((section) => {
      const hasMore = section.cards.length > PREVIEW_COUNT
      const previewCards = section.cards.slice(0, PREVIEW_COUNT)
      const restCards = hasMore ? section.cards.slice(PREVIEW_COUNT) : []
      return (
        <section class="section" data-section-id={section.id}>
          <header class="section-head">
            <div class="section-head-row">
              <h2>{section.label}</h2>
              <Counter value={section.cards.length} appearance='neutral' size='s' color='decor' />
            </div>
            {descByDomain.get(section.id) && (
              <p class="section-desc">{descByDomain.get(section.id)}</p>
            )}
          </header>

          <ul class="card-grid" role="list">
            {previewCards.map((pkg) => (
              <li>
                <a href={pkg.href} class="card">
                  <span class="card-title">{pkg.title}</span>
                  {pkg.description && (
                    <span class="card-desc">{pkg.description}</span>
                  )}
                </a>
              </li>
            ))}
          </ul>

          {hasMore && (
            <details class="more">
              <summary class="more-toggle">
                <span class="more-label-show">Показать ещё {restCards.length}</span>
                <span class="more-label-hide">Свернуть</span>
                <svg class="more-icon" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                  <path d="M2.5 4 L6 8 L9.5 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <ul class="card-grid" role="list">
                {restCards.map((pkg) => (
                  <li>
                    <a href={pkg.href} class="card">
                      <span class="card-title">{pkg.title}</span>
                      {pkg.description && (
                        <span class="card-desc">{pkg.description}</span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </section>
      )
    })}
  </div>
</DocsLayout>
