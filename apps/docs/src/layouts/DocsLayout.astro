---
import Sidebar from '../components/Sidebar.astro'
import { SettingsMenu } from '../components/layout/SettingsMenu'
import { MobileNavToggle } from '../components/layout/MobileNavToggle'
import { GitlabLink } from '../components/layout/GitlabLink'
import { SupportLink } from '../components/layout/SupportLink'
import { HeaderNav } from '../components/layout/HeaderNav'
import { HeaderSearch } from '../components/layout/HeaderSearch'
import { ThemeHtmlApplier } from '../components/layout/ThemeHtmlApplier'
import { PortalRootApplier } from '../components/layout/PortalRootApplier'
import { NavProgress } from '../components/layout/NavProgress'
import { TeamSnack } from '../components/layout/logo/TeamSnack'
import { CloudRu } from '../components/layout/logo/CloudRu'
import { ClientRouter } from 'astro:transitions'
import { getThemeClassnames } from '@ds/theme/ssr'
import '../styles/global.css'
import '../styles/docs-layout.scss'

interface Props {
  title: string
  description?: string
}

const { title, description } = Astro.props
const base = import.meta.env.BASE_URL

// Дефолтный набор sn-* для <html> — единый источник из @ds/theme.
// Inline-скрипт ниже корректирует оси по localStorage/системе до первой отрисовки.
const htmlClass = getThemeClassnames({ colorScheme: 'light', brand: 'brandA', brandRole: 'main', density: 'compact' })
---

<!doctype html>
<html lang="ru" class={htmlClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description ?? 'Design System documentation'} />
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <title>{title} — Design System</title>
    <ClientRouter />
  </head>
  <body>
    <ThemeHtmlApplier client:load transition:persist />
    <PortalRootApplier client:load transition:persist />
    <NavProgress client:load transition:persist />
    <!-- Top header -->
    <header class="header" transition:persist>
      <div class="header-inner">
        <!-- Mobile: hamburger toggle -->
        <div class="nav-toggle-slot">
          <MobileNavToggle client:load />
        </div>

        <a href={base} class="header-logo" aria-label="Design System home">
          <TeamSnack />
          <svg class="header-logo-cross" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path d="M4 4 L12 12 M12 4 L4 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <CloudRu />
        </a>

        <HeaderSearch client:load />

        <HeaderNav client:load />

        <div class="header-end">
          <SettingsMenu client:load />
          <span class="header-support"><SupportLink client:load /></span>
          <span class="header-gitlab"><GitlabLink client:load /></span>
        </div>
      </div>
    </header>

    <!-- Mobile overlay -->
    <div class="nav-overlay" id="nav-overlay" aria-hidden="true"></div>

    <!-- Main layout -->
    <div class="layout">
      <aside class="sidebar-wrap" id="sidebar">
        <Sidebar />
      </aside>
      <main class="content" id="main-content" data-pagefind-body>
        <slot />
      </main>
    </div>

    <!-- Корень порталов: все оверлеи DS (Modal/Drawer/Popover/Tooltip) рендерятся сюда поверх
         хрома доков. Внутри стек по DOM-порядку (z-index оверлеев = 0). См. PortalRootApplier. -->
    <div id="ds-portal-root" transition:persist></div>

    <script is:inline>
      // No-FOUC bootstrap: синхронно ставит классы осей из localStorage до первой отрисовки.
      // is:inline сериализуется в строку без импортов, поэтому @ds/theme тут напрямую не доступен;
      // после гидрации <html> ведёт ThemeHtmlApplier.
      (function () {
        function apply() {
          const cls = document.documentElement.classList
          const storedTheme = localStorage.getItem('ds-theme')
          const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
          const theme = storedTheme ?? system
          cls.toggle('sn-dark', theme === 'dark')
          cls.toggle('sn-light', theme === 'light')

          const brand = localStorage.getItem('ds-brand') ?? 'brandA'
          cls.toggle('sn-brandA', brand === 'brandA')
          cls.toggle('sn-brandB', brand === 'brandB')
          cls.toggle('sn-brandC', brand === 'brandC')
          cls.toggle('sn-brandD', brand === 'brandD')

          const brandRole = localStorage.getItem('ds-brandRole') ?? 'main'
          cls.toggle('sn-main', brandRole === 'main')
          cls.toggle('sn-alter', brandRole === 'alter')
          cls.toggle('sn-alter2', brandRole === 'alter2')
          cls.toggle('sn-alter3', brandRole === 'alter3')
          cls.toggle('sn-alter4', brandRole === 'alter4')

          const density = localStorage.getItem('ds-density') ?? 'compact'
          cls.toggle('sn-compact', density === 'compact')
          cls.toggle('sn-comfort', density === 'comfort')
          cls.toggle('sn-spacious', density === 'spacious')
        }
        apply()
        document.addEventListener('astro:after-swap', apply)
      })()
    </script>

  </body>
</html>
