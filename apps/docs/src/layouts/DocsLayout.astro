---
import Sidebar from '../components/Sidebar.astro'
import { ThemeToggle } from '../components/layout/ThemeToggle'
import { MobileNavToggle } from '../components/layout/MobileNavToggle'
import { GithubLink } from '../components/layout/GithubLink'
import { HeaderNav } from '../components/layout/HeaderNav'
import { SpriteHost } from '../components/layout/SpriteHost'
import '../styles/global.css'
import '../styles/docs-layout.scss'

interface Props {
  title: string
  description?: string
}

const { title, description } = Astro.props
const base = import.meta.env.BASE_URL
---

<!doctype html>
<html lang="ru" class="sn-base-styles sn-brandA sn-desktop sn-light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description ?? 'Design System documentation'} />
    <title>{title} — Design System</title>
    <link rel="stylesheet" href={`${base}pagefind/pagefind-ui.css`} />
  </head>
  <body>
    <SpriteHost />
    <!-- Top header -->
    <header class="header">
      <div class="header-inner">
        <!-- Mobile: hamburger toggle -->
        <div class="nav-toggle-slot">
          <MobileNavToggle client:load />
        </div>

        <a href={base} class="header-logo" aria-label="Design System home">
          <span class="header-logo-mark">DS</span>
          <span class="header-logo-name">Design System</span>
        </a>

        <HeaderNav client:load />

        <div class="header-search" id="search">
          <kbd class="header-search-kbd" aria-hidden="true">⌘K</kbd>
        </div>

        <div class="header-end">
          <ThemeToggle client:load />
          <GithubLink client:load />
        </div>
      </div>
    </header>

    <!-- Mobile overlay -->
    <div class="nav-overlay" id="nav-overlay" aria-hidden="true"></div>

    <!-- Main layout -->
    <div class="layout">
      <aside class="sidebar-wrap" id="sidebar">
        <Sidebar />
      </aside>
      <main class="content" id="main-content" data-pagefind-body>
        <slot />
      </main>
    </div>

    <script is:inline>
      // Apply initial theme synchronously to avoid FOUC. React ThemeToggle handles clicks.
      (function () {
        const stored = localStorage.getItem('ds-theme')
        const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        const theme = stored ?? system
        const isDark = theme === 'dark'
        document.documentElement.classList.toggle('sn-dark', isDark)
        document.documentElement.classList.toggle('sn-light', !isDark)
      })()
    </script>

    <script>
      // ⌘K / Ctrl+K focuses the Pagefind search input
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault()
          const input = document.querySelector<HTMLInputElement>(
            '#search .pagefind-ui__search-input'
          )
          input?.focus()
        }
      })
    </script>

    <!--
      Pagefind UI is an IIFE bundle that sets window.PagefindUI. Load it as a
      regular <script> and initialise after DOM is ready. In `astro dev` the
      astro-pagefind middleware serves /pagefind/* from ./dist — so run
      `astro build` at least once before `astro dev` to get search in dev.
    -->
    <script is:inline src={`${base}pagefind/pagefind-ui.js`} defer></script>
    <script is:inline>
      window.addEventListener('DOMContentLoaded', () => {
        if (typeof window.PagefindUI !== 'function') return
        new window.PagefindUI({
          element: '#search',
          showImages: false,
          showSubResults: true,
          resetStyles: false,
          placeholder: 'Поиск по документации…',
        })
      })
    </script>
  </body>
</html>
