---
import Sidebar from '../components/Sidebar.astro'
import { SettingsMenu } from '../components/layout/SettingsMenu'
import { MobileNavToggle } from '../components/layout/MobileNavToggle'
import { GithubLink } from '../components/layout/GithubLink'
import { StorybookLink } from '../components/layout/StorybookLink'
import { HeaderNav } from '../components/layout/HeaderNav'
import { HeaderSearch } from '../components/layout/HeaderSearch'
import { ThemeHtmlApplier } from '../components/layout/ThemeHtmlApplier'
import { PreviewThemeApplier } from '../components/layout/PreviewThemeApplier'
import { PortalRootApplier } from '../components/layout/PortalRootApplier'
import { NavProgress } from '../components/layout/NavProgress'
import { TeamSnack } from '../components/layout/logo/TeamSnack'
import { CloudRu } from '../components/layout/logo/CloudRu'
import { ClientRouter } from 'astro:transitions'
import { BRAND, getThemeClassnames } from '@ds/theme/ssr'
import { CHROME_APPEARANCE, CHROME_PORTAL_ROOT_ID } from '../lib/docsChrome'
import '../styles/global.css'
import '../styles/docs-layout.scss'

interface Props {
  title: string
  description?: string
}

const { title, description } = Astro.props
const base = import.meta.env.BASE_URL

// Дефолтный набор sn-* для <html> — единый источник из @ds/theme.
// Inline-скрипт ниже корректирует оси по localStorage/системе до первой отрисовки.
const htmlClass = getThemeClassnames({ colorScheme: 'light', ...CHROME_APPEARANCE })
// Список брендов передаётся в inline-скрипт: он не может импортировать @ds/theme.
const brands = Object.values(BRAND)
---

<!doctype html>
<html lang="ru" class={htmlClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description ?? 'Design System documentation'} />
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <title>{title} — Design System</title>
    <ClientRouter />
  </head>
  <body>
    <ThemeHtmlApplier client:load transition:persist />
    <PreviewThemeApplier client:load transition:persist />
    <PortalRootApplier client:load transition:persist />
    <NavProgress client:load transition:persist />
    <!-- Top header -->
    <header class="header" transition:persist>
      <div class="header-inner">
        <!-- Mobile: hamburger toggle -->
        <div class="nav-toggle-slot">
          <MobileNavToggle client:load />
        </div>

        <a href={base} class="header-logo" aria-label="Design System home">
          <TeamSnack />
          <svg class="header-logo-cross" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path d="M4 4 L12 12 M12 4 L4 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <CloudRu />
        </a>

        <HeaderSearch client:load />

        <HeaderNav client:load />

        <div class="header-end">
          <SettingsMenu client:load />
          <span class="header-storybook"><StorybookLink client:load /></span>
          <span class="header-github"><GithubLink client:load /></span>
        </div>
      </div>
    </header>

    <!-- Mobile overlay -->
    <div class="nav-overlay" id="nav-overlay" aria-hidden="true"></div>

    <!-- Main layout -->
    <div class="layout">
      <aside class="sidebar-wrap" id="sidebar">
        <Sidebar />
      </aside>
      <main class="content" id="main-content" data-pagefind-body>
        <slot />
      </main>
    </div>

    <!-- Корень порталов: все оверлеи DS (Modal/Drawer/Popover/Tooltip) рендерятся сюда поверх
         хрома доков. Внутри стек по DOM-порядку (z-index оверлеев = 0). См. PortalRootApplier. -->
    <div id="ds-portal-root" data-docs-preview transition:persist></div>
    <!-- Корень порталов обвязки (поиск, меню, навигация): её оформление не зависит от настроек примеров. -->
    <div id={CHROME_PORTAL_ROOT_ID} transition:persist></div>

    <script is:inline define:vars={{ brands }}>
      // No-FOUC bootstrap: синхронно ставит классы из localStorage до первой отрисовки.
      // is:inline сериализуется в строку без импортов, поэтому @ds/theme тут напрямую не доступен;
      // после гидрации <html> ведёт ThemeHtmlApplier, примеры — PreviewThemeApplier.
      (function () {
        function apply() {
          const storedTheme = localStorage.getItem('ds-theme')
          const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
          const theme = storedTheme ?? system

          // Обвязка доки: с настроек берётся только цветовая схема.
          const cls = document.documentElement.classList
          cls.toggle('sn-dark', theme === 'dark')
          cls.toggle('sn-light', theme === 'light')

          // Примеры и их порталы: полный набор sn-* из настроек (тот же, что собирает getThemeClassnameList).
          const storedBrand = localStorage.getItem('ds-brand')
          const brand = brands.includes(storedBrand) ? storedBrand : 'cloudConsole'
          const platform = localStorage.getItem('ds-platform') === 'webMobile' ? 'webMobile' : 'webDesktop'
          const storedDensity = localStorage.getItem('ds-density')
          const density = ['compact', 'comfort', 'spacious'].includes(storedDensity) ? storedDensity : 'compact'
          const previewClasses = ['sn-base-styles', 'sn-figmaStyles', 'sn-components', 'sn-no', 'sn-' + platform, 'sn-' + density, 'sn-' + theme, 'sn-' + brand]
          document.querySelectorAll('[data-docs-preview]').forEach(function (element) {
            element.classList.add.apply(element.classList, previewClasses)
          })
        }
        apply()
        document.addEventListener('astro:after-swap', apply)
      })()
    </script>

  </body>
</html>
