---
const {
  title = 'Design System Docs',
  description = 'Components and guidelines',
  nav = [],
  currentRoute = '/'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="light" style="color-scheme: light;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style>
      :root {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background: #f8fafc;
        color: #0f172a;
      }
      :root[data-theme='dark'] {
        background: #0b1220;
        color: #e2e8f0;
      }
      body {
        margin: 0;
        background: inherit;
        color: inherit;
      }
      header {
        background: #0f172a;
        color: #e2e8f0;
        padding: 14px 24px;
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .shell {
        display: grid;
        grid-template-columns: 240px 1fr 220px;
        gap: 20px;
        max-width: 1280px;
        margin: 0 auto;
        padding: 24px 20px 64px;
      }
      @media (max-width: 1100px) {
        .shell {
          grid-template-columns: 200px 1fr;
        }
        aside.toc {
          display: none;
        }
      }
      @media (max-width: 820px) {
        .shell {
          grid-template-columns: 1fr;
        }
        aside.nav {
          display: none;
        }
      }
      a {
        color: #2563eb;
      }
      pre {
        background: #0f172a;
        color: #e2e8f0;
        padding: 16px;
        border-radius: 12px;
        overflow: auto;
      }
      code {
        font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 700;
        text-decoration: none;
        color: inherit;
      }
      .top-actions {
        margin-left: auto;
        display: flex;
        gap: 10px;
        align-items: center;
      }
      .btn {
        border: 1px solid #334155;
        background: transparent;
        color: inherit;
        padding: 6px 10px;
        border-radius: 8px;
        cursor: pointer;
      }
      .nav-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .nav-list a {
        color: inherit;
        text-decoration: none;
        font-weight: 600;
      }
      .nav-list a.active {
        color: #2563eb;
      }
      .toc-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 14px;
      }
      .toc-list a {
        color: inherit;
        text-decoration: none;
      }
      .toc-list .level-3 {
        padding-left: 12px;
        font-size: 13px;
        opacity: 0.85;
      }
      main {
        min-width: 0;
      }
    </style>
  </head>
  <body>
    <header>
      <div style="display:flex; align-items:center; gap:16px;">
        <a class="brand" href="/">Design System</a>
        <div class="top-actions">
          <button class="btn" id="theme-toggle" type="button">Theme: light</button>
          <select class="btn" id="lang-select">
            <option value="en">EN</option>
            <option value="ru">RU</option>
          </select>
        </div>
      </div>
    </header>
    <div class="shell">
      <aside class="nav">
        <h3>Components</h3>
        <ul class="nav-list">
          {nav.map((item) => (
            <li>
              <a href={item.route} class={item.route === currentRoute ? 'active' : ''}>
                {item.title}
              </a>
              {item.description ? (
                <div style="font-size:12px; color:#64748b;">{item.description}</div>
              ) : null}
            </li>
          ))}
        </ul>
      </aside>
      <main>
        <slot />
      </main>
      <aside class="toc">
        <h3>On this page</h3>
        <ul class="toc-list" id="toc"></ul>
      </aside>
    </div>
    <script>
      if (typeof window !== 'undefined') {
        const root = document.documentElement;
        const themeToggle = document.getElementById('theme-toggle');
        const langSelect = document.getElementById('lang-select');

        const savedTheme = localStorage.getItem('theme') || 'light';
        const savedLang = localStorage.getItem('lang') || 'en';

        const applyTheme = (theme) => {
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
          themeToggle.textContent = `Theme: ${theme}`;
          localStorage.setItem('theme', theme);
        };

        const applyLang = (lang) => {
          langSelect.value = lang;
          localStorage.setItem('lang', lang);
        };

        applyTheme(savedTheme);
        applyLang(savedLang);

        themeToggle?.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          applyTheme(next);
        });

        langSelect?.addEventListener('change', (e) => {
          applyLang(e.target.value);
        });

        // Build TOC from content headings
        const tocRoot = document.getElementById('toc');
        const content = document.querySelector('main');
        if (tocRoot && content) {
          const headings = Array.from(content.querySelectorAll('h2, h3')).filter(
            (h) => h.id || h.textContent
          );
          tocRoot.innerHTML = '';
          headings.forEach((h) => {
            if (!h.id) {
              h.id = h.textContent.toLowerCase().replace(/\s+/g, '-');
            }
            const li = document.createElement('li');
            li.className = h.tagName === 'H3' ? 'level-3' : '';
            const a = document.createElement('a');
            a.href = `#${h.id}`;
            a.textContent = h.textContent;
            li.appendChild(a);
            tocRoot.appendChild(li);
          });
        }
      }
    </script>
  </body>
</html>

