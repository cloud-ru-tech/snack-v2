{
  "name": "@ds/docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "BASE_PATH=${BASE_PATH:-/snack-v2/} astro build && UV_THREADPOOL_SIZE=16 node ./scripts/precompress.mjs",
    "build:root": "BASE_PATH=/ astro build && UV_THREADPOOL_SIZE=16 node ./scripts/precompress.mjs",
    "build:fast": "SKIP_PAGEFIND=1 BASE_PATH=/ astro build",
    "preview": "astro preview",
    "clean": "rm -rf dist .astro"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.5",
    "remark-gfm": "catalog:",
    "@astrojs/react": "6.0.2",
    "@ds/portal-context": "workspace:*",
    "@ds/theme": "workspace:*",
    "@ds/utils": "workspace:*",
    "astro": "7.1.5",
    "mermaid": "11.16.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sass": "catalog:",
    "sass-embedded": "catalog:",
    "shiki": "catalog:"
  },
  "devDependencies": {
    "@ds/fonts": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "astro-pagefind": "2.0.1",
    "typescript": "catalog:",
    "unist-util-visit": "5.1.0"
  }
}
