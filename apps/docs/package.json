{
  "name": "@ds/docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "BASE_PATH=${BASE_PATH:-/snack-v2/} astro build && UV_THREADPOOL_SIZE=16 node ./scripts/precompress.mjs",
    "build:root": "BASE_PATH=/ astro build && UV_THREADPOOL_SIZE=16 node ./scripts/precompress.mjs",
    "build:fast": "SKIP_PAGEFIND=1 BASE_PATH=/ astro build",
    "preview": "astro preview",
    "clean": "rm -rf dist .astro"
  },
  "dependencies": {
    "@astrojs/mdx": "5.0.6",
    "@astrojs/react": "5.0.7",
    "@ds/portal-context": "workspace:*",
    "@ds/theme": "workspace:*",
    "@ds/utils": "workspace:*",
    "astro": "6.4.8",
    "mermaid": "11.15.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sass": "catalog:",
    "shiki": "3.23.0"
  },
  "devDependencies": {
    "@ds/fonts": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "astro-pagefind": "2.0.0",
    "pagefind": "1.5.2",
    "typescript": "catalog:",
    "unist-util-visit": "5.1.0"
  }
}
