---
import { getCollection } from 'astro:content';

// Helper to generate paths with base URL
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => {
  // Remove leading slash from path if base already has trailing slash
  const normalizedBase = base.endsWith('/') ? base : `${base}/`;
  const normalizedPath = path.startsWith('/') ? path.slice(1) : path;
  return `${normalizedBase}${normalizedPath}`;
};

// Get current language from URL or default to 'en'
const currentLang = Astro.currentLocale || 'en';

// Get all docs from components directory (without locale prefix since they're in components/)
const componentsDocs = await getCollection('docs', ({ id }) => {
  // Check both patterns: "components/" (new) and "${currentLang}/components/" (old)
  return id.startsWith('components/') || id.startsWith(`${currentLang}/components/`);
});

// Get all docs from guides directory for current locale
const guidesDocs = await getCollection('docs', ({ id }) => {
  return id.startsWith(`${currentLang}/guides/`);
});

// Process components - исключаем только CHANGELOG и MIGRATION
// Группируем по package, приоритет отдаем index файлам
const componentsByPackage = new Map();

// Сначала собираем все файлы по пакетам
componentsDocs.forEach((doc) => {
  const parts = doc.id.split('/');
  
  // Определяем, есть ли языковой префикс
  const hasLocalePrefix = parts[0] === currentLang;
  
  // parts[0] может быть locale или 'components'
  // parts[1] может быть 'components' или packageName
  // parts[2] может быть packageName или fileName
  let packageName: string;
  let startIndex: number;
  
  if (hasLocalePrefix) {
    // Old structure: en/components/avatar/index.mdx
    packageName = parts[2];
    startIndex = 2;
  } else {
    // New structure: components/avatar/index.mdx
    packageName = parts[1];
    startIndex = 1;
  }
  
  const fileName = parts[parts.length - 1].toLowerCase();
  const title = doc.data.title?.toLowerCase() || '';
  const description = doc.data.description?.toLowerCase() || '';
  
  // Исключаем CHANGELOG и MIGRATION файлы
  // Проверяем по fileName, title и description
  const isChangelog = fileName === 'changelog' || 
                      title === 'changelog' ||
                      description.includes('version history');
  const isMigration = fileName === 'migration' || 
                      title === 'migration guide' ||
                      description.includes('migration instructions');
  
  if (isChangelog || isMigration) {
    return;
  }
  
  if (!packageName) {
    return;
  }
  
  if (!componentsByPackage.has(packageName)) {
    componentsByPackage.set(packageName, []);
  }
  
  // Build relative path based on structure
  let relativePath: string;
  if (fileName === 'index') {
    relativePath = `${currentLang}/components/${packageName}/`;
  } else {
    const pathParts = hasLocalePrefix ? parts.slice(2) : parts.slice(1);
    relativePath = `${currentLang}/components/${pathParts.join('/')}/`;
  }
  
  const slug = withBase(relativePath);
  
  componentsByPackage.get(packageName)!.push({
    title: doc.data.title,
    description: doc.data.description,
    slug,
    order: doc.data.order ?? 999,
    packageName,
    fileName: parts[parts.length - 1], // Сохраняем оригинальное имя для сортировки
  });
});

// Для каждого пакета берем index файл, если есть, иначе первую найденную страницу
const components = Array.from(componentsByPackage.entries())
  .map(([packageName, docs]) => {
    // Сортируем: сначала index, потом остальные
    docs.sort((a, b) => {
      const aIsIndex = a.fileName.toLowerCase() === 'index';
      const bIsIndex = b.fileName.toLowerCase() === 'index';
      if (aIsIndex && !bIsIndex) return -1;
      if (!aIsIndex && bIsIndex) return 1;
      return a.order - b.order || a.title.localeCompare(b.title);
    });
    
    return docs[0]; // Берем первый (index, если есть)
  })
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));

// Process guides
const guides = guidesDocs
  .map((doc) => {
    const parts = doc.id.split('/');
    // parts[0] is locale, parts[1] is 'guides'
    const relativePath = `${currentLang}/guides/${parts.slice(2).join('/')}/`;
    const slug = withBase(relativePath);
    
    return {
      title: doc.data.title,
      description: doc.data.description,
      slug,
      order: doc.data.order ?? 999,
    };
  })
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));
---

{guides.length > 0 && (
  <>
    <h2>Паттерны и гайдлайны</h2>
    <p>Рекомендации по использованию компонентов и общие принципы:</p>
    <ul>
      {guides.map((guide) => (
        <li>
          <a href={guide.slug}>{guide.title}</a>
          {guide.description && <span> — {guide.description}</span>}
        </li>
      ))}
    </ul>
  </>
)}

{components.length > 0 && (
  <>
    <h2>Компоненты</h2>
    <p>Готовые UI-элементы с примерами и API:</p>
    <ul>
      {components.map((component) => (
        <li>
          <a href={component.slug}>{component.title}</a>
          {component.description && <span> — {component.description}</span>}
        </li>
      ))}
    </ul>
  </>
)}
