---
import styles from '../../styles/components/_storybook-iframe.module.scss';

interface Props {
  storyId: string;
  height?: string;
  width?: string;
  /**
   * Показывать ли панель с контроллами и кодом
   * @default false - только компонент
   * true - полный Storybook UI с контроллами
   */
  showControls?: boolean;
  /**
   * Режим отображения
   * @default 'story' - только компонент
   * 'docs' - документация с контроллами и кодом
   */
  viewMode?: 'story' | 'docs';
}

const { 
  storyId, 
  height = '420px', 
  width = '100%',
  showControls = false,
  viewMode = 'story'
} = Astro.props;

// Determine Storybook base URL based on environment
const getStorybookBaseUrl = () => {
  // In production/GitLab Pages, use relative path with base URL
  // Astro sets import.meta.env.PROD in production builds
  if (import.meta.env.PROD) {
    const base = import.meta.env.BASE_URL;
    const storybookPath = 'storybook';
    // Normalize base path and combine with storybook path
    return base.endsWith('/') ? `${base}${storybookPath}` : `${base}/${storybookPath}`;
  }
  // In dev, use localhost
  return 'http://localhost:6006';
};

const baseUrl = getStorybookBaseUrl();

// Если showControls=true, используем полную страницу story с панелями
// Иначе используем iframe.html для компактного отображения
let iframeUrl: string;
if (showControls) {
  // Story с контроллами справа, но без sidebar слева
  // nav=0 - скрыть sidebar
  // panel=right - показать панель контроллов справа
  // shortcuts=0 - скрыть shortcuts toolbar
  iframeUrl = `${baseUrl}/?path=/story/${storyId}&nav=0&panel=right&shortcuts=0`;
} else {
  // Только компонент без панелей
  iframeUrl = `${baseUrl}/iframe.html?id=${storyId}&viewMode=${viewMode}`;
}
---

<iframe
  src={iframeUrl}
  style={{
    width,
    height,
  }}
  loading="lazy"
  allow="clipboard-write"
  class={styles['storybook-iframe']}
  data-story-id={storyId}
/>

<script>
  import '../../scripts/storybook-iframe-sync';
</script>
