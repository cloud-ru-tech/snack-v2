---
/**
 * LlmLink component - displays a link to component-specific LLM.txt file
 * 
 * Usage in MDX:
 * <LlmLink component="avatar" />
 */
import styles from '../../styles/components/_llm-link.module.scss';

interface Props {
  component: string;
}

const { component } = Astro.props;

// Get base URL - use relative path for production flexibility
const base = import.meta.env.BASE_URL;
const llmPath = `_llms-txt/components/llm-${component}.txt`;
const llmUrl = base.endsWith('/') ? `${base}${llmPath}` : `${base}/${llmPath}`;
const fullUrl = import.meta.env.SITE ? 
  `${import.meta.env.SITE.replace(/\/+$/, '')}${llmUrl}` : 
  `http://localhost:4321${llmUrl}`;
---

<div class={styles['llm-link-container']}>
  <div class={styles['llm-link-header']}>
    <svg
      class={styles['llm-icon-large']}
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
      <polyline points="14 2 14 8 20 8"></polyline>
      <line x1="16" y1="13" x2="8" y2="13"></line>
      <line x1="16" y1="17" x2="8" y2="17"></line>
      <polyline points="10 9 9 9 8 9"></polyline>
    </svg>
    <strong>LLM-оптимизированная документация</strong>
  </div>
  
  <p class={styles['llm-description']}>
    Документация этого компонента доступна в текстовом формате для AI-ассистентов и языковых моделей:
  </p>
  
  <div class={styles['llm-link-row']}>
    <a href={llmUrl} class={styles['llm-link']} target="_blank" rel="noopener noreferrer">
      <svg
        class={styles['llm-icon']}
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
      <span>Открыть llm-{component}.txt</span>
    </a>
    
    <button class={styles['copy-button']} data-url={fullUrl} title="Скопировать ссылку">
      <svg
        class={styles['copy-icon']}
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
    </button>
  </div>
  
  <div class={styles['llm-url']}>
    <code>{llmUrl}</code>
  </div>
</div>

<script>
  import '../../scripts/llm-link-copy';
</script>
