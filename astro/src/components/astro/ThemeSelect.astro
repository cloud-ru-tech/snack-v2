---
/**
 * Кастомный ThemeSelect для Starlight
 * Заменяет стандартный переключатель темы на расширенную версию
 * с поддержкой бренда и платформы
 */
import styles from '../../styles/components/_theme-select.module.scss';
---

<div class={styles['design-system-theme-controls']}>
  <!-- Тема (Light/Dark) -->
  <label class={styles['theme-control']}>
    <select id="theme-select-toolbar" class={styles['theme-select']} title="Выберите тему">
      <option value="light">☀️ Светлая</option>
      <option value="dark">🌙 Темная</option>
    </select>
  </label>

  <!-- Бренд -->
  <label class={styles['theme-control']}>
    <select id="brand-select-toolbar" class={styles['theme-select']} title="Выберите бренд">
      <option value="brandA">Brand A</option>
      <option value="brandB">Brand B</option>
    </select>
  </label>

  <!-- Платформа -->
  <label class={styles['theme-control']}>
    <select id="platform-select-toolbar" class={styles['theme-select']} title="Выберите платформу">
      <option value="desktop">🖥️ Desktop</option>
      <option value="mobile">📱 Mobile</option>
    </select>
  </label>
</div>

<script>
  import '../../scripts/theme-select-toolbar';
</script>
