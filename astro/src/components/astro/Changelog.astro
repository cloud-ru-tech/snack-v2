---
/**
 * Changelog component for displaying package changelog link in documentation
 * 
 * The changelog is automatically synced from packages/<package-name>/CHANGELOG.md
 * to components/<package-name>/CHANGELOG.md and available as a separate page.
 * 
 * Usage in MDX:
 * ```mdx
 * import Changelog from '../../components/Changelog.astro';
 * 
 * <Changelog packageName="button" />
 * ```
 */
import styles from '../../styles/components/_changelog.module.scss';

interface Props {
  /** Package name (e.g., "button") */
  packageName: string;
  /** Show inline link or full changelog section */
  inline?: boolean;
}

const { packageName, inline = false } = Astro.props;

// Generate changelog URL with base path support
const base = import.meta.env.BASE_URL;
const relativePath = `components/${packageName}/changelog/`;
const changelogUrl = base.endsWith('/') ? `${base}${relativePath}` : `${base}/${relativePath}`;
---

{inline ? (
  <div class={styles['changelog-inline']}>
    <a href={changelogUrl} class={styles['changelog-link']}>
      View Changelog →
    </a>
  </div>
) : (
  <div class={styles['changelog-container']}>
    <div class={styles['changelog-header']}>
      <h2>Changelog</h2>
    </div>
    <div class={styles['changelog-content']}>
      <p>
        See the complete version history and migration guides in the{' '}
        <a href={changelogUrl}>Changelog</a>.
      </p>
      <a href={changelogUrl} class={styles['changelog-button']}>
        View Changelog →
      </a>
    </div>
  </div>
)}






















