---
import styles from '../../styles/components/_llms-links.module.scss';

// Helper to generate paths with base URL
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => {
  const normalizedBase = base.endsWith('/') ? base.slice(0, -1) : base;
  const normalizedPath = path.startsWith('/') ? path : `/${path}`;
  return `${normalizedBase}${normalizedPath}`;
};

const llmsFiles = [
  {
    title: 'llms.txt',
    description: 'Полный индекс документации',
    url: withBase('/llms.txt'),
  },
  {
    title: 'llms-full.txt',
    description: 'Полная версия документации',
    url: withBase('/llms-full.txt'),
  },
  {
    title: 'llms-small.txt',
    description: 'Сокращенная версия',
    url: withBase('/llms-small.txt'),
  },
  {
    title: 'llms-components.txt',
    description: 'Документация по компонентам',
    url: withBase('/llms-components.txt'),
  },
  {
    title: 'llms-guides.txt',
    description: 'Руководства и гайды',
    url: withBase('/llms-guides.txt'),
  },
  {
    title: '_llms-txt/components/',
    description: 'Отдельные файлы для каждого компонента',
    url: withBase('/_llms-txt/components/index.txt'),
  },
];
---

<div class={styles['llms-links']}>
  <h2>🤖 LLM-оптимизированная документация</h2>
  <p>Для AI-ассистентов и LLM-агентов доступны специальные версии документации в текстовом формате:</p>
  <ul>
    {llmsFiles.map((file) => (
      <li>
        <a href={file.url} target="_blank" rel="noopener noreferrer">
          <code>{file.title}</code>
        </a>
        {file.description && <span> — {file.description}</span>}
      </li>
    ))}
  </ul>
  <p class={styles['note']}>
    Эти файлы оптимизированы для чтения AI-моделями и содержат всю документацию в структурированном текстовом формате.
  </p>
</div>
