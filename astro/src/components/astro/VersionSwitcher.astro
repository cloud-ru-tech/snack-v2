---
/**
 * VersionSwitcher component for Starlight
 * 
 * Displays available versions and allows switching between them.
 * Versions are extracted from frontmatter of documentation pages.
 * 
 * Usage in MDX:
 * ```mdx
 * import VersionSwitcher from '../../components/VersionSwitcher.astro';
 * 
 * <VersionSwitcher />
 * ```
 */
import styles from '../../styles/components/_version-switcher.module.scss';

interface Props {
  /** Package name to show versions for (optional, defaults to detecting from URL) */
  packageName?: string;
  /** Available versions (optional, will be auto-detected if not provided) */
  versions?: string[];
}

const { packageName, versions } = Astro.props;

// In a real implementation, you might want to:
// 1. Read available versions from Git tags
// 2. Read from a versions.json file generated during build
// 3. Extract from all documentation pages

// For now, this is a template that can be extended
const availableVersions = versions || ['latest', '0.2.0', '0.1.0'];
const currentPath = Astro.url.pathname;
const currentVersion = currentPath.match(/\/v(\d+\.\d+\.\d+)\//)?.[1] || 'latest';

// Detect package name from URL if not provided
const detectedPackageName = packageName || currentPath.split('/components/')[1]?.split('/')[0] || '';
---

<div class={styles['version-switcher']}>
  <label for="version-select" class={styles['version-label']}>
    Version:
  </label>
  <select
    id="version-select"
    class={styles['version-select']}
    value={currentVersion}
  >
    {availableVersions.map((version) => (
      <option value={version} selected={version === currentVersion}>
        {version === 'latest' ? 'Latest' : `v${version}`}
      </option>
    ))}
  </select>
  {detectedPackageName && (
    <span class={styles['package-name']}>({detectedPackageName})</span>
  )}
</div>

<script>
  import '../../scripts/version-switcher';
</script>






















