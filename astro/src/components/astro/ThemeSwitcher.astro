---
/**
 * Компонент для переключения темы, бренда и платформы
 * Работает с глобальным theme-manager
 */
import styles from '../../styles/components/_theme-switcher.module.scss';
---

<div class={styles['theme-switcher']}>
  <div class={styles['theme-controls']}>
    <label class={styles['theme-control']}>
      <span class={styles['theme-label']}>Тема:</span>
      <select id="theme-select" class={styles['theme-select']}>
        <option value="light">Светлая</option>
        <option value="dark">Темная</option>
      </select>
    </label>

    <label class={styles['theme-control']}>
      <span class={styles['theme-label']}>Бренд:</span>
      <select id="brand-select" class={styles['theme-select']}>
        <option value="brandA">Brand A</option>
        <option value="brandB">Brand B</option>
      </select>
    </label>

    <label class={styles['theme-control']}>
      <span class={styles['theme-label']}>Платформа:</span>
      <select id="platform-select" class={styles['theme-select']}>
        <option value="desktop">Desktop</option>
        <option value="mobile">Mobile</option>
      </select>
    </label>
  </div>
</div>

<script>
  import '../../scripts/theme-switcher';
</script>
